{# renders a presented curiosity's table(s); expects variable `c` #}
{% if c.rows and c.rows.length %}
<div class="table-wrap">
  <table>
    <thead><tr>{% for col in c.columns %}<th>{{ col }}</th>{% endfor %}</tr></thead>
    <tbody>
      {% for row in c.rows %}
      <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% elif c.derbies %}
  {% for d in c.derbies %}
  <h3>{{ d.name }}</h3>
  <div class="table-wrap">
    <table>
      <thead><tr>{% for col in d.columns %}<th>{{ col }}</th>{% endfor %}</tr></thead>
      <tbody>
        {% for row in d.rows %}
        <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endfor %}
{% else %}
<p class="muted">Inga träffar i det täckta datat just nu.</p>
{% endif %}
<p class="coverage">Beräkningsunderlag: {{ c.coverage }}.</p>
