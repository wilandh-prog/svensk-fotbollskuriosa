Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"9\" height=\"9\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span> <span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/AIK_Fotboll_Damer\" title=\"AIK Fotboll Damer\">AIK</a>&#160;</span><br /><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"9\" height=\"9\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span> <span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/IF_Brommapojkarna_(damer)\" title=\"IF Brommapojkarna (damer)\">Brommapojkarna</a>&#160;</span><br /><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"9\" height=\"9\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span> <span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/Djurg%C3%A5rdens_IF_Dam\" title=\"Djurgårdens IF Dam\">Djurgården</a>&#160;</span><br /><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"9\" height=\"9\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span> <span style=\"background-color:#FFFFFF; color:#0000FF