/tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><a href=\"/wiki/Europeiska_cupvinnarcupen_i_fotboll_1996/1997\" title=\"Europeiska cupvinnarcupen i fotboll 1996/1997\">Cupvinnarcupen</a></th><td class=\"\" style=\"\"><a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><a href=\"/wiki/Intertotocupen_1996\" title=\"Intertotocupen 1996\">Intertotocupen</a></th><td class=\"\" style=\"\"><a href=\"/wiki/%C3%96rebro_SK_Fotboll\" title=\"Örebro SK Fotboll\">Örebro SK</a><br /><a href=\"/wiki/Djurg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgårdens IF</a><br /><a href=\"/wiki/%C3%96rgryte_IS\" title=\"Örgryte IS\">Örgryte IS</a></td></tr><tr><th colspan=\"2\" style=\"text-align:center;background-color:#f0f1f2;\">Statistik</th></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Bästa målgörare</th><td class=\"\" style=\"\"><a href=\"/wiki/Niklas_Skoog\" title=\"Niklas Skoog\">Niklas Skoog</a>, <a href=\"/wiki/V%C3%A4stra_Fr%C3%B6lunda_IF_Fotboll\" title=\"Västra Frölunda IF Fotboll\">Västra Frölunda IF</a> (17)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;hemmavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/%C3%96rebro_SK_Fotboll\" title=\"Örebro SK Fotboll\">Örebro</a> 5–0 <a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö</a><br /><span style=\"font-size:smaller; line-height:130%\">(13 augusti 1995)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;bortavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/IFK_Norrk%C3%B6ping\" title=\"IFK Norrköping\">Norrköping</a> 0–5 <a href=\"/wiki/IFK_G%C3%B6teborg\" title=\"IFK Göteborg\">Göteborg</a><br /><span style=\"font-size:smaller; line-height:130%\">(13 augusti 1995)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Målrikaste match</th><td class=\"\" style=\"\"><a href=\"/wiki/%C3%96rebro_SK_Fotboll\" title=\"Örebro SK Fotboll\">Örebro</a> 4–4 <a href=\"/wiki/V%C3%A4stra_Fr%C3%B6lunda_IF_Fotboll\" title=\"Västra Frölunda IF Fotboll\">Frölunda</a><br /><span style=\"font-size:smaller; line-height:130%\">(1 maj 1995)</span><br /><a href=\"/wiki/V%C3%A4stra_Fr%C3%B6lunda_IF_Fotboll\" title=\"Västra Frölunda IF Fotboll\">Frölunda</a> 2–6 <a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby</a><br /><span style=\"font-size:smaller; line-height:130%\">(15 oktober 1995)</span><br /><a href=\"/wiki/Helsingborgs_IF\" title=\"Helsingborgs IF\">Helsingborg</a> 3–5 <a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby</a><br /><span style=\"font-size:smaller; line-height:130%\">(28 oktober 1995)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Åskådarantal i snitt</th><td class=\"\" style=\"\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;05653.&amp;&amp;&amp;&amp;&amp;0</span>5&#160;653<sup id=\"cite&#95;ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup></td></tr><tr><td colspan=\"2\" style=\"text-align:center;\" class=\"\"><div style=\"float: left;\">&#8592; <a href=\"/wiki/Fotbollsallsvenskan_1994\" title=\"Fotbollsallsvenskan 1994\">1994</a> </div><div style=\"float: right;\"><a href=\"/wiki/Fotbollsallsvenskan_1996\" title=\"Fotbollsallsvenskan 1996\">1996</a> &#8594;</div></td></tr>\n</tbody></table>\n<div style=\"float:right;clear:right;width:374px;padding:4px;border:1px solid silver;margin:4px;background-color:white\">\n<div style=\"position:relative;border:1px solid silver;padding:0px;width:370px\"><span typeof=\"mw:File\"><a href=\"/wiki/Fil:Sweden_location_map,_40south.svg\" class=\"mw-file-des