FFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/IF_Elfsborg\" title=\"IF Elfsborg\">Elfsborg</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:71.945688094993%; left:47.457880306021%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:5px;left:-2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/IFK_Norrk%C3%B6ping\" title=\"IFK Norrköping\">Norrköping</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:77.817958391557%; left:11.01603563534%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-0.5em; left:-2.5em; width:6em;text-align:center;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:2px;left:-13px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/IFK_G%C3%B6teborg\" title=\"IFK Göteborg\">Göteborg</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:84.815521278187%; left:18.415114984999%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:5px;left:2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstad</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:63.184981680132%; left:58.884230582908%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:4px;left:-2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/IK_Sirius_FK\" title=\"IK Sirius FK\">Sirius</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:84.703681255554%; left:49.725956492124%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:5px;left:-2px\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/Kalmar_FF\" title=\"Kalmar FF\">Kalmar</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:92.253468464796%; left:19.130160300885%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:5px;left:2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:89.153814442425%; left:34.983468678506%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:4px;left:-2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/Mj%C3%A4llby_AIF\" title=\"Mjällby AIF\">Mjällby</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:81.965824126938%; left:13.172599791084%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:4px;left:2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/Varbergs_BoIS_FC\" title=\"Varbergs BoIS FC\">Varberg</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:67.422629104525%; left:39.149569060051%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:4px;left:2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/%C3%96rebro_SK_Fotboll\" title=\"Örebro SK Fotboll\">Örebro</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:40.924540127242%; left:33.993480462926%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:4px;left:-2px;\"><span style=\"background-color:#FFFFFF; color:; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/%C3%96stersunds_FK\" title=\"Östersunds FK\">Östersund</a>&#160;</span></span></div>\n</div>\n</div>\n</div>\n<div style=\"font-size:90%\">Geografisk placering av de deltagande lagen i Allsvenskan 2021.</div>\n</div>\n<p><b>Fotbollsallsvenskan 2021</b> var den 97:e säsongen av <a href=\"/wiki/Allsvenskan_(fotboll)\" title=\"Allsvenskan (fotboll)\">Allsvenskan</a> sedan starten 1924 och är Sveriges högsta division i <a href=\"/wiki/Fotboll\" title=\"Fotboll\">fotboll</a> 2021. <a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö FF</a> blev svenska mästare i den sista omgången, vilket var klubbens 22:a SM-titel.<sup id=\"cite&#95;ref-2\" class=\"reference\"><a href=\"#cite_note-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Förlopp\"><span id=\"F.C3.B6rlopp\"></span>Förlopp</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2021&amp;veaction=edit&amp;section=1\" title=\"Redigera avsnitt: Förlopp\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2021&amp;action=edit&amp;section=1\" title=\"Redigera avsnitts källkod: Förlopp\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>Den 22 december 2020 meddelade <a href=\"/wiki/Svenska_Fotbollf%C3%B6rbundet\" title=\"Svenska Fotbollförbundet\">Svenska Fotbollförbundet</a> att de första matcherna spelas helgen den 10–11 april 2021, och serien avslutas söndagen den 5 december samma år.<sup id=\"cite&#95;ref-3\" class=\"reference\"><a href=\"#cite_note-3\"><span class=\"cite-bracket\">&#91;</span>3<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-4\" class=\"reference\"><a href=\"#cite_note-4\"><span class=\"cite-bracket\">&#91;</span>4<span class=\"cite-bracket\">&#93;</span></a></sup> <a href=\"/wiki/Mats_Enquist\" title=\"Mats Enquist\">Mats Enquist</a>, Generalsekreterare hos <a href=\"/wiki/Svensk_Elitfotboll\" title=\"Svensk Elitfotboll\">Svensk Elitfotboll</a>, meddelade samma dag i en kommentar till <a href=\"/wiki/Fotbollskanalen.se\" title=\"Fotbollskanalen.se\">Fotbollskanalen</a> att man planerat spela åtta av omgångar före <a href=\"/wiki/Europam%C3%A4sterskapet_i_fotboll_2020\" title=\"Europamästerskapet i fotboll 2020\">EM 2020</a> och 22 efter.<sup id=\"cite&#95;ref-5\" class=\"reference\"><a href=\"#cite_note-5\"><span class=\"cite-bracket\">&#91;</span>5<span class=\"cite-bracket\">&#93;</span></a></sup> \n</p><p>Den 14 januari 2021 stod spelordningen och spelschemat klart.<sup id=\"cite&#95;ref-6\" class=\"reference\"><a href=\"#cite_note-6\"><span class=\"cite-bracket\">&#91;</span>6<span class=\"cite-bracket\">&#93;</span></a></sup> Anledningen till att det inte är ett <i>normalt</i> schema är på grund av <a href=\"/wiki/Coronavirusutbrottet_2020%E2%80%932021_i_Sverige\" class=\"mw-redirect\" title=\"Coronavirusutbrottet 2020–2021 i Sverige\">pandemin</a> som gjort att det under 2020 endast var 300 supportrar på läktaren under hela säsongen.<sup id=\"cite&#95;ref-7\" class=\"reference\"><a href=\"#cite_note-7\"><span class=\"cite-bracket\">&#91;</span>7<span class=\"cite-bracket\">&#93;</span></a></sup> När man nu planerar säsongsinledning är det i förhoppning att återigen kunna släppa in publik till matcherna.\n</p><p>Publikrestriktionerna lättades upp per den 1 juni, och återigen den 1 juli, vilket kunde tillämpas efter sommaruppehållet.<sup id=\"cite&#95;ref-8\" class=\"reference\"><a href=\"#cite_note-8\"><span class=\"cite-bracket\">&#91;</span>8<span class=\"cite-bracket\">&#93;</span></a></sup> Lättnaderna innebar att en publik på <span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;03000.&amp;&amp;&amp;&amp;&amp;0</span>3&#160;000 sittande åskådare \"per sektion\" tilläts.<sup id=\"cite&#95;ref-9\" class=\"reference\"><a href=\"#cite_note-9\"><span class=\"cite-bracket\">&#91;</span>9<span class=\"cite-bracket\">&#93;</span></a></sup> Hur detta tillämpades berodde på arenornas storlek och utformning.<sup id=\"cite&#95;ref-10\" class=\"reference\"><a href=\"#cite_note-10\"><span class=\"cite-bracket\">&#91;</span>10<span class=\"cite-bracket\">&#93;</span></a></sup> Restriktionerna lättades ytterligare, och deltagartaken togs bort, per den 29 september.<sup id=\"cite&#95;ref-11\" class=\"reference\"><a href=\"#cite_note-11\"><span class=\"cite-bracket\">&#91;</span>11<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Uppmärksammade_spelarförändringar\"><span id=\"Uppm.C3.A4rksammade_spelarf.C3.B6r.C3.A4ndringar\"></span>Uppmärksammade spelarförändringar</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2021&amp;veaction=edit&amp;section=2\" title=\"Redigera avsnitt: Uppmärksammade spelarförändringar\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2021&amp;action=edit&amp;section=2\" title=\"Redigera avsnitts källkod: Uppmärksammade spelarförändringar\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<dl><dd><i>Detta är inte en komplett lista över spelarförändringar. Endast ett urval uppmärksammade fall har tagits med.</i></dd></dl>\n<ul><li>I mars meddelade <a href=\"/wiki/IFK_G%C3%B6teborg\" title=\"IFK Göteborg\">IFK Göteborg</a> att <a href=\"/wiki/Marek_Hamsik\" class=\"mw-redirect\" title=\"Marek Hamsik\">Marek Hamsik</a> har skrivit på ett korttidsavtal fram till sommaren, för att hålla sig i form inför <a href=\"/wiki/Europam%C3%A4sterskapet_i_fotboll_2020\" title=\"Europamästerskapet i fotboll 2020\">EM</a>.<sup id=\"cite&#95;ref-12\" class=\"reference\"><a href=\"#cite_note-12\"><span class=\"cite-bracket\">&#91;</span>12<span class=\"cite-bracket\">&#93;</span></a></sup> Hamsik tillhörde IFK fram till sommaruppehållet, och gick den 1 juli till <a href=\"/wiki/Trabzonspor\" title=\"Trabzonspor\">Trabzonspor</a>.<sup id=\"cite&#95;ref-13\" class=\"reference\"><a href=\"#cite_note-13\"><span class=\"cite-bracket\">&#91;</span>13<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><a href=\"/wiki/Marcus_Berg\" title=\"Marcus Berg\">Marcus Berg</a> återvände till <a href=\"/wiki/IFK_G%C3%B6teborg\" title=\"IFK Göteborg\">IFK Göteborg</a> under sommaren, efter 14 år i utländska klubbar.<sup id=\"cite&#95;ref-14\" class=\"reference\"><a href=\"#cite_note-14\"><span class=\"cite-bracket\">&#91;</span>14<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK:s</a> lagkapten <a href=\"/wiki/Henok_Goitom\" title=\"Henok Goitom\">Henok Goitom</a> avslutade sin karriär efter säsongen. I sin avslutningsmatch gjorde han sitt 100:e mål för klubben på övertid.<sup id=\"cite&#95;ref-15\" class=\"reference\"><a href=\"#cite_note-15\"><span class=\"cite-bracket\">&#91;</span>15<span class=\"cite-bracket\">&#93;</span></a></sup></li></ul>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Lag\">Lag</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2021&amp;veaction=edit&amp;section=3\" title=\"Redigera avsnitt: Lag\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2021&amp;action=edit&amp;section=3\" title=\"Redigera avsnitts källkod: Lag\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>15 lag hade per den 9 december 2020 kvalificerat sig för spel i Allsvenskan 2021 efter resultat från <a href=\"/wiki/Fotbollsallsvenskan_2020\" title=\"Fotbollsallsvenskan 2020\">Allsvenskan 2020</a><sup id=\"cite&#95;ref-16\" class=\"reference\"><a href=\"#cite_note-16\"><span class=\"cite-bracket\">&#91;</span>16<span class=\"cite-bracket\">&#93;</span></a></sup> och <a href=\"/wiki/Superettan_2020\" title=\"Superettan 2020\">Superettan 2020</a>.<sup id=\"cite&#95;ref-17\" class=\"reference\"><a href=\"#cite_note-17\"><span class=\"cite-bracket\">&#91;</span>17<span class=\"cite-bracket\">&#93;</span></a></sup> Den 13 december 2020 säkrade Kalmar FF för andra året i rad sitt allsvenska kontrakt via kvalspel, den här gången mot <a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköpings Södra</a> efter 3–1 borta och 1–0 hemma, totalt 4–1 och blev därmed klara för sin 18 raka säsong i Allsvenskan sedan återkomsten 2004.<sup id=\"cite&#95;ref-18\" class=\"reference\"><a href=\"#cite_note-18\"><span class=\"cite-bracket\">&#91;</span>18<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Städer_och_arenor\"><span id=\"St.C3.A4der_och_arenor\"></span>Städer och arenor</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2021&amp;veaction=edit&amp;section=4\" title=\"Redigera avsnitt: Städer och arenor\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2021&amp;action=edit&amp;section=4\" title=\"Redigera avsnitts källkod: Städer och arenor\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable sortable\" style=\"text-align: left;\">\n<tbody><tr>\n<th width=\"130\">Lag\n</th>\n<th width=\"140\"><a href=\"/wiki/Sveriges_l%C3%A4n\" title=\"Sveriges län\">Län</a>\n</th>\n<th width=\"100\">Ort\n</th>\n<th width=\"130\">Arena\n</th>\n<th>Underlag\n</th>\n<th colspan=\"2\">Kapacitet\n</th>\n<th>Placering<br />2020\n</th></tr>\n<tr>\n<td><a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\"><img alt=\"Stockholms län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/20px-Stockholm_l%C3%A4n_vapen.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/40px-Stockholm_l%C3%A4n_vapen.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Stockholm\" title=\"Stockholm\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Friends_Arena\" class=\"mw-redirect\" title=\"Friends Arena\">Friends Arena</a>\n</td>\n<td>Gräs\n</td>\n<td align=\"center\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;050000.&amp;&amp;&amp;&amp;&amp;0</span>50&#160;000\n</td>\n<td align=\"center\"><sup id=\"cite&#95;ref-19\" class=\"reference\"><a href=\"#cite_note-19\"><span class=\"cite-bracket\">&#91;</span>19<span class=\"cite-bra