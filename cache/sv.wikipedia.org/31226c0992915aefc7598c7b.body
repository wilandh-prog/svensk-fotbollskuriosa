n.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/40px-Stockholm_l%C3%A4n_vapen.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Stockholm\" title=\"Stockholm\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Tele2_Arena\" class=\"mw-redirect\" title=\"Tele2 Arena\">Tele2 Arena</a>\n</td>\n<td>Konstgräs\n</td>\n<td align=\"center\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;030000.&amp;&amp;&amp;&amp;&amp;0</span>30&#160;000\n</td>\n<td align=\"center\"><sup id=\"cite&#95;ref-t2&#95;22-0\" class=\"reference\"><a href=\"#cite_note-t2-22\"><span class=\"cite-bracket\">&#91;</span>22<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td align=\"center\"><span style=\"display:none\" class=\"sortkey\">D &#xfeff;</span><span class=\"sorttext\">4</span>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstads BK</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/Hallands_l%C3%A4n\" title=\"Hallands län\"><img alt=\"Hallands län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0f/Halland_vapen.svg/20px-Halland_vapen.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0f/Halland_vapen.svg/40px-Halland_vapen.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/Hallands_l%C3%A4n\" title=\"Hallands län\">Halland</a>\n</td>\n<td><a href=\"/wiki/Halmstad\" title=\"Halmstad\">Halmstad</a>\n</td>\n<td><a href=\"/wiki/%C3%96rjans_vall\" title=\"Örjans vall\">Örjans vall</a>\n</td>\n<td>Gräs\n</td>\n<td align=\"center\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;011100.&amp;&amp;&amp;&amp;&amp;0</span>11&#160;100\n</td>\n<td align=\"center\"><sup id=\"cite&#95;ref-23\" class=\"reference\"><a href=\"#cite_note-23\"><span class=\"cite-bracket\">&#91;</span>23<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td align=\"center\"><span style=\"display:none\" class=\"sortkey\">O &#xfeff;</span><span class=\"sorttext\">1 <small>(<a href=\"/wiki/Superettan_2020\" title=\"Superettan 2020\">S1</a>)</small></span>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby IF</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\"><img alt=\"Stockholms län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/20px-Stockholm_l%C3%A4n_vapen.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/40px-Stockholm_l%C3%A4n_vapen.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Stockholm\" title=\"Stockholm\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Tele2_Arena\" class=\"mw-redirect\" title=\"Tele2 Arena\">Tele2 Arena</a>\n</td>\n<td>Konstgräs\n</td>\n<td align=\"center\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;030000.&amp;&amp;&amp;&amp;&amp;0</span>30&#160;000\n</td>\n<td align=\"center\"><sup id=\"cite&#95;ref-t2&#95;22-1\" class=\"reference\"><a href=\"#cite_note-t2-22\"><span class=\"cite-bracket\">&#91;</span>22<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td align=\"center\"><span style=\"display:none\" class=\"sortkey\">H &#xfeff;</span><span class=\"sorttext\">8</span>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/IF_Elfsborg\" title=\"IF Elfsborg\">IF Elfsborg</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/V%C3%A4stra_G%C3%B6talands_l%C3%A4n\" title=\"Västra Götalands län\"><img alt=\"Västra Götalands län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/d/da/V%C3%A4stra_G%C3%B6taland_vapen.svg/20px-V%C3%A4stra_G%C3%B6taland_vapen.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/d/da/V%C3%A4stra_G%C3%B6taland_vapen.svg/40px-V%C3%A4stra_G%C3%B6taland_vapen.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/V%C3%A4stra_G%C3%B6talands_l%C3%A4n\" title=\"Västra Götalands län\">Västra Götaland</a>\n</td>\n<td><a href=\"/wiki/Bor%C3%A5s\" title=\"Borås\">Borås</a>\n</td>\n<td><a href=\"/wiki/Bor%C3%A5s_Arena\" title=\"Borås Arena\">Borås Arena</a>\n</td>\n<td>Konstgräs\n</td>\n<td align=\"center\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;016200.&amp;&amp;&amp;&amp;&amp;0</span>16&#160;200\n</td>\n<td align=\"center\"><sup id=\"cite&#95;ref-24\" class=\"reference\"><a href=\"#cite_note-24\"><span class=\"cite-bracket\">&#91;</spa