ss=\"\" style=\"\"><a href=\"/wiki/Marcus_Ekenberg\" title=\"Marcus Ekenberg\">Marcus Ekenberg</a>, <a href=\"/wiki/Mj%C3%A4llby_AIF\" title=\"Mjällby AIF\">Mjällby</a> (19 mål)<br /><span style=\"white-space:nowrap\"><a href=\"/wiki/Mattias_Adelstam\" title=\"Mattias Adelstam\">Mattias Adelstam</a>, <a href=\"/wiki/%C3%84ngelholms_FF\" title=\"Ängelholms FF\">Ängelholm</a> (19 mål)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;hemmavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/Falkenbergs_FF\" title=\"Falkenbergs FF\">Falkenberg</a> 7–0 <a href=\"/wiki/FC_Trollh%C3%A4ttan\" title=\"FC Trollhättan\">Trollhättan</a><br /><span style=\"font-size:smaller; line-height:130%\">(6 september 2009)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;bortavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköpings Södra</a> 1–5 <a href=\"/wiki/IK_Sirius_FK\" title=\"IK Sirius FK\">Sirius</a><br /><span style=\"font-size:smaller; line-height:130%\">(15 augusti 2009)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest mål i en match</th><td class=\"\" style=\"\"><a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköpings Södra</a> 4–6 <a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">Sundsvall</a><br /><span style=\"font-size:smaller; line-height:130%\">(20 juli 2009)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Högsta&#160;åskådarantal</th><td class=\"\" style=\"\"><a rel=\"nofollow\" class=\"external text\" href=\"http://svenskfotboll.se/superettan/match/?scr=result&amp;fmid=1174681\">9 385</a>. <a href=\"/wiki/IFK_Norrk%C3%B6ping\" title=\"IFK Norrköping\">Norrköping</a> 2–2 <a href=\"/wiki/%C3%85tvidabergs_FF\" title=\"Åtvidabergs FF\">Åtvidaberg</a><br /><span style=\"font-size:smaller; line-height:130%\">(7 september 2009)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Lägsta&#160;åskådarantal</th><td class=\"\" style=\"\"><a rel=\"nofollow\" class=\"external text\" href=\"http://svenskfotboll.se/superettan/match/?scr=result&amp;fmid=1174555\">225</a>.  <a href=\"/wiki/Qviding_FIF\" title=\"Qviding FIF\">Qviding</a> 3–1 <a href=\"/wiki/%C3%84ngelholms_FF\" title=\"Ängelholms FF\">Ängelholm</a><br /><span style=\"font-size:smaller; line-height:130%\">(17 maj 2009)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Åskådarantal i snitt</th><td class=\"\" style=\"\">1&#160;880</td></tr><tr><td colspan=\"2\" style=\"text-align:center;\" class=\"\"><div style=\"float: left;\">&#8592; <a href=\"/wiki/Superettan_2008\" title=\"Superettan 2008\">2008</a> </div><div style=\"float: right;\"><a href=\"/wiki/Superettan_2010\" title=\"Superettan 2010\">2010</a> &#8594;</div></td></tr>\n</tbody></table>\n<div style=\"float:right;clear:right;width:374px;padding:4px;border:1px solid silver;margin:4px;background-color:white\">\n<div style=\"position:relative;border:1px solid silver;padding:0px;width:370px\"><span typeof=\"mw:File\"><a href=\"/wiki/Fil:Sweden_South_adm_location_map.svg\" class=\"mw-file-description\"><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/b/be/Sweden_South_adm_location_map.svg/500px-Sweden_South_adm_location_map.svg.png\" decoding=\"async\" width=\"370\" height=\"571\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/b/be/Sweden_South_adm_location_map.svg/960px-Sweden_South_adm_location_map.svg.png 2x\" data-file-width=\"611\" data-file-height=\"943\" /></a></span><br />\n<div style=\"position:absolute;z-index:200;top:64.8%; left:17.4%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-al