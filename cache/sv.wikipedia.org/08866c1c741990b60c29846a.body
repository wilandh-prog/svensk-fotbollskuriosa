0.6em}.mw-parser-output .infobox.geography .maptable td,.mw-parser-output .infobox.geography .maptable th{border:0;padding:0}</style><table class=\"infobox\" style=\"border-spacing:3px; width:30em;\"><caption class=\"\" style=\"font-size: 125%; font-weight: bold;\"><a href=\"/wiki/Superettan\" title=\"Superettan\">Superettan</a></caption><tbody><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Datum</th><td class=\"\" style=\"\">30 mars–9 november 2024</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><span style=\"white-space:nowrap\">Nya lag för säsongen</span></th><td class=\"\" style=\"\"><div class=\"mw-collapsible mw-collapsed\" style=\"border:none;text-align:center;\"><div style=\"font-weight:bold;background-color:transparent;color:inherit;text-align:center;\">4 lag</div>\n<div class=\"mw-collapsible-content\" style=\"font-weight:normal;background-color:transparent;color:inherit;text-align:left;\"><a href=\"/wiki/Degerfors_IF\" title=\"Degerfors IF\">Degerfors IF</a><br /><a href=\"/wiki/IK_Oddevold\" title=\"IK Oddevold\">IK Oddevold</a><br /><a href=\"/wiki/Sandvikens_IF_Fotboll\" title=\"Sandvikens IF Fotboll\">Sandvikens IF</a><br /><a href=\"/wiki/Varbergs_BoIS_FC\" title=\"Varbergs BoIS FC\">Varbergs BoIS</a></div></div></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Vinnare</th><td class=\"\" style=\"\"><a href=\"/wiki/Degerfors_IF\" title=\"Degerfors IF\">Degerfors IF</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Uppflyttade</th><td class=\"\" style=\"\"><a href=\"/wiki/Degerfors_IF\" title=\"Degerfors IF\">Degerfors IF</a><br /><a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Östers IF</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Nedflyttade</th><td class=\"\" style=\"\"><a href=\"/wiki/Gefle_IF_Fotboll\" title=\"Gefle IF Fotboll\">Gefle IF</a><br /><a href=\"/wiki/Sk%C3%B6vde_AIK\" title=\"Skövde AIK\">Skövde AIK</a></td></tr><tr><th colspan=\"2\" style=\"text-align:center;background-color:#f0f1f2;\">Statistik</th></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Spelade&#160;matcher</th><td class=\"\" style=\"\">240</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Totalt&#160;antal&#160;mål</th><td class=\"\" style=\"\">633 (2,6 per match)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Bästa målgörare</th><td class=\"\" style=\"\"><a href=\"/wiki/Assad_Al_Hamlawi\" title=\"Assad Al Hamlawi\">Assad Al Hamlawi</a><br /><a href=\"/wiki/Dijan_Vukojevic\" title=\"Dijan Vukojevic\">Dijan Vukojevic</a><br /><a href=\"/wiki/Karl_Holmberg_(fotbollsspelare)\" title=\"Karl Holmberg (fotbollsspelare)\">Karl Holmberg</a><br />(14 mål vardera)<sup id=\"cite&#95;ref-statistik&#95;1-0\" class=\"reference\"><a href=\"#cite_note-statistik-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;hemmavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/IK_Brage\" title=\"IK Brage\">Brage</a> 5–0 <a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">Sundsvall</a><br /><span style=\"font-size:smaller; line-height:130%\">(23 juni 2024)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;bortavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/Gefle_IF_Fotboll\" title=\"Gefle IF Fotboll\">Gefle</a> 0–4 <a href=\"/wiki/Varbergs_BoIS_FC\" title=\"Varbergs BoIS FC\">Varberg</a><br /><span style=\"font-size:smaller; line-height:130%\">(10 augusti 2024)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Målrikaste match</th><td class=\"\" style=\"\"><div class=\"mw-collapsible mw-collapsed\" style=\"border:none;text-align:center;\"><div style=\"font-weight:bold;background-color:transparent;color:inherit;text-align:center;\">6 matcher</div>\n<div class=\"mw-collapsible-content\" style=\"font-weight:normal;background-color:transparent;color:inherit;text-align:left;\"><a href=\"/wiki/%C3%96stersunds_FK\" title=\"Östersunds FK\">Östersund</a> 4–3 <a href=\"/wiki/Gefle_IF_Fotboll\" title=\"Gefle IF Fotboll\">Gefle</a><br /><span style=\"font-size:smaller; line-height:130%\">(22 maj 2024)</span><br /><a href=\"/wiki/Varbergs_BoIS_FC\" title=\"Varbergs BoIS FC\">Varberg</a> 4–3 <a href=\"/wiki/Gefle_IF_Fotboll\" title=\"Gefle IF Fotboll\">Gefle</a><br /><span style=\"font-size:smaller; line-height:130%\">(23 juni 2024)</span><br /><a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona</a> 4–3 <a href=\"/wiki/%C3%96rgryte_IS\" title=\"Örgryte IS\">Örgryte</a><br /><span style=\"font-size:smaller; line-height:130%\">(24 juni 2024)</span><br /><a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona</a> 4–3 <a href=\"/wiki/%C3%96stersunds_FK\" title=\"Östersunds FK\">Östersund</a><br /><span style=\"font-size:smaller; line-height:130%\">(30 juni 2024)</span><br /><a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Öster</a> 5–2 <a href=\"/wiki/Utsiktens_BK\" title=\"Utsiktens BK\">Utsikten</a><br /><span style=\"font-size:smaller; line-height:130%\">(30 september 2024)</span><br /><a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Öster</a> 5–2 <a href=\"/wiki/Sk%C3%B6vde_AIK\" title=\"Skövde AIK\">Skövde</a><br /><span style=\"font-size:smaller; line-height:130%\">(3 november 2024)</span></div></div></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Högsta&#160;åskådarantal</th><td class=\"\" style=\"\">12&#160;768. <a href=\"/wiki/Helsingborgs_IF\" title=\"Helsingborgs IF\">Helsingborg</a> 0–1 <a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona</a><br /><span style=\"font-size:smaller; line-height:130%\">(26 maj 2024)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Lägsta&#160;åskådarantal</th><td class=\"\" style=\"\">156. <a href=\"/wiki/Utsiktens_BK\" title=\"Utsiktens BK\">Utsikten</a> 0–2 <a href=\"/wiki/Trelleborgs_FF\" title=\"Trelleborgs FF\">Trelleborg</a><br /><span style=\"font-size:smaller; line-height:130%\">(10 augusti 2024)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Totalt åskådarantal</th><td class=\"\" style=\"\">603&#160;811</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Åskådarantal i snitt</th><td class=\"\" style=\"\">2&#160;516</td></tr><tr><td colspan=\"2\" style=\"text-align:center;\" class=\"\"><div style=\"float: left;\">&#8592; <a href=\"/wiki/Superettan_2023\" title=\"Superettan 2023\">2023</a> </div><div style=\"float: right;\"><a href=\"/wiki/Superettan_2025\" title=\"Superettan 2025\">2025</a> &#8594;</div></td></tr>\n</tbody></table>\n<div style=\"float:right;clear:right;width:354px;padding:4px;border:1px solid silver;margin:4px;background-color:white\">\n<div style=\"position:relative;border:1px solid silver;padding:0px;width:350px\"><span typeof=\"mw:File\"><a href=\"/wiki/Fil:Map_of_Sweden_(polar_stereographic).svg\" class=\"mw-file-description\"><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/56/Map_of_Sweden_%28polar_stereographic%29.svg/500px-Map_of_Sweden_%28polar_stereographic%29.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"350\" height=\"846\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/56/Map_of_Sweden_%28polar_stereographic%29.svg/960px-Map_of_Sweden_%28polar_stereographic%29.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" dat