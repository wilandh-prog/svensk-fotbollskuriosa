ng:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:5px;left:-2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/IFK_Norrk%C3%B6ping\" title=\"IFK Norrköping\">Norrköping</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:64.8%; left:17.4%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-0.5em; left:-2.5em; width:6em;text-align:center;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:2px;left:-13px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/IFK_G%C3%B6teborg\" title=\"IFK Göteborg\">Göteborg</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:71.7%; left:40%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:80%;position:relative;top: 3px;left:-2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/IFK_V%C3%A4rnamo\" title=\"IFK Värnamo\">Värnamo</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:35.8%; left:79.6%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:4px;left:-2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/IK_Sirius_FK\" title=\"IK Sirius FK\">Sirius</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:78.5%; left:65%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:5px;left:-2px\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/Kalmar_FF\" title=\"Kalmar FF\">Kalmar</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:93.5%; left:28.4%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:5px;left:2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:87.2%; left:47.1%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:4px;left:-2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/Mj%C3%A4llby_AIF\" title=\"Mjällby AIF\">Mjällby</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:73%; left:20.5%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:85%;position:relative;top:4px;left:2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/Varbergs_BoIS_FC\" title=\"Varbergs BoIS FC\">Varberg</a>&#160;</span></span></div>\n</div>\n</div>\n</div>\n<div style=\"font-size:90%\">Geografisk placering av de deltagande lagen i allsvenskan 2022.</div>\n</div>\n<p><b>Fotbollsallsvenskan 2022</b> var den 98:e säsongen av <a href=\"/wiki/Allsvenskan_(fotboll)\" title=\"Allsvenskan (fotboll)\">Allsvenskan</a> sedan starten 1924 och var Sveriges högsta division i <a href=\"/wiki/Fotboll\" title=\"Fotboll\">fotboll</a> 2022.\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Förlopp\"><span id=\"F.C3.B6rlopp\"></span>Förlopp</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2022&amp;veaction=edit&amp;section=1\" title=\"Redigera avsnitt: Förlopp\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2022&amp;action=edit&amp;section=1\" title=\"Redigera avsnitts källkod: Förlopp\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>Seriespelet startade den 2 april 2022 och avslutades den 6 november samma år.<sup id=\"cite&#95;ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Konflikten_Ryssland/Ukraina\"><span id=\"Konflikten_Ryssland.2FUkraina\"></span>Konflikten Ryssland/Ukraina</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2022&amp;veaction=edit&amp;section=2\" title=\"Redigera avsnitt: Konflikten Ryssland/Ukraina\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2022&amp;action=edit&amp;section=2\" title=\"Redigera avsnitts källkod: Konflikten Ryssland/Ukraina\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>Den 7 mars beslutade <a href=\"/wiki/Fifa\" title=\"Fifa\">Fifa</a> att utländska spelare i <a href=\"/wiki/Ryssland\" title=\"Ryssland\">Ryssland</a> ensidigt kan bryta sina anställningsavtal mellan den 10 mars och den 30 juni, på grund av <a href=\"/wiki/Rysslands_invasion_av_Ukraina_2022\" class=\"mw-redirect\" title=\"Rysslands invasion av Ukraina 2022\">Rysslands invasion av Ukraina</a>.<sup id=\"cite&#95;ref-2\" class=\"reference\"><a href=\"#cite_note-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup> Detta gällde även utländska spelare i <a href=\"/wiki/Ukraina\" title=\"Ukraina\">Ukraina</a>.<sup id=\"cite&#95;ref-3\" class=\"reference\"><a href=\"#cite_note-3\"><span class=\"cite-bracket\">&#91;</span>3<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Följande spelare anslöt därför till klubbar i Allsvenskan (korttidskontrakt till och med den 30 juni, om annat ej framgår):\n</p>\n<ul><li><a href=\"/wiki/Armin_Gigovic\" title=\"Armin Gigovic\">Armin Gigović</a> från <a href=\"/wiki/FC_Rostov\" class=\"mw-redirect\" title=\"FC Rostov\">FC Rostov</a> till <a href=\"/wiki/Helsingborgs_IF\" title=\"Helsingborgs IF\">Helsingborgs IF</a>.<sup id=\"cite&#95;ref-4\" class=\"reference\"><a href=\"#cite_note-4\"><span class=\"cite-bracket\">&#91;</span>4<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><a href=\"/wiki/Axel_Bj%C3%B6rnstr%C3%B6m\" title=\"Axel Björnström\">Axel Björnström</a> från <a href=\"/wiki/FK_Arsenal_Tula\" title=\"FK Arsenal Tula\">FK Arsenal Tula</a> till <a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a>. Kontraktet löper till den 31 december 2024.<sup id=\"cite&#95;ref-5\" class=\"reference\"><a href=\"#cite_note-5\"><span class=\"cite-bracket\">&#91;</span>5<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><a href=\"/wiki/Dennis_Hadzikadunic\" class=\"mw-redirect\" title=\"Dennis Hadzikadunic\">Dennis Hadzikadunic</a> från <a href=\"/wiki/FK_Rostov\" title=\"FK Rostov\">FK Rostov</a> till <a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö FF</a> (lån).<sup id=\"cite&#95;ref-6\" class=\"reference\"><a href=\"#cite_note-6\"><span class=\"cite-bracket\">&#91;</span>6<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><a href=\"/wiki/Filip_Dagerst%C3%A5l\" title=\"Filip Dagerstål\">Filip Dagerstål</a> från <a href=\"/wiki/FK_Chimki\" title=\"FK Chimki\">FK Chimki</a> till <a href=\"/wiki/IFK_Norrk%C3%B6ping\" title=\"IFK Norrköping\">IFK Norrköping</a>.<sup id=\"cite&#95;ref-7\" class=\"reference\"><a href=\"#cite_note-7\"><span class=\"cite-bracket\">&#91;</span>7<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><a href=\"/wiki/Jordan_Larsson\" title=\"Jordan Larsson\">Jordan Larsson</a> från <a href=\"/wiki/FK_Spartak_Moskva\" title=\"FK Spartak Moskva\">FK Spartak Moskva</a> till <a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a>.<sup id=\"cite&#95;ref-8\" class=\"reference\"><a href=\"#cite_note-8\"><span class=\"cite-bracket\">&#91;</span>8<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><a href=\"/wiki/Sead_Hak%C5%A1abanovi%C4%87\" title=\"Sead Hakšabanović\">Sead Hakšabanović</a> från <a href=\"/wiki/FC_Rubin_Kazan\" class=\"mw-redirect\" title=\"FC Rubin Kazan\">FC Rubin Kazan</a> till <a href=\"/wiki/Djurg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgården</a>.<sup id=\"cite&#95;ref-9\" class=\"reference\"><a href=\"#cite_note-9\"><span class=\"cite-bracket\">&#91;</span>9<span class=\"cite-bracket\">&#93;</span></a></sup></li></ul>\n<p>Vissa svenska spelare valde andra lösningar än Allsvenskan, till exempel <a href=\"/wiki/Viktor_Claesson\" title=\"Viktor Claesson\">Viktor Claesson</a> som gick till <a href=\"/wiki/FC_K%C3%B6penhamn\" title=\"FC Köpenhamn\">FC Köpenhamn</a>.<sup id=\"cite&#95;ref-10\" class=\"reference\"><a href=\"#cite_note-10\"><span class=\"cite-bracket\">&#91;</span>10<span class=\"cite-bracket\">&#93;</span></a></sup> <a href=\"/wiki/Besard_Sabovic\" title=\"Besard Sabovic\">Besard Sabovic</a> stannade som ende svensk kvar i ryska <a href=\"/wiki/Premjer-Liga\" title=\"Premjer-Liga\">Premjer-Liga</a><sup id=\"cite&#95;ref-11\" class=\"reference\"><a href=\"#cite_note-11\"><span class=\"cite-bracket\">&#91;</span>11<span class=\"cite-bracket\">&#93;</span></a></sup> men bytte senare under året till svenska Djurgården.<sup id=\"cite&#95;ref-12\" class=\"reference\"><a href=\"#cite_note-12\"><span class=\"cite-bracket\">&#91;</span>12<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Händelser_under_seriespelet\"><span id=\"H.C3.A4ndelser_under_seriespelet\"></span>Händelser under seriespelet</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2022&amp;veaction=edit&amp;section=3\" title=\"Redigera avsnitt: Händelser under seriespelet\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2022&amp;action=edit&amp;section=3\" title=\"Redigera avsnitts källkod: Händelser under seriespelet\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<ul><li><a href=\"/wiki/Degerfors_IF\" title=\"Degerfors IF\">Degerfors IF</a> meddelade den 1 april att hemmapremiären mot <a href=\"/wiki/BK_H%C3%A4cken\" title=\"BK Häcken\">BK Häcken</a> den 9 april inte kunde spelas på deras normala hemmaplan, <a href=\"/wiki/Stora_Valla\" title=\"Stora Valla\">Stora Valla</a>, på grund av arbeten med att lägga en ny <a href=\"/wiki/Gr%C3%A4s\" title=\"Gräs\">gräsmatta</a>. Matchen flyttades till <a href=\"/wiki/Behrn_Arena_(fotbollsanl%C3%A4ggning)\" title=\"Behrn Arena (fotbollsanläggning)\">Behrn Arena</a> istället.<sup id=\"cite&#95;ref-13\" class=\"reference\"><a href=\"#cite_note-13\"><span class=\"cite-bracket\">&#91;</span>13<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li>Den 30 oktober säkrade BK Häcken seriesegern och därmed också svenska mästerskapet, då man besegrade <a href=\"/wiki/IFK_G%C3%B6teborg\" title=\"IFK Göteborg\">IFK Göteborg</a> med 4–0 på <a href=\"/wiki/Gamla_Ullevi\" title=\"Gamla Ullevi\">Gamla Ullevi</a>.<sup id=\"cite&#95;ref-14\" class=\"reference\"><a href=\"#cite_note-14\"><span class=\"cite-bracket\">&#91;</span>14<span class=\"cite-bracket\">&#93;</span></a></sup></li></ul>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Uppmärksammade_spelarövergångar\"><span id=\"Uppm.C3.A4rksammade_spelar.C3.B6verg.C3.A5ngar\"></span>Uppmärksammade spelarövergångar</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2022&amp;veaction=edit&amp;section=4\" title=\"Redigera avsnitt: Uppmärksammade spelarövergångar\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2022&amp;action=edit&amp;section=4\" title=\"Redigera avsnitts källkod: Uppmärksammade spelarövergångar\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<ul><li>Den 5 maj meddelade <a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a> att <a href=\"/wiki/John_Guidetti\" title=\"John Guidetti\">John Guidetti</a> var klar för kontrakt gällande från och med den 15 juli 2022, till och med den 31 december 2025.<sup id=\"cite&#95;ref-15\" class=\"reference\"><a href=\"#cite_note-15\"><span class=\"cite-bracket\">&#91;</span>15<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li>Den 17 juni meddelade <a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby IF</a> att <a href=\"/wiki/Williot_Swedberg\" title=\"Williot Swedberg\">Williot Swedberg</a> är såld till <a href=\"/wiki/RC_Celta_de_Vigo\" title=\"RC Celta de Vigo\">Celta Vigo</a>.<sup id=\"cite&#95;ref-16\" class=\"reference\"><a href=\"#cite_note-16\"><span class=\"cite-bracket\">&#91;</span>16<span class=\"cite-bracket\">&#93;</span></a></sup> Uppgifter i media angav en försäljningssumma omkring <span style=\"white-space:nowrap\">56 000 000 kr</span>.<sup id=\"cite&#95;ref-17\" class=\"reference\"><a href=\"#cite_note-17\"><span class=\"cite-bracket\">&#91;</span>17<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li>Samma dag meddelade Hammarby IF även att <a href=\"/wiki/Mayckel_Lahdo\" title=\"Mayckel Lahdo\">Mayckel Lahdo</a> lämnar klubben för <a href=\"/wiki/AZ_Alkmaar\" title=\"AZ Alkmaar\">AZ</a>.<sup id=\"cite&#95;ref-18\" class=\"reference\"><a href=\"#cite_note-18\"><span class=\"cite-bracket\">&#91;</span>18<span class=\"cite-bracket\">&#93;</span></a></sup> Media spekulerade om en övergångssumma omkring sju miljoner kronor.<sup id=\"cite&#95;ref-ab220617mayckel&#95;19-0\" class=\"reference\"><a href=\"#cite_note-ab220617mayckel-19\"><span class=\"cite-bracket\">&#91;</span>19<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li>Den 11 juli meddelas att <a href=\"/wiki/Laorent_Shabani\" title=\"Laorent Shabani\">Laorent Shabani</a> lämnar <a href=\"/wiki/IK_Sirius_FK\" title=\"IK Sirius FK\">IK Sirius</a> för seriekonkurrenten <a href=\"/wiki/IFK_Norrk%C3%B6ping\" title=\"IFK Norrköping\">IFK Norrköping</a>.<sup id=\"cite&#95;ref-20\" class=\"reference\"><a href=\"#cite_note-20\"><span class=\"cite-bracket\">&#91;</span>20<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby IF</a> presenterar i samband med match den 11 juli försäljning av <a href=\"/wiki/Bj%C3%B8rn_Paulsen\" title=\"Bjørn Paulsen\">Bjørn Paulsen</a> till <a href=\"/wiki/Odense_BK\" title=\"Odense BK\">Odense BK</a>,<sup id=\"cite&#95;ref-21\" class=\"reference\"><a href=\"#cite_note-21\"><span class=\"cite-bracket\">&#91;</span>21<span class=\"cite-bracket\">&#93;</span></a></sup> samt nyförvärv av <a href=\"/wiki/Pavle_Vagic\" title=\"Pavle Vagic\">Pavle Vagic</a> från <a href=\"/wiki/Rosenborg_BK\" title=\"Rosenborg BK\">Rosenborg BK</a>, <a href=\"/wiki/Abdelrahman_Saidi\" class=\"mw-redirect\" title=\"Abdelrahman Saidi\">Abdelrahman Saidi</a> från <a href=\"/wiki/Degerfors_IF\" title=\"Degerfors IF\">Degerfors IF</a>, <a href=\"/wiki/Shaquille_Pinas\" title=\"Shaquille Pinas\">Shaquille Pinas</a> från <a href=\"/wiki/PFK_Ludogorets_Razgrad\" title=\"PFK Ludogorets Razgrad\">Ludogorets Razgrad</a> och <a href=\"/w/index.php?title=David_Concha&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"David Concha [inte skriven än]\">David Concha</a> från <a href=\"/w/index.php?title=CD_Badajoz&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"CD Badajoz [inte skriven än]\">CD Badajoz</a>.<sup id=\"cite&#95;ref-22\" class=\"reference\"><a href=\"#cite_note-22\"><span class=\"cite-bracket\">&#91;</span>22<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li>Den 12 juli meddelas att <a href=\"/wiki/Oscar_Vilhelmsson\" title=\"Oscar Vilhelmsson\">Oscar Vilhelmsson</a> lämnar <a href=\"/wiki/IFK_G%C3%B6teborg\" title=\"IFK Göteborg\">IFK Göteborg</a> för <a href=\"/wiki/SV_Darmstadt_98\" title=\"SV Darmstadt 98\">Darmstadt 98</a> i <a href=\"/wiki/2._Fu%C3%9Fball-Bundesliga\" title=\"2. Fußball-Bundesliga\">2. Bundesliga</a>. Övergångssumma uppges vara cirka 16 miljoner kronor.<sup id=\"cite&#95;ref-23\" class=\"reference\"><a href=\"#cite_note-23\"><span class=\"cite-bracket\">&#91;</span>23<span class=\"cite-bracket\">&#93;</span></a></sup></li></ul>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Lag\">Lag</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2022&amp;veaction=edit&amp;section=5\" title=\"Redigera avsnitt: Lag\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2022&amp;action=edit&amp;section=5\" title=\"Redigera avsnitts källkod: Lag\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>16 lag har kvalificerat sig för spel i allsvenskan 2022 efter resultat från <a href=\"/wiki/Fotbollsallsvenskan_2021\" title=\"Fotbollsallsvenskan 2021\">allsvenskan 2021</a> och <a href=\"/wiki/Superettan_2021\" title=\"Superettan 2021\">superettan 2021</a>.<sup id=\"cite&#95;ref-24\" class=\"reference\"><a href=\"#cite_note-24\"><span class=\"cite-bracket\">&#91;</span>24<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-25\" class=\"reference\"><a href=\"#cite_note-25\"><span class=\"cite-bracket\">&#91;</span>25<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Städer_och_arenor\"><span id=\"St.C3.A4der_och_arenor\"></span>Städer och arenor</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2022&amp;veaction=edit&amp;section=6\" title=\"Redigera avsnitt: Städer och arenor\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2022&amp;action=edit&amp;section=6\" title=\"Redigera avsnitts källkod: Städer och arenor\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable sortable\" style=\"text-align: left;\">\n<tbody><tr>\n<th width=\"130\">Lag\n</th>\n<th width=\"140\"><a href=\"/wiki/Sveriges_l%C3%A4n\" title=\"Sveriges län\">Län</a>\n</th>\n<th width=\"100\">Ort\n</th>\n<th width=\"130\">Arena\n</th>\n<th>Underlag\n</th>\n<th colspan=\"2\">Kapacitet\n</th>\n<th>Placering<br />2021\n</th></tr>\n<tr>\n<td><a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\"><img alt=\"Stockholms län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/20px-Stockholm_l%C3%A4n_vapen.svg.png\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/40px-Stockholm_l%C3%A4n_vapen.svg.png 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Stockholm\" title=\"Stockholm\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Friends_Arena\" class=\"mw-redirect\" title=\"Friends Arena\">Friends Arena</a>\n</td>\n<td><a href=\"/wiki/Gr%C3%A4smatta\" title=\"Gräsmatta\">Gräs</a>\n</td>\n<td align=\"center\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;050000.&amp;&amp;&amp;&amp;&amp;0</span>50&#160;000\n</td>\n<td align=\"center\"><sup id=\"cite&#95;ref-26\" class=\"reference\"><a href=\"#cite_note-26\"><span class=\"cite-bracket\">&#91;</span>26<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td align=\"center\"><span style=\"display:none\" class=\"sortkey\">B &#xfeff;</span><span class=\"sorttext\">2</span>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/BK_H%C3%A4cken\" title=\"BK Häcken\">BK Häcken</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/V%C3%A4stra_G%C3%B6talands_l%C3%A4n\" title=\"Västra Götalands län\"><img alt=\"Västra Götalands län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/d/da/V%C3%A4stra_G%C3%B6taland_vapen.svg/20px-V%C3%A4stra_G%C3%B6taland_vapen.svg.png\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/d/da/V%C3%A4stra_G%C3%B6taland_vapen.svg/40px-V%C3%A4stra_G%C3%B6taland_vapen.svg.png 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/V%C3%A4stra_G%C3%B6talands_l%C3%A4n\" title=\"Västra Götalands län\">Västra Götaland</a>\n</td>\n<td><a href=\"/wiki/G%C3%B6teborg\" title=\"Göteborg\">Göteborg</a>\n</td>\n<td><a href=\"/wiki/Bravida_Arena\" class=\"mw-redirect\" title=\"Bravida Arena\">Bravida Arena</a>\n</td>\n<td><a href=\"/wiki/Konstgr%C3%A4s\" title=\"Konstgräs\">Konstgräs</a>\n</td>\n<td align=\"center\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;06250.&amp;&amp;&amp;&amp;&amp;0</span>6&#160;250–<span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;06300.&amp;&amp;&amp;&amp;&amp;0</span>6&#160;300\n</td>\n<td align=\"center\"><sup id=\"cite&#95;ref-27\" class=\"reference\"><a href=\"#cite_note-27\"><span class=\"cite-bracket\">&#91;</span>27<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td align=\"center\"><span style=\"display:none\" class=\"sortkey\">L &#xfeff;</span><span class=\"sorttext\">12</span>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Degerfors_IF\" title=\"Degerfors IF\">Degerfors IF</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/%C3%96rebro_l%C3%A4n\" title=\"Örebro län\"><img alt=\"Örebro län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/3/31/%C3%96rebro_l%C3%A4n_vapen.svg/20px-%C3%96rebro_l%C3%A4n_vapen.svg.png\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/3/31/%C3%96rebro_l%C3%A4n_vapen.svg/40px-%C3%96rebro_l%C3%A4n_vapen.svg.png 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/%C3%96rebro_l%C3%A4n\" title=\"Örebro län\">Örebro</a>\n</td>\n<td><a href=\"/wiki/Degerfors\" title=\"Degerfors\">Degerfors</a>\n</td>\n<td><a href=\"/wiki/Stora_Valla\" title=\"Stora Valla\">Stora Valla</a>\n</td>\n<td><a href=\"/wiki/Gr%C3%A4smatta\" title=\"Gräsmatta\">Gräs</a>\n</td>\n<td align=\"center\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;07500.&amp;&amp;&amp;&amp;&amp;0</span>7&#160;500\n</td>\n<td align=\"center\"><sup id=\"cite&#95;ref-28\" class=\"reference\"><a href=\"#cite_note-28\"><span class=\"cite-bracket\">&#91;</span>28<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td align=\"center\"><span style=\"display:none\" class=\"sortkey\">M &#xfeff;</span><span class=\"sorttext\">13</span>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Djurg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgårdens IF</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\"><img alt=\"Stockholms län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/20px-Stockholm_l%C3%A4n_vapen.svg.png\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/40px-Stockholm_l%C3%A4n_vapen.svg.png 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Stockholm\" title=\"Stockholm\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Tele2_Arena\" class=\"mw-redirect\" title=\"Tele2 Arena\">Tele2 Arena</a>\n</td>\n<td><a href=\"/wiki/Konstgr%C3%A4s\" title=\"Konstgräs\">Konstgräs</a>\n</td>\n<td align=\"center\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;030000.&amp;&amp;&amp;&amp;&amp;0</span>30&#160;000\n</td>\n<td align=\"center\"><sup id=\"cite&#95;ref-t2&#95;29-0\" class=\"reference\"><a href=\"#cite_note-t2-29\"><span class=\"cite-bracket\">&#91;</span>29<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td align=\"center\"><span style=\"display:none\" class=\"sortkey\">C &#xfeff;</span><span class=\"sorttext\">3</span>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">GIF Sundsvall</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/V%C3%A4sternorrlands_l%C3%A4n\" title=\"Västernorrlands län\"><img alt=\"Västernorrlands län\" src=\"//upload.wikimedia.org