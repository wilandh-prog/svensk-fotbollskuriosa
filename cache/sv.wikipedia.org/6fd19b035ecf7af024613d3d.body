table infobox\" style=\"font-size:0.8em;\">\n\n<tbody><tr>\n<td rowspan=\"2\" style=\"background-color:#ffec8b;\">&#8195;\n</td>\n<td>Svenska mästare\n</td></tr>\n<tr>\n<td>Kvalificerad för kval till <a href=\"/wiki/Uefa_Champions_League_2023/2024\" title=\"Uefa Champions League 2023/2024\">Champions League 2023/2024</a>\n</td></tr>\n<tr>\n<td style=\"background-color:#FFFFDD;\">&#8195;</td>\n<td>Kvalificerad för kval till <a href=\"/wiki/Uefa_Europa_Conference_League_2023/2024\" title=\"Uefa Europa Conference League 2023/2024\">Europa Conference League 2023/2024</a>\n</td></tr>\n<tr>\n<td style=\"background-color:#f4dcdc;\">&#8195;</td>\n<td><a href=\"/w/index.php?title=Kvalspelet_till_Fotbollsallsvenskan_2023&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Kvalspelet till Fotbollsallsvenskan 2023 [inte skriven än]\">Kvalspel</a> om <a href=\"/wiki/Fotbollsallsvenskan_2023\" title=\"Fotbollsallsvenskan 2023\">Allsvenskan 2023</a>\n</td></tr>\n<tr>\n<td style=\"background-color:#f0c4c4\">&#8195;</td>\n<td>Nedflyttad till <a href=\"/wiki/Superettan_2023\" title=\"Superettan 2023\">Superettan 2023</a>\n</td></tr>\n</tbody></table>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Poängtabell\"><span id=\"Po.C3.A4ngtabell\"></span>Poängtabell</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2022&amp;veaction=edit&amp;section=10\" title=\"Redigera avsnitt: Poängtabell\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2022&amp;action=edit&amp;section=10\" title=\"Redigera avsnitts källkod: Poängtabell\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>&#160;<span class=\"noprint plainlinks\" style=\"white-space:nowrap; font-weight:normal; font-size:80%; ;\">Denna tabell:&#160;<a href=\"/wiki/Mall:Po%C3%A4ngtabell_f%C3%B6r_Fotb