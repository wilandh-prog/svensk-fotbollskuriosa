tuna_United_DFF\" title=\"Eskilstuna United DFF\">Eskilstuna United</a>  </td>\n<td>22</td>\n<td> 11 </td>\n<td> 5  </td>\n<td> 6  </td>\n<td> 34 </td>\n<td> 19 </td>\n<td>+15</td>\n<td style=\"font-weight:bold;\">38</td>\n</tr><tr style=\"background:white;\"> <td>5</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Link%C3%B6pings_FC\" class=\"mw-redirect\" title=\"Linköpings FC\">Linköpings FC</a>  </td>\n<td>22</td>\n<td> 10 </td>\n<td> 6  </td>\n<td> 6  </td>\n<td> 37 </td>\n<td> 20 </td>\n<td>+17</td>\n<td style=\"font-weight:bold;\">36</td>\n</tr><tr style=\"background:white;\"> <td>6</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Pite%C3%A5_IF_Dam\" title=\"Piteå IF Dam\">Piteå IF</a> <span style=\"cursor:help;color:dimgrey;font-size:0.8em;font-weight:bold;\" title=\"Regerande mästare\">(RM)</span>  </td>\n<td>22</td>\n<td> 8  </td>\n<td> 10 </td>\n<td> 4  </td>\n<td> 30 </td>\n<td> 21 </td>\n<td>+9</td>\n<td style=\"font-weight:bold;\">34</td>\n</tr><tr style=\"background:white;\"> <td>7</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Kristianstads_DFF\" title=\"Kristianstads DFF\">Kristianstads DFF</a>  </td>\n<td>22</td>\n<td> 9  </td>\n<td> 6  </td>\n<td> 7  </td>\n<td> 38 </td>\n<td> 30 </td>\n<td>+8</td>\n<td style=\"font-weight:bold;\">33</td>\n</tr><tr style=\"background:white;\"> <td>8</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/KIF_%C3%96rebro_DFF\" title=\"KIF Örebro DFF\">KIF Örebro</a> <span style=\"cursor:help;color:dimgrey;font-size:0.8em;font-weight:bold;\" title=\"Uppflyttad från föregående säsong\">(U)</span>  </td>\n<td>22</td>\n<td> 9  </td>\n<td> 3  </td>\n<td> 10 </td>\n<td> 28 </td>\n<td> 30 </td>\n<td>−2</td>\n<td style=\"font-weight:bold;\">30</td>\n</tr><tr style=\"background:white;\"> <td>9</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/V%C3%A4xj%C3%B6_DFF\" title=\"Växjö DFF\">Växjö DFF</a>  </td>\n<td>22</td>\n<td> 6  </td>\n<td> 7  </td>\n<td> 9  </td>\n<td> 25 </td>\n<td> 40 </td>\n<td>−15</td>\n<td style=\"font-weight:bold;\">25</td>\n</tr><tr style=\"background:white; border-bottom:2px solid red;\"> <td>10</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Djurg%C3%A5rdens_IF_Dam\" title=\"Djurgårdens IF Dam\">Djurgårdens IF</a>  </td>\n<td>22</td>\n<td> 4  </td>\n<td> 2  </td>\n<td> 16 </td>\n<td> 24 </td>\n<td> 49 </td>\n<td>−25</td>\n<td style=\"font-weight:bold;\">14</td>\n</tr><tr style=\"background:#f0c4c4;\"> <td>11</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/IF_Limhamn_Bunkeflo_(damer)\" class=\"mw-redirect\" title=\"IF Limhamn Bunkeflo (damer)\">Limhamn Bunkeflo</a>  </td>\n<td>22</td>\n<td> 3  </td>\n<td> 5  </td>\n<td> 14 </td>\n<td> 16 </td>\n<td> 46 </td>\n<td>−30</td>\n<td style=\"font-weight:bold;\">14</td>\n</tr><tr style=\"background:#f0c4c4;\"> <td>12</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Kungsbacka_DFF\" title=\"Kungsbacka DFF\">Kungsbacka DFF</a> <span style=\"cursor:help;color:dimgrey;font-size:0.8em;font-weight:bold;\" title=\"Uppflyttad från föregående säsong\">(U)</span>  </td>\n<td>22</td>\n<td> 1  </td>\n<td> 2  </td>\n<td> 19 </td>\n<td> 14 </td>\n<td> 72 </td>\n<td>−58</td>\n<td style=\"font-weight:bold;\">5</td>\n</tr></tbody></table>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Resultattabell\">Resultattabell</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Damallsvenskan_2019&amp;veaction=edit&amp;section=3\" title=\"Redigera avsnitt: Resultattabell\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Damallsvenskan_2019&amp;action=edit&amp;section=3\" title=\"Redigera avsnitts källkod: Resultattabell\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>&#160;<span class=\"noprint plainlinks\" style=\"white-space:nowrap; font-weight:normal; font-size:80%; ;\">Denna tabell:&#160;<a href=\"/wiki/Mall:Result