%; left:79.70515265499%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:2px;\"><a href=\"/wiki/Pite%C3%A5_IF_Dam\" title=\"Piteå IF Dam\">Piteå</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:35.750363915663%; left:74.012664346702%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:2px;\"><a href=\"/wiki/Ume%C3%A5_IK_FF\" title=\"Umeå IK FF\">Umeå</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:87.166900685071%; left:25.588940847071%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:2px;\"><a href=\"/wiki/Vittsj%C3%B6_GIK\" title=\"Vittsjö GIK\">Vittsjö</a></span></div>\n</div>\n</div>\n</div>\n<div style=\"font-size:90%\">Deltagande lag, Damallsvenskan 2016.</div>\n</div>\n<p><b>Damallsvenskan 2016</b> var <a href=\"/wiki/Sverige\" title=\"Sverige\">Sveriges</a> högsta division i fotboll för damer under säsongen 2016, och spelades under perioden <a href=\"/wiki/16_april\" title=\"16 april\">16 april</a>–<a href=\"/wiki/5_november\" title=\"5 november\">5 november</a> <a href=\"/wiki/Sport%C3%A5ret_2016\" title=\"Sportåret 2016\">2016</a>.<sup id=\"cite&#95;ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Lag_och_arenor\">Lag och arenor</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Damallsvenskan_2016&amp;veaction=edit&amp;section=1\" title=\"Redigera avsnitt: Lag och arenor\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Damallsvenskan_2016&amp;action=edit&amp;section=1\" title=\"Redigera avsnitts källkod: Lag och arenor\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable sortable\" style=\"text-align: