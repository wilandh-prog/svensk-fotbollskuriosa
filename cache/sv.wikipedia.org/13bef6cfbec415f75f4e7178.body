:78.2%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:2px;\"><a href=\"/wiki/Pite%C3%A5_IF_Dam\" title=\"Piteå IF Dam\">Piteå</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:39.4%; left:69.6%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:2px;\"><a href=\"/wiki/Ume%C3%A5_IK_FF\" title=\"Umeå IK FF\">Umeå</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:91.4%; left:23%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:2px;\"><a href=\"/wiki/Vittsj%C3%B6_GIK\" title=\"Vittsjö GIK\">Vittsjö</a></span></div>\n</div>\n</div>\n</div>\n<div style=\"font-size:90%\">Deltagande lag, Damallsvenskan 2014.</div>\n</div>\n</td></tr></tbody></table>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Tabeller\">Tabeller</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Damallsvenskan_2014&amp;veaction=edit&amp;section=2\" title=\"Redigera avsnitt: Tabeller\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Damallsvenskan_2014&amp;action=edit&amp;section=2\" title=\"Redigera avsnitts källkod: Tabeller\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Poängtabell\"><span id=\"Po.C3.A4ngtabell\"></span>Poängtabell</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Damallsvenskan_2014&amp;veaction=edit&amp;section=3\" title=\"Redigera avsnitt: Poängtabell\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Damallsvenskan_2014&amp;action=edit&amp;section=3\" title=\"Redigera avsnitts källkod: Poängtabell\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>På grund av brist på spelare drog <a href=\"/wiki/Tyres%C3%B6_FF\" title=\"Tyresö FF\">Tyresö FF</a> sig ur serien den 5 juni 2014, och därmed accepterade klubben nedflyttning till <a href=\"/wiki/Division_2_i_fotboll_f%C3%B6r_damer\" title=\"Division 2 i fotboll för damer\">Division 2</a>. Tyresö hade då spelat sju matcher som sedan ogiltigförklarades och raderades, vilket gjorde att poängtabellen räknades om. Detta medför att endast ett lag flyttades ned till <a href=\"/wiki/Elitettan\" title=\"Elitettan\">Elitettan</a> denna säsong.<sup id=\"cite&#95;ref-Tyresö&#95;drar&#95;sig&#95;ur&#95;2-0\" class=\"reference\"><a href=\"#cite_note-Tyresö_drar_sig_ur-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<table class=\"infobox wikitable\" style=\"font-size:85%;width:22em;\">\n\n<tbody><tr>\n<td style=\"background:#ffec8b;\">&#8195;</td>\n<td>Mästare och kvalificerade för <a href=\"/wiki/Uefa_Women%27s_Champions_League_2015/2016\" title=\"Uefa Women&#39;s Champions League 2015/2016\">Champions League 2015/16</a>\n</td></tr>\n<tr>\n<td style=\"background:#c3c3dc;\">&#8195;</td>\n<td>Kvalificerade för <a href=\"/wiki/Uefa_Women%27s_Champions_League_2015/2016\" title=\"Uefa Women&#39;s Champions League 2015/2016\">Champions League 2015/16</a>\n</td></tr>\n<tr>\n<td style=\"background:#f0c4c4;\">&#8195;</td>\n<td>Nedflyttade till <a href=\"/wiki/Elitettan_2015\" title=\"Elitettan 2015\">Elitettan 2015</a>\n</td></tr>\n<tr>\n<td style=\"background:#bbb;\">&#8195;</td>\n<td>Diskvalificerade och nedflyttade till <a href=\"/w/index.php?title=Division_2_i_fotboll_f%C3%B6r_damer_2015&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Division 2 i fotboll för damer 2015 [inte skriven än]\">Division 2 2015</a><sup id=\"cite&#95;ref-Tyresö&#95;drar&#95;sig&#95;ur&#95;2-1\" class=\"reference\"><a href=\"#cite_note-Tyresö_drar_sig_ur-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td></tr></tbody></table>\n<p>&#160;<span class=\"noprint plainlinks\" style=\"white-space:nowrap; font-weight:normal; font-size:80%; ;\">Denna tabell:&#160;<a href=\"/wiki/Mall:Po%C3%A4ngtabell_f%C3%B6r_Damallsvenskan_2014\" title=\"Mall:Poängtabell för Damallsvenskan 2014\"><span title=\"Visa denna mall\" style=\";\">visa</span></a>&#160;<span style=\"font-size:80%;\">•</span>&#160;<a class=\"external text\" data-mw-original-href=\"//sv.wikipedia.org/w/index.php?title=Mall:Po%C3%A4ngtabell_f%C3%B6r_Damallsvenskan_2014&amp;action=edit\" href=\"https://sv.wikipedia.org/w/index.php?title=Mall:Po%C3%A4ngtabell_f%C3%B6r_Damallsvenskan_2014&amp;action=edit\"><span style=\";\" title=\"Redigera den här mallen\">redigera</span></a></span>&#160;\n</p>\n<table class=\"wikitable sortable\" style=\"font-size:0.9375em;line-height:1.4em;text-align:center;background:white;margin-top:0.1em;\">\n<tbody><tr><th style=\"width:1.8em;\"> <span style=\"cursor:help;\" title=\"Placering\">Nr</span> </th>\n<th style=\"width: 13em;\"> Lag </th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Spelade matcher\">S</span></th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Vinster\">V</span>        </th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Oavgjorda\">O</span>      </th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Förluster\">F</span>      </th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Gjorda mål\">GM</span>    </th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Insläppta mål\">IM</span> </th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Målskillnad\">MS</span>   </th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Poäng\">P</span>          </th>\n</tr>\n<tr style=\"background:#ffec8b; border-bottom:2px solid gray;\"> <td>1</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/FC_Roseng%C3%A5rd_(damfotboll)\" title=\"FC Rosengård (damfotboll)\">FC Rosengård</a> <span style=\"cursor:help;col