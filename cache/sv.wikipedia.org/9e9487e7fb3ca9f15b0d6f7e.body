em 0.4em 0.6em}.mw-parser-output .infobox.geography .maptable td,.mw-parser-output .infobox.geography .maptable th{border:0;padding:0}</style><table class=\"infobox\" style=\"border-spacing:3px; width:30em;\"><caption class=\"\" style=\"font-size: 125%; font-weight: bold;\"><a href=\"/wiki/Allsvenskan_(fotboll)\" title=\"Allsvenskan (fotboll)\">Allsvenskan</a></caption><tbody><tr><td colspan=\"2\" class=\"\" style=\"text-align:center;\"> <span typeof=\"mw:File\"><a href=\"/wiki/Fil:GBG-MFF_2017.jpg\" class=\"mw-file-description\" title=\"GBG-MFF 2017.jpg\"><img alt=\"GBG-MFF 2017.jpg\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f5/GBG-MFF_2017.jpg/250px-GBG-MFF_2017.jpg\" decoding=\"async\" width=\"200\" height=\"99\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f5/GBG-MFF_2017.jpg/500px-GBG-MFF_2017.jpg 2x\" data-file-width=\"2048\" data-file-height=\"1012\" /></a></span> <div style=\"\">Premiärmatchen IFK Göteborg - Malmö FF</div></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><a href=\"/wiki/Fotbollss%C3%A4song\" title=\"Fotbollssäsong\">Säsong</a></th><td class=\"\" style=\"\">2017</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><span style=\"white-space:nowrap\">Nya lag för säsongen</span></th><td class=\"\" style=\"\"><a href=\"/wiki/IK_Sirius_FK\" title=\"IK Sirius FK\">IK Sirius</a><br /><a href=\"/wiki/AFC_Eskilstuna\" title=\"AFC Eskilstuna\">AFC Eskilstuna</a><sup id=\"cite&#95;ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">&#91;</span>a<span class=\"cite-bracket\">&#93;</span></a></sup><br /><a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstads BK</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Vinnare</th><td class=\"\" style=\"\"><a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö FF</a><br />(23:e allsvenska titeln)<br />(20:e <a href=\"/wiki/Svenska_m%C3%A4stare_i_fotboll\" title=\"Svenska mästare i fotboll\">SM</a>-titeln)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Nedflyttade</th><td class=\"\" style=\"\"><a href=\"/wiki/AFC_Eskilstuna\" title=\"AFC Eskilstuna\">AFC Eskilstuna</a><br /><a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstads BK</a><br /><a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköpings Södra</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><a href=\"/wiki/Uefa_Champions_League_2018/2019\" title=\"Uefa Champions League 2018/2019\">Champions League</a></th><td class=\"\" style=\"\"><a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö FF</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><a href=\"/wiki/Uefa_Europa_League_2018/2019\" title=\"Uefa Europa League 2018/2019\">Europa League</a></th><td class=\"\" style=\"\"><a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a><br /><a href=\"/wiki/Djurg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgården</a></td></tr><tr><th colspan=\"2\" style=\"text-align:center;background-color:#f0f1f2;\">Statistik</th></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Spelade&#160;matcher</th><td class=\"\" style=\"\">240</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Totalt&#160;antal&#160;mål</th><td class=\"\" style=\"\">665 (2,8 per match)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;hemmavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö</a> 6–0 <a href=\"/wiki/Kalmar_FF\" title=\"Kalmar FF\">Kalmar</a><br /><span style=\"font-size:smaller; line-height:130%\">(11 augusti 2017)</span><br /><a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö</a> 6–0 <a href=\"/wiki/IF_Elfsborg\" title=\"IF Elfsborg\">Elfsborg</a><br /><span style=\"font-size:smaller; line-height:130%\">(25 september 2017)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;bortavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/IK_Sirius_FK\" title=\"IK Sirius FK\">Sirius</a> 0–5 <a href=\"/wiki/%C3%96stersunds_FK\" title=\"Östersunds FK\">Östersund</a><br /><span style=\"font-size:smaller; line-height:130%\">(17 september 2017)</span><br /><a href=\"/wiki/BK_H%C3%A4cken\" title=\"BK Häcken\">Häcken</a> 1–6 <a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a><br /><span style=\"font-size:smaller; line-height:130%\">(24 september 2017)</span><br /><a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">Sundsvall</a> 0–5 <a href=\"/wiki/Djurg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgården</a><br /><span style=\"font-size:smaller; line-height:130%\">(1 oktober 2017)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest mål i en match</th><td class=\"\" style=\"\"><a href=\"/wiki/IF_Elfsborg\" title=\"IF Elfsborg\">Elfsborg</a> 4–4 <a href=\"/wiki/%C3%96stersunds_FK\" title=\"Östersunds FK\">Östersund</a><br /><span style=\"font-size:smaller; line-height:130%\">(2 maj 2017)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Högsta&#160;åskådarantal</th><td class=\"\" style=\"\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;033157.&amp;&amp;&amp;&amp;&amp;0</span>33&#160;157. <a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a> 1–1 <a href=\"/wiki/Djurg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgården</a><br /><span style=\"font-size:smaller; line-height:130%\">(27 augusti 2017)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Lägsta&#160;åskådarantal</th><td class=\"\" style=\"\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;0887.&amp;&amp;&amp;&amp;&amp;0</span>887. <a href=\"/wiki/AFC_Eskilstuna\" title=\"AFC Eskilstuna\">Eskilstuna</a> 1–3 <a href=\"/wiki/IK_Sirius_FK\" title=\"IK Sirius FK\">Sirius</a><br /><span style=\"font-size:smaller; line-height:130%\">(5 november 2017)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Totalt åskådarantal</th><td class=\"\" style=\"\">2 180 852</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Åskådarantal i snitt</th><td class=\"\" style=\"\">9 087</td></tr><tr><td colspan=\"2\" style=\"text-align:center;\" class=\"\"><div style=\"float: left;\">&#8592; <a href=\"/wiki/Fotbollsallsvenskan_2016\" title=\"Fotbollsallsvenskan 2016\">2016</a> </div><div style=\"float: right;\"><a href=\"/wiki/Fotbollsallsvenskan_2018\" title=\"Fotbollsallsvenskan 2018\">2018</a> &#8594;</div></td></tr>\n</tbody></table>\n<div style=\"float:right;clear:right;width:354px;padding:4px;border:1px solid silver;margin:4px;background-color:white\">\n<div style=\"position:relative;border:1px solid silver;padding:0px;width:350px\"><span typeof=\"mw:File\"><a href=\"/wiki/Fil:Map_of_Sweden_(polar_stereographic).svg\" class=\"mw-file-description\"><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/56/Map_of_Sweden_%28polar_stereographic%29.svg/500px-Map_of_Sweden_%28polar_stereographic%29.svg.png\" decoding=\"async\" width=\"350\" height=\"846\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/56/Map_of_Sweden_%28polar_stereographic%29.svg/960px-Map_of_Sweden_%28polar_stereographic%29.svg.png 2x\" data-file-width=\"365\" data-file-height=\"882\" /></a></span><br />\n<div style=\"position:absolute;z-index:200;top:66.599286684424%; left:49.886333148956%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"posi