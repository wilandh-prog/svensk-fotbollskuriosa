upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/20px-Stockholm_l%C3%A4n_vapen.svg.png\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/40px-Stockholm_l%C3%A4n_vapen.svg.png 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Stockholm\" title=\"Stockholm\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Tele2_Arena\" class=\"mw-redirect\" title=\"Tele2 Arena\">Tele2 Arena</a>\n</td>\n<td>Konstgräs\n</td>\n<td align=\"center\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;030000.&amp;&amp;&amp;&amp;&amp;0</span>30&#160;000\n</td>\n<td align=\"center\"><sup id=\"cite&#95;ref-23\" class=\"reference\"><a href=\"#cite_note-23\"><span class=\"cite-bracket\">&#91;</span>22<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td align=\"center\"><span style=\"display:none\" class=\"sortkey\">g &#xfeff;</span><span class=\"sorttext\">7</span>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">GIF Sundsvall</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/V%C3%A4sternorrlands_l%C3%A4n\" title=\"Västernorrlands län\"><img alt=\"Västernorrlands län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/d/da/V%C3%A4sternorrland_l%C3%A4n_vapen.svg/20px-V%C3%A4sternorrland_l%C3%A4n_vapen.svg.png\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/d/da/V%C3%A4sternorrland_l%C3%A4n_vapen.svg/40px-V%C3%A4sternorrland_l%C3%A4n_vapen.svg.png 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/V%C3%A4sternorrlands_l%C3%A4n\" title=\"Västernorrla