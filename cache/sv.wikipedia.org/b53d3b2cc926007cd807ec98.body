<br />(20 mål)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;hemmavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/%C3%96stersunds_FK\" title=\"Östersunds FK\">Östersunds FK</a> 5–0 <a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköpings Södra IF</a> (<small>4 maj 2013</small>)<br /><a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona BoIS</a> 5–0 <a href=\"/wiki/Varbergs_BoIS_FC\" title=\"Varbergs BoIS FC\">Varbergs BoIS</a> (<small>22 juli 2013</small>)<br /><a href=\"/wiki/%C3%84ngelholms_FF\" title=\"Ängelholms FF\">Ängelholms FF</a> 6–1 <a href=\"/wiki/Assyriska_FF\" title=\"Assyriska FF\">Assyriska FF</a> (<small>29 juli 2013</small>)<br /><a href=\"/wiki/%C3%96rebro_SK_Fotboll\" title=\"Örebro SK Fotboll\">Örebro SK</a> 6–1 <a href=\"/wiki/Gais\" title=\"Gais\">Gais</a> (<small>27 oktober 2013</small>)<sup id=\"cite&#95;ref-spelprogram&#95;1-0\" class=\"reference\"><a href=\"#cite_note-spelprogram-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;bortavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/IFK_V%C3%A4rnamo\" title=\"IFK Värnamo\">IFK Värnamo</a> 0–5 <a href=\"/wiki/%C3%96rebro_SK_Fotboll\" title=\"Örebro SK Fotboll\">Örebro SK</a> (<small>2 augusti 2013</small>)<sup id=\"cite&#95;ref-spelprogram&#95;1-1\" class=\"reference\"><a href=\"#cite_note-spelprogram-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest mål i en match</th><td class=\"\" style=\"\"><a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">GIF Sundsvall</a> 4–4 <a href=\"/wiki/Gais\" title=\"Gais\">Gais</a> (<small>20 juli 2013</small>)<sup id=\"cite&#95;ref-spelprogram&#95;1-2\" class=\"reference\"><a href=\"#cite_note-spelprogram-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Högsta&#160;åskådarantal</th><td class=\"\" style=\"\">29 175<sup id=\"cite&#95;ref-spelprogram&#95;1-3\" class=\"reference\"><a href=\"#cite_note-spelprogram-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup><br /><a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby IF</a> 0–0 <a href=\"/wiki/%C3%96rgryte_IS\" title=\"Örgryte IS\">Örgryte IS</a> (<small>20 juli 2013</small>)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Lägsta&#160;åskådarantal</th><td class=\"\" style=\"\">179<sup id=\"cite&#95;ref-spelprogram&#95;1-4\" class=\"reference\"><a href=\"#cite_note-spelprogram-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup><br /><a href=\"/wiki/%C3%84ngelholms_FF\" title=\"Ängelholms FF\">Ängelholms FF</a> 2–2 <a href=\"/wiki/Degerfors_IF\" title=\"Degerfors IF\">Degerfors IF</a> (<small>18 maj 2013</small>)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Totalt åskådarantal</th><td class=\"\" style=\"\">709 712<sup id=\"cite&#95;ref-Publikliga&#95;2-0\" class=\"reference\"><a href=\"#cite_note-Publikliga-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Åskådarantal i snitt</th><td class=\"\" style=\"\">2 957<sup id=\"cite&#95;ref-Publikliga&#95;2-1\" class=\"reference\"><a href=\"#cite_note-Publikliga-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup></td></tr><tr><td colspan=\"2\" style=\"text-align:center;\" class=\"\"><div sty