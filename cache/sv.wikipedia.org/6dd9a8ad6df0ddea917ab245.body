:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:2px;\"><a href=\"/wiki/IK_Brage\" title=\"IK Brage\">Brage</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:75.9%; left:48%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Öster</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:84.7%; left:27%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:2px;\"><a href=\"/wiki/%C3%84ngelholms_FF\" title=\"Ängelholms FF\">Ängelholm</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:89.3%; left:26.8%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:2px;\"><a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:63.7%; left:41.1%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:9em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköpings Södra</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:71.7%; left:40%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/IFK_V%C3%A4rnamo\" title=\"IFK Värnamo\">Värnamo</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:43.3%; left:84.4%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby</a></span></div>\n</div>\n</div>\n</div>\n<div style=\"font-size:90%\">Placering av deltagande lag, Superettan 2011.</div>\n</div>\n<p><b>Superettan 2011</b> var den tolfte säsongen av <a href=\"/wiki/Superettan\" title=\"Superettan\">Superettan</a>, Sveriges näst högsta <a href=\"/wiki/Division_(sport)\" title=\"Division (sport)\">division</a> i <a href=\"/wiki/Fotboll\" title=\"Fotboll\">fotboll</a> för herrar. Serien spelades mellan den <a href=\"/wiki/9_april\" title=\"9 april\">9 april</a> och <a href=\"/wiki/22_oktober\" title=\"22 oktober\">22 oktober</a> <a href=\"/wiki/Sport%C3%A5ret_2011\" title=\"Sportåret 2011\">2011</a>.<sup id=\"cite&#95;ref-Spelprogram&#95;1-5\" class=\"reference\"><a href=\"#cite_note-Spelprogram-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup> \n</p><p>Nykomlingar i serien var <a href=\"/wiki/V%C3%A4ster%C3%A5s_SK_Fotboll\" class=\"mw-redirect\" title=\"Västerås SK Fotboll\">Västerås SK</a>, som senast hade spelat i <a href=\"/wiki/Superettan_2005\" title=\"Superettan 2005\">Superettan 2005</a>, och <a href=\"/wiki/IFK_V%C3%A4rnamo\" title=\"IFK Värnamo\">IFK Värnamo</a> som tidigare aldrig spelat i Superettan.\n</p><p>På grund av dålig ekonomi tvångsnedflyttades <a href=\"/wiki/%C3%96rgryte_IS\" title=\"Örgryte IS\">Örgryte IS</a> den <a href=\"/wiki/16_februari\" title=\"16 februari\">16 februari</a> <a href=\"/wiki/Sport%C3%A5ret_2011\" title=\"Sportåret 2011\">2011</a> till <a href=\"/wiki/Division_1_i_fotboll_2011\" class=\"mw-redirect\" title=\"Division 1 i fotboll 2011\">Division 1</a> och ersattes av <a href=\"/wiki/Qviding_FIF\" title=\"Qviding FIF\">Qviding FIF</a> som förlorade kvalet till Superettan 2011 mot <a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Östers IF</a>.\n</p><p>Nedflyttade från <a href=\"/wiki/Fotbollsallsvenskan_2010\" title=\"Fotbollsallsvenskan 2010\">Fotbollsallsvenskan 2010</a> var <a href=\"/wiki/%C3%85tvidabergs_FF\" title=\"Åtvidabergs FF\">Åtvidabergs FF</a> och <a href=\"/wiki/IF_Brommapojkarna\" title=\"IF Brommapojkarna\">IF Brommapojkarna</a>.\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Deltagande_lag\">Deltagande lag</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Superettan_2011&amp;veaction=edit&amp;section=1\" title=\"Redigera avsnitt: Deltagande lag\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Superettan_2011&amp;action=edit&amp;section=1\" title=\"Redigera avsnitts källkod: Deltagande lag\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable\">\n<tbody><tr>\n<th>Lag</th>\n<th>Serie 2010</th>\n<th>Placering 2010</th>\n<th>Kvalspel\n</th></tr>\n<tr>\n<td><a href=\"/wiki/%C3%85tvidabergs_FF\" title=\"Åtvidabergs FF\">Åtvidabergs FF</a></td>\n<td><a href=\"/wiki/Fotbollsallsvenskan_2010\" title=\"Fotbollsallsvenskan 2010\">Allsvenskan</a></td>\n<td>15:e</td>\n<td>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/IF_Brommapojkarna\" title=\"IF Brommapojkarna\">IF Brommapojkarna</a></td>\n<td><a href=\"/wiki/Fotbollsallsvenskan_2010\" title=\"Fotbollsallsvenskan 2010\">Allsvenskan</a></td>\n<td>16:e</td>\n<td>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">GIF Sundsvall</a></td>\n<td><a href=\"/wiki/Superettan_2010\" title=\"Superettan 2010\">Superettan</a></td>\n<td>3:a</td>\n<td>Förlorade kvalet mot Gefle IF\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Assyriska_FF\" title=\"Assyriska FF\">Assyriska FF</a></td>\n<td><a href=\"/wiki/Superettan_2010\" title=\"Superettan 2010\">Superettan</a></td>\n<td>4:a</td>\n<td>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona BoIS</a></td>\n<td><a href=\"/wiki/Superettan_2010\" title=\"Superettan 2010\">Superettan</a></td>\n<td>5:a</td>\n<td>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Ljungskile_SK\" title=\"Ljungskile SK\">Ljungskile SK</a></td>\n<td><a href=\"/wiki/Superettan_2010\" title=\"Superettan 2010\">Superettan</a></td>\n<td>6:a</td>\n<td>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Falkenbergs_FF\" title=\"Falkenbergs FF\">Falkenbergs FF</a></td>\n<td><a href=\"/wiki/Superettan_2010\" title=\"Superettan 2010\">Superettan</a></td>\n<td>7:a</td>\n<td>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby IF</a></td>\n<td><a href=\"/wiki/Superettan_2010\" title=\"Superettan 2010\">Superettan</a></td>\n<td>8:a</td>\n<td>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Degerfors_IF\" title=\"Degerfors IF\">Degerfors IF</a></td>\n<td><a href=\"/wiki/Superettan_2010\" title=\"Superettan 2010\">Superettan</a></td>\n<td>10:a</td>\n<td>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/IK_Brage\" title=\"IK Brage\">IK Brage</a></td>\n<td><a href=\"/wiki/Superettan_2010\" title=\"Superettan 2010\">Superettan</a></td>\n<td>11:a</td>\n<td>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%C3%84ngelholms_FF\" title=\"Ängelholms FF\">Ängelholms FF</a></td>\n<td><a href=\"/wiki/Superettan_2010\" title=\"Superettan 2010\">Superettan</a></td>\n<td>12:a</td>\n<td>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköpings Södra</a></td>\n<td><a href=\"/wiki/Superettan_2010\" title=\"Superettan 2010\">Superettan</a></td>\n<td>13:e</td>\n<td>Vann kvalet mot IK Sirius\n</td></tr>\n<tr>\n<td><a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Östers IF</a></td>\n<td><a href=\"/wiki/Superettan_2010\" title=\"Superettan 2010\">Superettan</a></td>\n<td>14:e</td>\n<td>Vann kvalet mot Qviding FIF\n</td></tr>\n<tr>\n<td><a href=\"/wiki/IFK_V%C3%A4rnamo\" title=\"IFK Värnamo\">IFK Värnamo</a></td>\n<td><a href=\"/wiki/Division_1_i_fotboll_2010\" class=\"mw-redirect\" title=\"Division 1 i fotboll 2010\">Division 1 södra</a></td>\n<td>1:a</td>\n<td>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/V%C3%A4ster%C3%A5s_SK_Fotboll\" class=\"mw-redirect\" title=\"Västerås SK Fotboll\">Västerås SK</a></td>\n<td><a href=\"/wiki/Division_1_i_fotboll_2010\" class=\"mw-redirect\" title=\"Division 1 i fotboll 2010\">Division 1 norra</a></td>\n<td>1:a</td>\n<td>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Qviding_FIF\" title=\"Qviding FIF\">Qviding FIF</a></td>\n<td><a href=\"/wiki/Division_1_i_fotboll_2010\" class=\"mw-redirect\" title=\"Division 1 i fotboll 2010\">Division 1 södra</a></td>\n<td>2:a</td>\n<td>Förlorade kvalet mot Östers IF, men övertog senare vakansen efter Örgryte IS\n</td></tr></tbody></table>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Kvalspelsresultat_inför_Superettan_2011\"><span id=\"Kvalspelsresultat_inf.C3.B6r_Superettan_2011\"></span>Kvalspelsresultat inför Superettan 2011</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Superettan_2011&amp;veaction=edit&amp;section=2\" title=\"Redigera avsnitt: Kvalspelsresultat inför Superettan 2011\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Superettan_2011&amp;action=edit&amp;section=2\" title=\"Redigera avsnitts källkod: Kvalspelsresultat inför Superettan 2011\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p><i>Lagen från de högre divisionerna hade hemmamatch i returerna.</i>\n</p>\n<ul><li>Allsvenskt kval (3:an i Superettan mot 14:e laget i Allsvenskan)\n<ul><li><a href=\"/wiki/10_november\" title=\"10 november\">10 november</a> <a href=\"/wiki/2010\" title=\"2010\">2010</a>: <a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">GIF Sundsvall</a> - <a href=\"/wiki/Gefle_IF_Fotboll\" title=\"Gefle IF Fotboll\">Gefle IF</a> 0 - 1 <a rel=\"nofollow\" class=\"external text\" href=\"https://fogis.se/information/?scr=result&amp;fmid=1574031\">Rapport</a></li>\n<li><a href=\"/wiki/14_november\" title=\"14 november\">14 november</a> <a href=\"/wiki/2010\" title=\"2010\">2010</a>: <a href=\"/wiki/Gefle_IF_Fotboll\" title=\"Gefle IF Fotboll\">Gefle IF</a> - <a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">GIF Sundsvall</a> 2 - 0 <a rel=\"nofollow\" class=\"external text\" href=\"https://fogis.se/information/?scr=result&amp;fmid=1574032\">Rapport</a>\n<ul><li><b>Sammanlagda resultatet: 3 - 0 till Gefle IF</b></li></ul></li></ul></li>\n<li>Superettankval (2:an i Div 1 Norra mot 13:e laget i Superettan)\n<ul><li><a href=\"/wiki/31_oktober\" title=\"31 oktober\">31 oktober</a> <a href=\"/wiki/2010\" title=\"2010\">2010</a>: <a href=\"/wiki/IK_Sirius_FK\" title=\"IK Sirius FK\">IK Sirius</a> - <a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköpings Södra</a> 0 - 1 <a rel=\"nofollow\" class=\"external text\" href=\"https://fogis.se/information/?scr=result&amp;fmid=1573033\">Rapport</a></li>\n<li><a href=\"/wiki/7_november\" title=\"7 november\">7 november</a> <a href=\"/wiki/2010\" title=\"2010\">2010</a>: <a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköpings Södra</a> - <a href=\"/wiki/IK_Sirius_FK\" title=\"IK Sirius FK\">IK Sirius</a> 3 - 0 <a rel=\"nofollow\" class=\"external text\" href=\"https://fogis.se/information/?scr=result&amp;fmid=1573035\">Rapport</a>\n<ul><li><b>Sammanlagda resultatet: 4 - 0 till Jönköpings Södra</b></li></ul></li></ul></li>\n<li>Superettankval (2:an i Div 1 Södra mot 14:e laget i Superettan)\n<ul><li><a href=\"/wiki/31_oktober\" title=\"31 oktober\">31 oktober</a> <a href=\"/wiki/2010\" title=\"2010\">2010</a>: <a href=\"/wiki/Qviding_FIF\" title=\"Qviding FIF\">Qviding FIF</a> - <a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Östers IF</a> 0 - 2 <a rel=\"nofollow\" class=\"external text\" href=\"https://fogis.se/information/?scr=result&amp;fmid=1573034\">Rapport</a></li>\n<li><a href=\"/wiki/6_november\" title=\"6 november\">6 november</a> <a href=\"/wiki/2010\" title=\"2010\">2010</a>: <a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Östers IF</a> - <a href=\"/wiki/Qviding_FIF\" title=\"Qviding FIF\">Qviding FIF</a> 2 - 1 <a rel=\"nofollow\" class=\"external text\" href=\"https://fogis.se/information/?scr=result&amp;fmid=1573036\">Rapport</a>\n<ul><li><b>Sammanlagda resultatet: 4 - 1 till Östers IF</b></li></ul></li></ul></li></ul>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Arenor\">Arenor</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Superettan_2011&amp;veaction=edit&amp;section=3\" title=\"Redigera avsnitt: Arenor\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Superettan_2011&amp;action=edit&amp;section=3\" title=\"Redigera avsnitts källkod: Arenor\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<dl><dd><i>Senast uppdaterad den <a href=\"/wiki/4_oktober\" title=\"4 oktober\">4 oktober</a> <a href=\"/wiki/Sport%C3%A5ret_2012\" title=\"Sportåret 2012\">2012</a></i></dd></dl>\n<div align=\"left\">\n<ul class=\"gallery mw-gallery-traditional\">\n\t\t<li class=\"gallerybox\" style=\"width: 185px\">\n\t\t\t<div class=\"thumb\" style=\"width: 180px; height: 180px;\"><span typeof=\"mw:File\"><a href=\"/wiki/Fil:Domnarvsvallen.jpg\" class=\"mw-file-description\" title=\"Domnarvsvallen i Borlänge\"><img alt=\"Domnarvsvallen i Borlänge\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/3/38/Domnarvsvallen.jpg/250px-Domnarvsvallen.jpg\" decoding=\"async\" width=\"150\" height=\"113\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/3/38/Domnarvsvallen.jpg/330px-Domnarvsvallen.jpg 2x\" data-file-width=\"3072\" data-file-height=\"2304\" /></a></span></div>\n\t\t\t<div class=\"gallerytext\"><a href=\"/wiki/Domnarvsvallen\" class=\"mw-redirect\" title=\"Domnarvsvallen\">Domnarvsvallen</a> i <a href=\"/wiki/Borl%C3%A4nge\" title=\"Borlänge\">Borlänge</a></div>\n\t\t</li>\n\t\t<li class=\"gallerybox\" style=\"width: 185px\">\n\t\t\t<div class=\"thumb\" style=\"width: 180px; height: 180px;\"><span typeof=\"mw:File\"><a href=\"/wiki/Fil:Valhalla_IP.jpg\" class=\"mw-file-description\" title=\"Valhalla IP i Göteborg\"><img alt=\"Valhalla IP i Göteborg\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/6/6a/Valhalla_IP.jpg/250p