bro_DFF\" title=\"KIF Örebro DFF\">KIF Örebro</a>  </td>\n<td>22</td>\n<td> 8  </td>\n<td> 5 </td>\n<td> 9  </td>\n<td> 33 </td>\n<td> 33 </td>\n<td>0</td>\n<td style=\"font-weight:bold;\">29</td>\n</tr><tr style=\"background:white;\"> <td>7</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Hammarby_IF_DFF\" class=\"mw-redirect\" title=\"Hammarby IF DFF\">Hammarby IF</a>  </td>\n<td>22</td>\n<td> 8  </td>\n<td> 5 </td>\n<td> 9  </td>\n<td> 34 </td>\n<td> 33 </td>\n<td>+1</td>\n<td style=\"font-weight:bold;\">29</td>\n</tr><tr style=\"background:white;\"> <td>8</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Sunnan%C3%A5_SK\" title=\"Sunnanå SK\">Sunnanå SK</a>  </td>\n<td>22</td>\n<td> 8  </td>\n<td> 3 </td>\n<td> 11 </td>\n<td> 26 </td>\n<td> 33 </td>\n<td>−7</td>\n<td style=\"font-weight:bold;\">27</td>\n</tr><tr style=\"background:white;\"> <td>9</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/B%C3%A4linge_IF\" title=\"Bälinge IF\">Bälinge IF</a> <span style=\"cursor:help;color:dimgrey;font-size:0.8em;font-weight:bold;\" title=\"Uppflyttad från föregående säsong\">(U)</span>  </td>\n<td>22</td>\n<td> 4  </td>\n<td> 7 </td>\n<td> 11 </td>\n<td> 16 </td>\n<td> 41 </td>\n<td>−25</td>\n<td style=\"font-weight:bold;\">19</td>\n</tr><tr style=\"background:white; border-bottom:2px solid red;\"> <td>10</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/QBIK\" title=\"QBIK\">QBIK</a>  </td>\n<td>22</td>\n<td> 2  </td>\n<td> 9 </td>\n<td> 11 </td>\n<td> 18 </td>\n<td> 51 </td>\n<td>−33</td>\n<td style=\"font-weight:bold;\">15</td>\n</tr><tr style=\"background:#f0c4c4;\"> <td>11</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Jitex_BK\" title=\"Jitex BK\">Jitex BK</a> <span style=\"cursor:help;color:dimgrey;font-size:0.8em;font-weight:bold;\" title=\"Uppflyttad från föregående säsong\">(U)</span>  </td>\n<td>22</td>\n<td> 2  </td>\n<td> 7 </td>\n<td> 13 </td>\n<td> 17 </td>\n<td> 59 </td>\n<td>−42</td>\n<td style=\"font-weight:bold;\">13</td>\n</tr><tr style=\"background:#f0c4c4;\"> <td>12</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Mallbackens_IF\" title=\"Mallbackens IF\">Mallbackens IF</a>  </td>\n<td>22</td>\n<td> 3  </td>\n<td> 2 </td>\n<td> 17 </td>\n<td> 15 </td>\n<td> 44 </td>\n<td>−29</td>\n<td style=\"font-weight:bold;\">11</td>\n</tr></tbody></table>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Resultattabell\">Resultattabell</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Damallsvenskan_2006&amp;veaction=edit&amp;section=3\" title=\"Redigera avsnitt: Resultattabell\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Damallsvenskan_2006&amp;action=edit&amp;section=3\" title=\"Redigera avsnitts källkod: Resultattabell\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>&#160;<span class=\"noprint plainlinks\" style=\"white-space:nowrap; font-weight:normal; font-size:80%; ;\">Denna tabell:&#160;<a href=\"/wiki/Mall:Resultattabell_f%C3%B6r_Damallsvenskan_2006\" title=\"Mall:Resultattabell för Damallsvenskan 2006\"><span title=\"Visa denna mall\" style=\";\">visa</span></a>&#160;<span style=\"font-size:80%;\">•</span>&#160;<a class=\"external text\" data-mw-original-href=\"//sv.wikipedia.org/w/index.php?title=Mall:Resultattabell_f%C3%B6r_Damallsvenskan_2006&amp;action=edit\" href=\"https://sv.wikipedia.org/w/index.php?title=Mall:Resultattabell_f%C3%B6r_Damallsvenskan_2006&amp;action=edit\"><span style=\";\" title=\"Redigera den här mallen\">redigera</span></a></span>&#160;\n</p>\n<table class=\"wikitable\" style=\"font-size:0.9375em;text-align:center;line-height:1.4em;margin-top:0.1em;\">\n<tbody><tr>\n<td style=\"min-width:11em;background:#eee;color:#333;font-weight:normal;text-align:center;\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/d/d0/ArrowDown.