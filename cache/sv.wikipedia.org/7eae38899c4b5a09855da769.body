0.6em}.mw-parser-output .infobox.geography .maptable td,.mw-parser-output .infobox.geography .maptable th{border:0;padding:0}</style><table class=\"infobox\" style=\"border-spacing:3px; width:30em;\"><caption class=\"\" style=\"font-size: 125%; font-weight: bold;\"><a href=\"/wiki/Superettan\" title=\"Superettan\">Superettan</a></caption><tbody><tr><td colspan=\"2\" class=\"\" style=\"text-align:center;\"> <span typeof=\"mw:File\"><a href=\"/wiki/Fil:J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF-IK_Sirius,_2_juni_2015.jpg\" class=\"mw-file-description\" title=\"Jönköpings Södra IF-IK Sirius, 2 juni 2015.jpg\"><img alt=\"Jönköpings Södra IF-IK Sirius, 2 juni 2015.jpg\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/d/d8/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF-IK_Sirius%2C_2_juni_2015.jpg/250px-J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF-IK_Sirius%2C_2_juni_2015.jpg\" decoding=\"async\" width=\"200\" height=\"112\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/d/d8/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF-IK_Sirius%2C_2_juni_2015.jpg/500px-J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF-IK_Sirius%2C_2_juni_2015.jpg 2x\" data-file-width=\"2592\" data-file-height=\"1456\" /></a></span> <div style=\"\">Matchen Jönköpings Södra-IK Sirius (1–1) på Stadsparksvallen i Jönköping,  2 juni 2015.</div></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><a href=\"/wiki/Fotbollss%C3%A4song\" title=\"Fotbollssäsong\">Säsong</a></th><td class=\"\" style=\"\">2015</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Vinnare</th><td class=\"\" style=\"\"><a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköpings Södra</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Uppflyttade</th><td class=\"\" style=\"\"><b>Nykomlingar för året:</b><br /><a href=\"/wiki/Utsiktens_BK\" title=\"Utsiktens BK\">Utsikten</a><br /><a href=\"/wiki/IK_Frej\" title=\"IK Frej\">Frej</a><br /><a href=\"/wiki/AFC_United\" class=\"mw-redirect\" title=\"AFC United\">AFC United</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Nedflyttade</th><td class=\"\" style=\"\"><a href=\"/wiki/IF_Brommapojkarna\" title=\"IF Brommapojkarna\">Brommapojkarna</a><br /><a href=\"/wiki/Utsiktens_BK\" title=\"Utsiktens BK\">Utsikten</a><br /><a href=\"/wiki/Mj%C3%A4llby_AIF\" title=\"Mjällby AIF\">Mjällby</a></td></tr><tr><th colspan=\"2\" style=\"text-align:center;background-color:#f0f1f2;\">Statistik</th></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Spelade&#160;matcher</th><td class=\"\" style=\"\">240</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Totalt&#160;antal&#160;mål</th><td class=\"\" style=\"\">611 (2,5 per match)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Bästa målgörare</th><td class=\"\" style=\"\"><a href=\"/wiki/Fredrik_Olsson_(fotbollsspelare_f%C3%B6dd_1985)\" title=\"Fredrik Olsson (fotbollsspelare född 1985)\">Fredrik Olsson</a>, <a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköpings Södra</a> (17)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;hemmavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/Assyriska_FF\" title=\"Assyriska FF\">Assyriska</a> 7–1 <a href=\"/wiki/Utsiktens_BK\" title=\"Utsiktens BK\">Utsikten</a><br /><span style=\"font-size:smaller; line-height:130%\">(19 juli 2015)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;bortavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/%C3%84ngelholms_FF\" title=\"Ängelholms FF\">Ängelholm</a> 0–4 <a href=\"/wiki/IK_Frej\" title=\"IK Frej\">Frej</a><br /><span style=\"font-size:smaller; line-height:130%\">(2 maj 2015)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest mål i en match</th><td class=\"\" style=\"\"><a href=\"/wiki/Assyriska_FF\" title=\"Assyriska FF\">Assyriska</a> 7–1 <a href=\"/wiki/Utsiktens_BK\" title=\"Utsiktens BK\">Utsikten</a><br /><span style=\"font-size:smaller; line-height:130%\">(19 juli 2015)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest vunna matcher i rad</th><td class=\"\" style=\"\">5 matcher<br /><a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköpings Södra</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest obesegrade matcher</th><td class=\"\" style=\"\">14 matcher<br /><a href=\"/wiki/IK_Sirius_FK\" title=\"IK Sirius FK\">Sirius</a><sup id=\"cite&#95;ref-IKS&#95;1-0\" class=\"reference\"><a href=\"#cite_note-IKS-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest matcher utan vinst</th><td class=\"\" style=\"\">12 matcher<br /><a href=\"/wiki/IK_Frej\" title=\"IK Frej\">Frej</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest förlorade i rad</th><td class=\"\" style=\"\">7 matcher<br /><a href=\"/wiki/Mj%C3%A4llby_AIF\" title=\"Mjällby AIF\">Mjällby</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Högsta&#160;åskådarantal</th><td class=\"\" style=\"\">6 544.<br /><a href=\"/wiki/%C3%96stersunds_FK\" title=\"Östersunds FK\">Östersund</a> 2–0 <a href=\"/wiki/Ljungskile_SK\" title=\"Ljungskile SK\">Ljungskile</a><br /><span style=\"font-size:smaller; line-height:130%\">(1 november 2015)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Lägsta&#160;åskådarantal</th><td class=\"\" style=\"\">100.<br /><a href=\"/wiki/AFC_United\" class=\"mw-redirect\" title=\"AFC United\">AFC United</a> 2–0 <a href=\"/wiki/Utsiktens_BK\" title=\"Utsiktens BK\">Utsikten</a><br /><span style=\"font-size:smaller; line-height:130%\">(25 april 2015)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Totalt åskådarantal</th><td class=\"\" style=\"\">389 604</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Åskådarantal i snitt</th><td class=\"\" style=\"\">1 623</td></tr><tr><td colspan=\"2\" style=\"text-align:center;\" class=\"\"><div style=\"float: left;\">&#8592; <a href=\"/wiki/Superettan_2014\" title=\"Superettan 2014\">2014</a> </div><div style=\"float: right;\"><a href=\"/wiki/Superettan_2016\" title=\"Superettan 2016\">2016</a> &#8594;</div></td></tr>\n</tbody></table>\n<p><b>Superettan 2015</b> var <a href=\"/wiki/Sverige\" title=\"Sverige\">Sveriges</a> näst högsta division i fotboll för herrar under 2015 års säsong.\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Lag_och_arenor\">Lag och arenor</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Superettan_2015&amp;veaction=edit&amp;section=1\" title=\"Redigera avsnitt: Lag och arenor\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Superettan_2015&amp;action=edit&amp;section=1\" title=\"Redigera avsnitts källkod: Lag och arenor\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div style=\"float:right;clear:right;width:354px;padding:4px;border:1px solid silver;margin:4px;background-color:white\">\n<div style=\"position:relative;border:1px solid silver;padding:0px;width:350px\"><span typeof=\"mw:File\"><a href=\"/wiki/Fil:Map_of_Sweden_(polar_stereographic).svg\" class=\"mw-file-description\"><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/56/Map_of_Sweden_%28polar_stereographic%29.svg/500px-Map_of_Sweden_%28polar_stereographic%29.svg.png\" decoding=\"async\" width=\"350\" height=\"846\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/56/Map_of_Sweden_%28polar_stereographic%29.svg/960px-Map_of_Sweden_%28polar_stereographic%29.svg.png 2x\" data-file-width=\"365\" data-file-height=\"882\" /></a></span><br />\n<div style=\"position:absolute;z-index:200;top:65.371818892681%; left:61.488706025089%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background: #FFFFFF\"><span style=\"position:relative;top:5px;left:2px;\"><a href=\"/wiki/AFC_United\" class=\"mw-redirect\" title=\"AFC United\">United</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:67.680640132739%; left:59.402217952276%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"paddin