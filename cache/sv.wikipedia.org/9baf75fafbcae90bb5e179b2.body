thumb/5/5b/Malm%C3%B6_FF_-_IFK_G%C3%B6teborg_2016.jpg/500px-Malm%C3%B6_FF_-_IFK_G%C3%B6teborg_2016.jpg 2x\" data-file-width=\"2048\" data-file-height=\"1536\" /></a></span>\n</td>\n<td><span typeof=\"mw:File\"><a href=\"/wiki/Fil:Behrn_Arena_2008.JPG\" class=\"mw-file-description\" title=\"Behrn Arena\"><img alt=\"Behrn Arena\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/8/89/Behrn_Arena_2008.JPG/250px-Behrn_Arena_2008.JPG\" decoding=\"async\" width=\"180\" height=\"135\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/8/89/Behrn_Arena_2008.JPG/500px-Behrn_Arena_2008.JPG 2x\" data-file-width=\"3072\" data-file-height=\"2304\" /></a></span>\n</td>\n<td><span typeof=\"mw:File\"><a href=\"/wiki/Fil:J%C3%A4mtkraft_Arena.jpg\" class=\"mw-file-description\" title=\"Jämtkraft Arena\"><img alt=\"Jämtkraft Arena\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f0/J%C3%A4mtkraft_Arena.jpg/250px-J%C3%A4mtkraft_Arena.jpg\" decoding=\"async\" width=\"180\" height=\"135\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f0/J%C3%A4mtkraft_Arena.jpg/500px-J%C3%A4mtkraft_Arena.jpg 2x\" data-file-width=\"3296\" data-file-height=\"2472\" /></a></span>\n</td></tr>\n</tbody></table>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Tabeller\">Tabeller</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2019&amp;veaction=edit&amp;section=3\" title=\"Redigera avsnitt: Tabeller\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2019&amp;action=edit&amp;section=3\" title=\"Redigera avsnitts källkod: Tabeller\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable infobox\" style=\"font-size:0.8em;\">\n\n<tbody><tr>\n<td rowspan=\"2\" style=\"background-color:#ffec8b;\">&#8195;\n</td>\n<td>Svenska mästare\n</td></tr>\n<tr>\n<td>Kvalificerad för kval till <a href=\"/wiki/Uefa_Champions_League_2020/2021\" title=\"Uefa Champions League 2020/2021\">Champions League 2020/2021</a>\n</td></tr>\n<tr>\n<td style=\"background-color:#d7e6f5;\">&#8195;</td>\n<td>Kvalificerad för kval till <a href=\"/wiki/Uefa_Europa_League_2020/2021\" title=\"Uefa Europa League 2020/2021\">Europa League 2020/2021</a>\n</td></tr>\n<tr>\n<td style=\"background-color:#f4dcdc;\">&#8195;</td>\n<td><a href=\"/w/index.php?title=Kvalspelet_till_Fotbollsallsvenskan_2020&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Kvalspelet till Fotbollsallsvenskan 2020 [inte skriven än]\">Kvalspel</a> om <a href=\"/wiki/Fotbollsallsvenskan_2020\" title=\"Fotbollsallsvenskan 2020\">Allsvenskan 2020</a>\n</td></tr>\n<tr>\n<td style=\"background-color:#f0c4c4\">&#8195;</td>\n<td>Nedflyttad till <a href=\"/wiki/Superettan_2020\" title=\"Superettan 2020\">Superettan 2020</a>\n</td></tr>\n</tbody></table>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Poängtabell\"><span id=\"Po.C3.A4ngtabell\"></span>Poängtabell</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2019&amp;veaction=edit&amp;section=4\" title=\"Redigera avsnitt: Poängtabell\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2019&amp;action=edit&amp;section=4\" title=\"Redigera avsnitts källkod: Poängtabell\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>&#160;<span class=\"noprint plainlinks\" style=\"white-space:nowrap; font-weight:normal; font-size:80%; ;\">Denna tabell:&#160;<a href=\"/wiki/Mall:Po%C3%A4ngtabell_f%C3%B6r_Fotbollsallsvenskan_2019\" title=\"Mall:Poängtabell för Fotbollsallsvenskan 2019\"><span title=\"Visa denna mall\" style=\";\">visa</span>