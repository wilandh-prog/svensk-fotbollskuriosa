:none\"><span style=\"position:relative;top:5px;left:-2px\"><a href=\"/wiki/Kalmar_FF\" title=\"Kalmar FF\">Kalmar</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:92.253468464796%; left:19.130160300885%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:63.184981680132%; left:58.884230582908%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:-2px;\"><a href=\"/wiki/IK_Sirius_FK\" title=\"IK Sirius FK\">Sirius</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:67.422629104525%; left:39.149569060051%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:2px;\"><a href=\"/wiki/%C3%96rebro_SK_Fotboll\" title=\"Örebro SK Fotboll\">Örebro</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:40.924540127242%; left:33.993480462926%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/%C3%96stersunds_FK\" title=\"Östersunds FK\">Östersund</a></span></div>\n</div>\n</div>\n</div>\n<div style=\"font-size:90%\">Geografisk placering av de deltagande lagen i allsvenskan 2019.</div>\n</div>\n<p><b>Fotbollsallsvenskan 2019</b> var den 95:e säsongen av allsvenskan sedan starten <a href=\"/wiki/Fotbollsallsvenskan_1924/25\" class=\"mw-redirect\" title=\"Fotbollsallsvenskan 1924/25\">1924</a> och Sveriges högsta liga i <a href=\"/wiki/Fotboll\" title=\"Fotboll\">fotboll</a> 2019. <a href=\"/wiki/Djurg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgårdens IF</a> säkrade SM-guldet i den 30:e och sista omgången den 2 november 2019 genom att spela 2−2 borta mot <a href=\"/wiki/IFK_Norrk%C3%B6ping\" title=\"IFK Norrköping\">IFK Norrköping</a>. Djurgården vann därmed sin första allsvenska titel sedan <a href=\"/wiki/Fotbollsallsvenskan_2005\" title=\"Fotbollsallsvenskan 2005\">2005</a>, samt sin tolfte <a href=\"/wiki/Svenska_m%C3%A4stare_i_fotboll#Herrar\" title=\"Svenska mästare i fotboll\">svenska mästerskapstitel</a>. Detta innebar att ett Stockholmslag tog hem titeln för andra året i rad. Hammarby slog med sina 75 gjorda mål rekordet för flest antal gjorda mål under en allsvensk säsong för den tid då serien spelats med 16 lag.<sup id=\"cite&#95;ref-3\" class=\"reference\"><a href=\"#cite_note-3\"><span class=\"cite-bracket\">&#91;</span>3<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Lag\">Lag</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2019&amp;veaction=edit&amp;section=1\" title=\"Redigera avsnitt: Lag\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2019&amp;action=edit&amp;section=1\" title=\"Redigera avsnitts källkod: Lag\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>16 lag har kvalificerat sig för spel i fotbollsallsvenskan 2019 efter resultat från <a href=\"/wiki/Fotbollsallsvenskan_2018\" title=\"Fotbollsallsvenskan 2018\">allsvenskan 2018</a> och <a href=\"/wiki/Superettan_2018\" title=\"Superettan 2018\">superettan 2018</a>,<sup id=\"cite&#95;ref-4\" class=\"reference\"><a href=\"#cite_note-4\"><span class=\"cite-bracket\">&#91;</span>4<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-5\" class=\"reference\"><a href=\"#cite_note-5\"><span class=\"cite-bracket\">&#91;</span>5<span class=\"cite-bracket\">&#93;</span></a></sup> samt genom kvalspelet till Allsvenskan där Superettans tredje lag AFC Eskilstuna kvalificerade sig efter möte mot <a href=\"/wiki/IF_Brommapojkarna\" title=\"IF Brommapojkarna\">IF Brommapojkarna</a>.<sup id=\"cite&#95;ref-6\" class=\"reference\"><a href=\"#cite_note-6\"><span class=\"cite-bracket\">&#91;</span>6<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Städer_och_arenor\"><span id=\"St.C3.A4der_och_arenor\"></span>Städer och arenor</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2019&amp;veaction=edit&amp;section=2\" title=\"Redigera avsnitt: Städer och arenor\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2019&amp;action=edit&amp;section=2\" title=\"Redigera avsnitts källkod: Städer och arenor\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable sortable\" style=\"text-align: left;\">\n<tbody><tr>\n<th width=\"130\">Lag\n</th>\n<th width=\"140\"><a href=\"/wiki/Sveriges_l%C3%A4n\" title=\"Sveriges län\">Län</a>\n</th>\n<th width=\"100\">Ort\n</th>\n<th width=\"130\">Arena\n</th>\n<th>Underlag\n</th>\n<th colspan=\"2\">Kapacitet\n</th>\n<th>Placering<br />2018\n</th></tr>\n<tr>\n<td><a href=\"/wiki/Athletic_FC_Eskilstuna\" class=\"mw-redirect\" title=\"Athletic FC Eskilstuna\">AFC Eskilstuna</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/S%C3%B6dermanlands_l%C3%A4n\" title=\"Södermanlands län\"><img alt=\"Södermanlands län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/55/S%C3%B6dermanlands_vapen.svg/20px-S%C3%B6dermanlands_vapen.svg.png\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/55/S%C3%B6dermanlands_vapen.svg/40px-S%C3%B6dermanlands_vapen.svg.png 2x\" data-file-width=\"248\" data-file-height=\"300\" /></a></span>&#160;</span><a href=\"/wiki/S%C3%B6dermanlands_l%C3%A4n\" title=\"Södermanlands län\">Södermanland</a>\n</td>\n<td><a href=\"/wiki/Eskilstuna\" title=\"Eskilstuna\">Eskilstuna</a>\n</td>\n<td><a href=\"/wiki/Tunavallen\" title=\"Tunavallen\">Tunavallen</a>\n</td>\n<td>Konstgräs\n</td>\n<td align=\"center\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;07800.&amp;&amp;&amp;&amp;&amp;0</span>7&#160;800\n</td>\n<td align=\"center\"><sup id=\"cite&#95;ref-7\" class=\"reference\"><a href=\"#cite_note-7\"><span class=\"cite-bracket\">&#91;</span>7<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td align=\"center\"><span style=\"display:none\" class=\"sortkey\">q &#xfeff;</span><span class=\"sorttext\">3</span> <small>(<a href=\"/wiki/Superettan_2018\" title=\"Superettan 2018\">S1</a>)</small>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\"><img alt=\"Stockholms län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/20px-Stockholm_l%C3%A4n_vapen.svg.png\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/40px-Stockholm_l%C3%A4n_vapen.svg.png 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Stockholm\" title=\"Stockholm\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Friends_Arena\" class=\"mw-redirect\" title=\"Friends Arena\">Frien