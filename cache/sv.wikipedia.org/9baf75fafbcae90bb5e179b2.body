urg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgårdens IF</a>  </td>\n<td>30</td>\n<td> 20 </td>\n<td> 6  </td>\n<td> 4  </td>\n<td> 53 </td>\n<td> 19 </td>\n<td>+34</td>\n<td style=\"font-weight:bold;\">66</td>\n</tr>\n<tr style=\"background:#d7e6f5;\"> <td>2</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö FF</a>  </td>\n<td>30</td>\n<td> 19 </td>\n<td> 8  </td>\n<td> 3  </td>\n<td> 56 </td>\n<td> 16 </td>\n<td>+40</td>\n<td style=\"font-weight:bold;\">65</td>\n</tr><tr style=\"background:#d7e6f5; border-bottom:2px solid grey;\"> <td>3</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby IF</a>  </td>\n<td>30</td>\n<td> 20 </td>\n<td> 5  </td>\n<td> 5  </td>\n<td> 75 </td>\n<td> 38 </td>\n<td>+37</td>\n<td style=\"font-weight:bold;\">65</td>\n</tr><tr style=\"background:white;\"> <td>4</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a> <span style=\"cursor:help;color:dimgrey;font-size:0.8em;font-weight:bold;\" title=\"Regerande mästare\">(RM)</span>  </td>\n<td>30</td>\n<td> 19 </td>\n<td> 5  </td>\n<td> 6  </td>\n<td> 47 </td>\n<td> 24 </td>\n<td>+23</td>\n<td style=\"font-weight:bold;\">62</td>\n</tr><tr style=\"background:white;\"> <td>5</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/IFK_Norrk%C3%B6ping\" title=\"IFK Norrköping\">IFK Norrköping</a>  </td>\n<td>30</td>\n<td> 16 </td>\n<td> 9  </td>\n<td> 5  </td>\n<td> 54 </td>\n<td> 26 </td>\n<td>+28</td>\n<td style=\"font-weight:bold;\">57</td>\n</tr><tr style=\"background:white;\"> <td>6</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/BK_H%C3%A4cken\" title=\"BK Häcken\">BK Häcken</a>  </td>\n<td>30</td>\n<td> 14 </td>\n<td> 7  </td>\n<td> 9  </td>\n<td> 44 </td>\n<td> 29 </td>\n<td>+15</td>\n<td style=\"font-weight:bold;\">49</td>\n</tr><tr style=\"background:#d7e6f5;\"> <td>7</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/I