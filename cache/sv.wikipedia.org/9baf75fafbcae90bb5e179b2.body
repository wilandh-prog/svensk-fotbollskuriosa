em 0.4em 0.6em}.mw-parser-output .infobox.geography .maptable td,.mw-parser-output .infobox.geography .maptable th{border:0;padding:0}</style><table class=\"infobox\" style=\"border-spacing:3px; width:30em;\"><caption class=\"\" style=\"font-size: 125%; font-weight: bold;\"><a href=\"/wiki/Allsvenskan_(fotboll)\" title=\"Allsvenskan (fotboll)\">Allsvenskan</a></caption><tbody><tr><td colspan=\"2\" class=\"\" style=\"text-align:center;\"> <span typeof=\"mw:File\"><a href=\"/wiki/Fil:MFF-BK_H%C3%A4cken_AS_2019.jpg\" class=\"mw-file-description\" title=\"MFF-BK Häcken AS 2019.jpg\"><img alt=\"MFF-BK Häcken AS 2019.jpg\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/fd/MFF-BK_H%C3%A4cken_AS_2019.jpg/250px-MFF-BK_H%C3%A4cken_AS_2019.jpg\" decoding=\"async\" width=\"200\" height=\"150\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/fd/MFF-BK_H%C3%A4cken_AS_2019.jpg/500px-MFF-BK_H%C3%A4cken_AS_2019.jpg 2x\" data-file-width=\"4032\" data-file-height=\"3024\" /></a></span> <div style=\"\">BK Häcken gästar Malmö FF i premiäromgången</div></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><a href=\"/wiki/Fotbollss%C3%A4song\" title=\"Fotbollssäsong\">Säsong</a></th><td class=\"\" style=\"\">2019</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><span style=\"white-space:nowrap\">Nya lag för säsongen</span></th><td class=\"\" style=\"\"><a href=\"/wiki/AFC_Eskilstuna\" title=\"AFC Eskilstuna\">AFC Eskilstuna</a><br /><a href=\"/wiki/Helsingborgs_IF\" title=\"Helsingborgs IF\">Helsingborgs IF</a><br /><a href=\"/wiki/Falkenbergs_FF\" title=\"Falkenbergs FF\">Falkenbergs FF</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Vinnare</th><td class=\"\" style=\"\"><a href=\"/wiki/Djurg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgårdens IF</a><br />(8:e allsvenska titeln)<br />(12:e <a href=\"/wiki/Svenska_m%C3%A4stare_i_fotboll\" title=\"Svenska mästare i fotboll\">SM</a>-titeln)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Nedflyttade</th><td class=\"\" style=\"\"><a href=\"/wiki/AFC_Eskilstuna\" title=\"AFC Eskilstuna\">AFC Eskilstuna</a><br /><a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">GIF Sundsvall</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><a href=\"/wiki/Uefa_Champions_League_2020/2021\" title=\"Uefa Champions League 2020/2021\">Champions League</a></th><td class=\"\" style=\"\"><a href=\"/wiki/Djurg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgårdens IF</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><a href=\"/wiki/Uefa_Europa_League_2020/2021\" title=\"Uefa Europa League 2020/2021\">Europa League</a></th><td class=\"\" style=\"\"><a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö FF</a><br /><a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby IF</a></td></tr><tr><th colspan=\"2\" style=\"text-align:center;background-color:#f0f1f2;\">Statistik</th></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Bästa målgörare</th><td class=\"\" style=\"\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/Sierra_Leone\" title=\"Sierra Leone\"><img alt=\"Sierra Leone\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/1/17/Flag_of_Sierra_Leone.svg/40px-Flag_of_Sierra_Leone.svg.png\" decoding=\"async\" width=\"22\" height=\"15\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/1/17/Flag_of_Sierra_Leone.svg/60px-Flag_of_Sierra_Leone.svg.png 2x\" data-file-width=\"900\" data-file-height=\"600\" /></a></span></span> <a href=\"/wiki/Mohamed_Buya_Turay\" title=\"Mohamed Buya Turay\">Mohamed Buya Turay</a> (15 mål)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;hemmavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/IFK_G%C3%B6teborg\" title=\"IFK Göteborg\">Göteborg</a> 7–1 <a href=\"/wiki/%C3%96stersunds_FK\" title=\"Östersunds FK\">Östersund</a><br /><span style=\"font-size:smaller; line-height:130%\">(2 november 2019)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;bortavinst</th><td class=\"\" style=\"\"><div class=\"mw-collapsible mw-collapsed\" style=\"border:none;text-align:center;\"><div style=\"font-weight:bold;background-color:transparent;color:inherit;text-align:center;\">2 matcher</div>\n<div class=\"mw-collapsible-content\" style=\"font-weight:normal;background-color:transparent;color:inherit;text-align:left;\"><a href=\"/wiki/AFC_Eskilstuna\" title=\"AFC Eskilstuna\">Eskilstuna</a> 1–6 <a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby</a><br /><span style=\"font-size:smaller; line-height:130%\">(27 juli 2019)</span><br /><a href=\"/wiki/%C3%96rebro_SK_Fotboll\" title=\"Örebro SK Fotboll\">Örebro</a> 0–5 <a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö</a><br /><span style=\"font-size:smaller; line-height:130%\">(2 november 2019</span></div></div></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Målrikaste match</th><td class=\"\" style=\"\"><div class=\"mw-collapsible mw-collapsed\" style=\"border:none;text-align:center;\"><div style=\"font-weight:bold;background-color:transparent;color:inherit;text-align:center;\">3 matcher</div>\n<div class=\"mw-collapsible-content\" style=\"font-weight:normal;background-color:transparent;color:inherit;text-align:left;\"><a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby</a> 6–2 <a href=\"/wiki/Falkenbergs_FF\" title=\"Falkenbergs FF\">Falkenberg</a><br /><span style=\"font-size:smaller; line-height:130%\">(7 juli 2019)</span><br /><a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby</a> 6–2 <a href=\"/wiki/IFK_G%C3%B6teborg\" title=\"IFK Göteborg\">Göteborg</a><br /><span style=\"font-size:smaller; line-height:130%\">(15 september 2019)</span><br /><a href=\"/wiki/IFK_G%C3%B6teborg\" title=\"IFK Göteborg\">Göteborg</a> 7–1 <a href=\"/wiki/%C3%96stersunds_FK\" title=\"Östersunds FK\">Östersund</a><br /><span style=\"font-size:smaller; line-height:130%\">(2 november 2019)</span></div></div></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest vunna matcher i rad</th><td class=\"\" style=\"\">8 matcher<br />Hammarby IF<sup id=\"cite&#95;ref-streaks&#95;1-0\" class=\"reference\"><a href=\"#cite_note-streaks-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest obesegrade matcher</th><td class=\"\" style=\"\">18 matcher<br /><a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö FF</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest matcher utan vinst</th><td class=\"\" style=\"\">18 matcher<br /><a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">GIF Sundsvall</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest förlorade i rad</th><td class=\"\" style=\"\">7 matcher<br /><a href=\"/wiki/%C3%96stersunds_FK\" title=\"Östersunds FK\">Östersunds FK</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Högsta&#160;åskådarantal</th><td class=\"\" style=\"\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;045367.&amp;&amp;&amp;&amp;&amp;0</span>45&#160;367<br /><a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a> 1–0 <a href=\"/wiki/Djurg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgården</a><br /><span style=\"font-size:smaller; line-height:130%\">(1 september 2019)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Lägsta&#160;åskådarantal</th><td class=\"\" style=\"\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;01876.&amp;&amp;&amp;&amp;&amp;0</span>1&#160;876<br /><a href=\"/wiki/AFC_Eskilstuna\" title=\"AFC Eskilstuna\">Eskilstuna</a> 0–2 <a href=\"/wiki/BK_H%C3%A4cken\" title=\"BK Häcken\">Häcken</a><br /><span style=\"font-size:smaller; line-height:130%\">(25 augusti 2019)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Åskådarantal i snitt</th><td class=\"\" style=\"\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;09167.&amp;&amp;&amp;&amp;&amp;0</span>9&#160;167<sup id=\"cite&#95;ref-2\" class=\"reference\"><a href=\"#cite_note-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup></td></tr><tr><td colspan=\"2\" style=\"text-align:center;\" class=\"\"><div style=\"float: left;\">&#8592; <a href=\"/wiki/Fotbollsallsvenskan_2018\" title=\"Fotbollsallsvenskan 2018\">2018</a> </div><div style=\"float: right;\"><a href=\"/wiki/Fotbollsallsvenskan_2020\" title=\"Fotbollsallsvenskan 2020\">2020</a> &#8594;</div></td></tr>\n</tbody></table>\n<div style=\"float:right;clear:right;width:354px;padding:4px;border:1px solid silver;margin:4px;background-color:white\">\n<div style=\"position:relative;border:1px solid silver;padding:0px;width:350px\"><span typeof=\"mw:File\"><a href=\"/wiki/Fil:Map_of_Sweden_(polar_stereographic).svg\" class=\"mw-file-description\"><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/56/Map_of_Sweden_%28polar_stereographic%29.svg/500px-Map_of_Sweden_%28polar_stereographic%29.svg.png\" decoding=\"async\" width=\"350\" height=\"846\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/56/Map_of_Sweden_%28polar_stereographic%29.svg/960px-Map_of_Sweden_%28polar_stereographic%29.svg.png 2x\" data-file-width=\"365\" data-file-height=\"882\" /></a></span><br />\n<div style=\"position:absolute;z-index:200;top:66.330453760862%; left:62.289872621749%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:-5px;\"><a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:66.599286684424%; left:49.886333148956%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-0.5em; left:-2.5em; width:6em;text-align:center;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;\"><a href=\"/wiki/Athletic_FC_Eskilstuna\" class=\"mw-redirect\" title=\"Athletic FC Eskilstuna\">Eskilstuna</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:77.723624673044%; left:10.583100217088%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative