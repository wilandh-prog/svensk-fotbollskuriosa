{"parse":{"title":"Damallsvenskan 2020","pageid":8461461,"text":"<div class=\"mw-content-ltr mw-parser-output\" lang=\"sv\" dir=\"ltr\"><style data-mw-deduplicate=\"TemplateStyles:r53696904\">.mw-parser-output .infobox{border:1px solid #aaa;background-color:#f9f9f9;color:black;margin:.5em 0 .5em 1em;padding:.2em;float:right;clear:right;width:22em;text-align:left;font-size:88%;line-height:1.6em}.mw-parser-output .infobox td,.mw-parser-output .infobox th{vertical-align:top;padding:0 .2em}.mw-parser-output .infobox caption{font-size:larger}.mw-parser-output .infobox.bordered{border-collapse:collapse}.mw-parser-output .infobox.bordered td,.mw-parser-output .infobox.bordered th{border:1px solid #aaa}.mw-parser-output .infobox.bordered .borderless td,.mw-parser-output .infobox.bordered .borderless th{border:0}.mw-parser-output .infobox-showbutton button,.mw-parser-output .infobox-showbutton .mw-collapsible-text{color:inherit}.mw-parser-output .infobox.bordered .mergedtoprow td,.mw-parser-output .infobox.bordered .mergedtoprow th{border:0;border-top:1px solid #aaa;border-right:1px solid #aaa}.mw-parser-output .infobox.bordered .mergedrow td,.mw-parser-output .infobox.bordered .mergedrow th{border:0;border-right:1px solid #aaa}.mw-parser-output .infobox.geography{border:1px solid #ccd2d9;text-align:left;border-collapse:collapse;line-height:1.2em;font-size:90%}.mw-parser-output .infobox.geography td,.mw-parser-output .infobox.geography th{border-top:solid 1px #ccd2d9;padding:0.4em 0.6em 0.4em 0.6em}.mw-parser-output .infobox.geography .mergedtoprow td,.mw-parser-output .infobox.geography .mergedtoprow th{border-top:solid 1px #ccd2d9;padding:0.4em 0.6em 0.2em 0.6em}.mw-parser-output .infobox.geography .mergedrow td,.mw-parser-output .infobox.geography .mergedrow th{border:0;padding:0 0.6em 0.2em 0.6em}.mw-parser-output .infobox.geography .mergedbottomrow td,.mw-parser-output .infobox.geography .mergedbottomrow th{border-top:0;border-bottom:solid 1px #ccd2d9;padding:0 0.6em 0.4em 0.6em}.mw-parser-output .infobox.geography .maptable td,.mw-parser-output .infobox.geography .maptable th{border:0;padding:0}</style><table class=\"infobox\" style=\"border-spacing:3px; width:30em;\"><caption class=\"\" style=\"font-size: 125%; font-weight: bold;\"><a href=\"/wiki/Damallsvenskan\" title=\"Damallsvenskan\">Damallsvenskan</a></caption><tbody><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><a href=\"/wiki/Fotbollss%C3%A4song\" title=\"Fotbollssäsong\">Säsong</a></th><td class=\"\" style=\"\">2020</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><span style=\"white-space:nowrap\">Nya lag för säsongen</span></th><td class=\"\" style=\"\"><a href=\"/wiki/IK_Uppsala_Fotboll\" title=\"IK Uppsala Fotboll\">IK Uppsala</a><br /><a href=\"/wiki/Ume%C3%A5_IK_FF\" title=\"Umeå IK FF\">Umeå IK</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Vinnare</th><td class=\"\" style=\"\"><a href=\"/wiki/Kopparbergs/G%C3%B6teborg_FC\" class=\"mw-redirect\" title=\"Kopparbergs/Göteborg FC\">Kopparbergs/Göteborg</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Nedflyttade</th><td class=\"\" style=\"\"><a href=\"/wiki/IK_Uppsala_Fotboll\" title=\"IK Uppsala Fotboll\">IK Uppsala</a><br /><a href=\"/wiki/Ume%C3%A5_IK_FF\" title=\"Umeå IK FF\">Umeå IK</a></td></tr><tr><th colspan=\"2\" style=\"text-align:center;background-color:#f0f1f2;\">Statistik</th></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Spelade&#160;matcher</th><td class=\"\" style=\"\">132</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Totalt&#160;antal&#160;mål</th><td class=\"\" style=\"\">383 (2,9 per match)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Bästa målgörare</th><td class=\"\" style=\"\"><a href=\"/wiki/Anna_Anveg%C3%A5rd\" title=\"Anna Anvegård\">Anna Anvegård</a> (16 mål)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;hemmavinst</th><td class=\"\" style=\"\"><div class=\"mw-collapsible mw-collapsed\" style=\"border:none;text-align:center;\"><div style=\"font-weight:bold;background-color:transparent;color:inherit;text-align:center;\">2 matcher</div>\n<div class=\"mw-collapsible-content\" style=\"font-weight:normal;background-color:transparent;color:inherit;text-align:left;\"><a href=\"/wiki/FC_Roseng%C3%A5rd_(damfotboll)\" title=\"FC Rosengård (damfotboll)\">FC Rosengård</a> 6–0 <a href=\"/wiki/KIF_%C3%96rebro_DFF\" title=\"KIF Örebro DFF\">KIF Örebro</a><br /><span style=\"font-size:smaller; line-height:130%\">(24 juli 2020)</span><br /><a href=\"/wiki/FC_Roseng%C3%A5rd_(damfotboll)\" title=\"FC Rosengård (damfotboll)\">Rosengård</a> 7–1 <a href=\"/wiki/Link%C3%B6pings_FC\" class=\"mw-redirect\" title=\"Linköpings FC\">Linköpings FC</a><br /><span style=\"font-size:smaller; line-height:130%\">(12 augusti 2020)</span></div></div></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;bortavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/IK_Uppsala_Fotboll\" title=\"IK Uppsala Fotboll\">IK Uppsala</a> 1–9 <a href=\"/wiki/FC_Roseng%C3%A5rd_(damfotboll)\" title=\"FC Rosengård (damfotboll)\">FC Rosengård</a><br /><span style=\"font-size:smaller; line-height:130%\">(7 augusti 2020)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Målrikaste match</th><td class=\"\" style=\"\"><a href=\"/wiki/IK_Uppsala_Fotboll\" title=\"IK Uppsala Fotboll\">IK Uppsala</a> 1–9 <a href=\"/wiki/FC_Roseng%C3%A5rd_(damfotboll)\" title=\"FC Rosengård (damfotboll)\">FC Rosengård</a><br /><span style=\"font-size:smaller; line-height:130%\">(7 augusti 2020</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest vunna matcher i rad</th><td class=\"\" style=\"\">9 matcher: <a href=\"/wiki/Kopparbergs/G%C3%B6teborg_FC\" class=\"mw-redirect\" title=\"Kopparbergs/Göteborg FC\">Kopparbergs/Göteborg FC</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest obesegrade matcher</th><td class=\"\" style=\"\">14 matcher: <a href=\"/wiki/FC_Roseng%C3%A5rd_(damfotboll)\" title=\"FC Rosengård (damfotboll)\">FC Rosengård</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest matcher utan vinst</th><td class=\"\" style=\"\">14 matcher: <a href=\"/wiki/IK_Uppsala_Fotboll\" title=\"IK Uppsala Fotboll\">IK Uppsala</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest förlorade i rad</th><td class=\"\" style=\"\">14 matcher: <a href=\"/wiki/IK_Uppsala_Fotboll\" title=\"IK Uppsala Fotboll\">IK Uppsala</a></td></tr><tr><td colspan=\"2\" style=\"text-align:center;\" class=\"\"><div style=\"float: left;\">&#8592; <a href=\"/wiki/Damallsvenskan_2019\" title=\"Damallsvenskan 2019\">2019</a> </div><div style=\"float: right;\"><a href=\"/wiki/Damallsvenskan_2021\" title=\"Damallsvenskan 2021\">2021</a> &#8594;</div></td></tr>\n</tbody></table>\n<div style=\"float:right;clear:right;width:344px;padding:4px;border:1px solid silver;margin:4px;background-color:white\">\n<div style=\"position:relative;border:1px solid silver;padding:0px;width:340px\"><span typeof=\"mw:File\"><a href=\"/wiki/Fil:Map_of_Sweden_(polar_stereographic).svg\" class=\"mw-file-description\"><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/56/Map_of_Sweden_%28polar_stereographic%29.svg/500px-Map_of_Sweden_%28polar_stereographic%29.svg.png\" decoding=\"async\" width=\"340\" height=\"822\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/56/Map_of_Sweden_%28polar_stereographic%29.svg/960px-Map_of_Sweden_%28polar_stereographic%29.svg.png 2x\" data-file-width=\"365\" data-file-height=\"882\" /></a></span><br />\n<div style=\"position:absolute;z-index:200;top:66.482714029987%; left:63.008073601264%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:-2px;\"><a href=\"/wiki/Djurg%C3%A5rdens_IF_Dam\" title=\"Djurgårdens IF Dam\">Djurgården</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:66.601570742829%; left:49.738010217983%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-3.0em; left:-2.5em; width:6em;text-align:center;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:9px;left:-10px;\"><a href=\"/wiki/Eskilstuna_United_DFF\" title=\"Eskilstuna United DFF\">Eskilstuna</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:92.177252896161%; left:19.207090220744%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/FC_Roseng%C3%A5rd_(damfotboll)\" title=\"FC Rosengård (damfotboll)\">Rosengård</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:63.18752779903%; left:58.891606557241%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-3.0em; left:-2.5em; width:6em;text-align:center;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:10px;left:-3px;\"><a href=\"/wiki/IK_Uppsala_Fotboll\" title=\"IK Uppsala Fotboll\">Uppsala</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:77.853891267825%; left:11.099113025813%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:8em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/Kopparbergs/G%C3%B6teborg_FC\" class=\"mw-redirect\" title=\"Kopparbergs/Göteborg FC\">Göteborg</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:67.422629104525%; left:39.149569060051%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:3px;left:0px;\"><a href=\"/wiki/KIF_%C3%96rebro_DFF\" title=\"KIF Örebro DFF\">Örebro</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:89.338666635689%; left:30.170922688238%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/Kristianstads_DFF\" title=\"Kristianstads DFF\">Kristianstad</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:73.212546919457%; left:42.889999567743%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:3px;left:-2px;\"><a href=\"/wiki/Link%C3%B6pings_FC\" class=\"mw-redirect\" title=\"Linköpings FC\">Linköping</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:83.547819079017%; left:35.716924200377%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:-2px;\"><a href=\"/wiki/V%C3%A4xj%C3%B6_DFF\" title=\"Växjö DFF\">Växjö</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:25.391979870023%; left:79.70515265499%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:2px;\"><a href=\"/wiki/Pite%C3%A5_IF_Dam\" title=\"Piteå IF Dam\">Piteå</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:35.750363915663%; left:74.012664346702%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:2px;\"><a href=\"/wiki/Ume%C3%A5_IK_FF\" title=\"Umeå IK FF\">Umeå</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:87.166900685071%; left:25.588940847071%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:2px;\"><a href=\"/wiki/Vittsj%C3%B6_GIK\" title=\"Vittsjö GIK\">Vittsjö</a></span></div>\n</div>\n</div>\n</div>\n<div style=\"font-size:90%\">Deltagande lag, Damallsvenskan 2020.</div>\n</div>\n<p><b>Damallsvenskan 2020</b> var <a href=\"/wiki/Sverige\" title=\"Sverige\">Sveriges</a> högsta division i fotboll för damer under säsongen 2020. Nya lag för säsongen var <a href=\"/wiki/IK_Uppsala_Fotboll\" title=\"IK Uppsala Fotboll\">IK Uppsala</a> och <a href=\"/wiki/Ume%C3%A5_IK_FF\" title=\"Umeå IK FF\">Umeå IK</a>, IK Uppsala gjorde debut i damallsvenskan medan Umeå IK återvände till damallsvenskan sedan nedflyttningen 2016.<sup id=\"cite&#95;ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup> Planerad spelstart för serien var 3 april,<sup id=\"cite&#95;ref-2\" class=\"reference\"><a href=\"#cite_note-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-:0&#95;3-0\" class=\"reference\"><a href=\"#cite_note-:0-3\"><span class=\"cite-bracket\">&#91;</span>3<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-:1&#95;4-0\" class=\"reference\"><a href=\"#cite_note-:1-4\"><span class=\"cite-bracket\">&#91;</span>4<span class=\"cite-bracket\">&#93;</span></a></sup> men på grund av <a href=\"/wiki/Coronaviruspandemin_2019%E2%80%932021\" class=\"mw-redirect\" title=\"Coronaviruspandemin 2019–2021\">coronapandemin</a> flyttades serien fram<sup id=\"cite&#95;ref-5\" class=\"reference\"><a href=\"#cite_note-5\"><span class=\"cite-bracket\">&#91;</span>5<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-:1&#95;4-1\" class=\"reference\"><a href=\"#cite_note-:1-4\"><span class=\"cite-bracket\">&#91;</span>4<span class=\"cite-bracket\">&#93;</span></a></sup> och premiärmatcherna spelades 27 juni och sista omgången spelas 15 november.<sup id=\"cite&#95;ref-6\" class=\"reference\"><a href=\"#cite_note-6\"><span class=\"cite-bracket\">&#91;</span>6<span class=\"cite-bracket\">&#93;</span></a></sup> Inledningen av serien spelades utan publik, men alla matcher sändes över Internet via <a href=\"/wiki/Aftonbladet\" title=\"Aftonbladet\">Aftonbladets</a> <a href=\"/wiki/Str%C3%B6mmande_media\" title=\"Strömmande media\">strömningstjänst</a> Sportbladet Play.<sup id=\"cite&#95;ref-:0&#95;3-1\" class=\"reference\"><a href=\"#cite_note-:0-3\"><span class=\"cite-bracket\">&#91;</span>3<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-7\" class=\"reference\"><a href=\"#cite_note-7\"><span class=\"cite-bracket\">&#91;</span>7<span class=\"cite-bracket\">&#93;</span></a></sup> <a href=\"/wiki/Sveriges_Television\" title=\"Sveriges Television\">SVT</a> visade ett urval matcher med start i augusti.<sup id=\"cite&#95;ref-8\" class=\"reference\"><a href=\"#cite_note-8\"><span class=\"cite-bracket\">&#91;</span>8<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Från och med denna säsong tilldelas Sverige 3 platser till <a href=\"/wiki/Uefa_Women%27s_Champions_League\" title=\"Uefa Women&#39;s Champions League\">Champions League</a> mot tidigare 2, som en del av det förändrade upplägget till turneringen 2021–2022.<sup id=\"cite&#95;ref-9\" class=\"reference\"><a href=\"#cite_note-9\"><span class=\"cite-bracket\">&#91;</span>9<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-10\" class=\"reference\"><a href=\"#cite_note-10\"><span class=\"cite-bracket\">&#91;</span>10<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Den 6 augusti hade <a href=\"/wiki/Svenska_fotbollsf%C3%B6rbundet\" class=\"mw-redirect\" title=\"Svenska fotbollsförbundet\">Svenska fotbollsförbundet</a> tillsammans med andra idrottsförbund möte med idrottsminister <a href=\"/wiki/Amanda_Lind\" title=\"Amanda Lind\">Amanda Lind</a> med syfte att hitta lösningar för att tillåta publik inom ramen för de rådande riktlinjerna från <a href=\"/wiki/Folkh%C3%A4lsomyndigheten\" title=\"Folkhälsomyndigheten\">Folkhälsomyndigheten</a> med anledning av pandemin.<sup id=\"cite&#95;ref-11\" class=\"reference\"><a href=\"#cite_note-11\"><span class=\"cite-bracket\">&#91;</span>11<span class=\"cite-bracket\">&#93;</span></a></sup> Detta ledde till att <a href=\"/wiki/Svenska_Fotbollf%C3%B6rbundet\" title=\"Svenska Fotbollförbundet\">SvFF</a> den 10 augusti ändrade sina rekommendationer till att tillåta upp till 50 besökare under en fotbollsmatch på särskilda villkor.<sup id=\"cite&#95;ref-12\" class=\"reference\"><a href=\"#cite_note-12\"><span class=\"cite-bracket\">&#91;</span>12<span class=\"cite-bracket\">&#93;</span></a></sup> Piteå och Örebro var först ut att släppa in publik i omgång 10 den 12 augusti, därefter följde fler lag efter, medan andra förhöll sig avvaktande eller negativa, bland annat Rosengård.<sup id=\"cite&#95;ref-13\" class=\"reference\"><a href=\"#cite_note-13\"><span class=\"cite-bracket\">&#91;</span>13<span class=\"cite-bracket\">&#93;</span></a></sup> Skepsisen berodde dock till stor del på grund av oklarheter, och efter förtydligande från SvFF så valde Rosengård att ompröva sin hållning<sup id=\"cite&#95;ref-14\" class=\"reference\"><a href=\"#cite_note-14\"><span class=\"cite-bracket\">&#91;</span>14<span class=\"cite-bracket\">&#93;</span></a></sup> och bestämde sig sedermera för att släppa in publik.<sup id=\"cite&#95;ref-15\" class=\"reference\"><a href=\"#cite_note-15\"><span class=\"cite-bracket\">&#91;</span>15<span class=\"cite-bracket\">&#93;</span></a></sup> Övriga lag gjorde samma sak, och från och med omgång 12 den 22 augusti tog alla lag emot publik. På grund av den låga gränsen släppte klubbarna i regel bara in hemmapublik.\n</p><p>Efter omgång 11 återgick matchtätheten till det normala med cirka en per vecka omkring helgen som tidigare säsonger. \n</p><p><a href=\"/wiki/Kopparbergs/G%C3%B6teborg_FC\" class=\"mw-redirect\" title=\"Kopparbergs/Göteborg FC\">Kopparbergs/Göteborg</a> blev svenska mästare medan nykomlingarna <a href=\"/wiki/IK_Uppsala_Fotboll\" title=\"IK Uppsala Fotboll\">IK Uppsala</a> och <a href=\"/wiki/Ume%C3%A5_IK_FF\" title=\"Umeå IK FF\">Umeå IK</a> åter blev nedflyttade till <a href=\"/wiki/Elitettan\" title=\"Elitettan\">Elitettan</a>.\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Lag_och_arenor\">Lag och arenor</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Damallsvenskan_2020&amp;veaction=edit&amp;section=1\" title=\"Redigera avsnitt: Lag och arenor\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Damallsvenskan_2020&amp;action=edit&amp;section=1\" title=\"Redigera avsnitts källkod: Lag och arenor\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable sortable\" style=\"text-align: left;\">\n<tbody><tr>\n<th>Lag\n</th>\n<th><a href=\"/wiki/Sveriges_l%C3%A4n\" title=\"Sveriges län\">Län</a>\n</th>\n<th>Ort\n</th>\n<th>Arena\n</th>\n<th>Underlag\n</th>\n<th>Kapacitet\n</th></tr>\n<tr>\n<td><a href=\"/wiki/Djurg%C3%A5rdens_IF_Dam\" title=\"Djurgårdens IF Dam\">Djurgårdens IF</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\"><img alt=\"Stockholms län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/20px-Stockholm_l%C3%A4n_vapen.svg.png\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/40px-Stockholm_l%C3%A4n_vapen.svg.png 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Stockholm\" title=\"Stockholm\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Stockholms_stadion\" title=\"Stockholms stadion\">Stockholms stadion</a>\n</td>\n<td>Gräs\n</td>\n<td align=\"center\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;014200.&amp;&amp;&amp;&amp;&amp;0</span>14&#160;200\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Eskilstuna_United_DFF\" title=\"Eskilstuna United DFF\">Eskilstuna United DFF</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/S%C3%B6dermanlands_l%C3%A4n\" title=\"Södermanlands län\"><img alt=\"Södermanlands län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/55/S%C3%B6dermanlands_vapen.svg/20px-S%C3%B6dermanlands_vapen.svg.png\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/55/S%C3%B6dermanlands_vapen.svg/40px-S%C3%B6dermanlands_vapen.svg.png 2x\" data-file-width=\"248\" data-file-height=\"300\" /></a></span>&#160;</span><a href=\"/wiki/S%C3%B6dermanlands_l%C3%A4n\" title=\"Södermanlands län\">Södermanland</a>\n</td>\n<td><a href=\"/wiki/Eskilstuna\" title=\"Eskilstuna\">Eskilstuna</a>\n</td>\n<td><a href=\"/wiki/Tunavallen\" title=\"Tunavallen\">Tunavallen</a>\n</td>\n<td>Konstgräs\n</td>\n<td align=\"center\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;07220.&amp;&amp;&amp;&amp;&amp;0</span>7&#160;220\n</td></tr>\n<tr>\n<td><a href=\"/wiki/FC_Roseng%C3%A5rd_(damfotboll)\" title=\"FC Rosengård (damfotboll)\">FC Rosengård</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/Sk%C3%A5ne_l%C3%A4n\" title=\"Skåne län\"><img alt=\"Skåne län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/e/e0/Sk%C3%A5ne_l%C3%A4n_vapen.svg/20px-Sk%C3%A5ne_l%C3%A4n_vapen.svg.png\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/e/e0/Sk%C3%A5ne_l%C3%A4n_vapen.svg/40px-Sk%C3%A5ne_l%C3%A4n_vapen.svg.png 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/Sk%C3%A5ne_l%C3%A4n\" title=\"Skåne län\">Skåne</a>\n</td>\n<td><a href=\"/wiki/Malm%C3%B6\" title=\"Malmö\">Malmö</a>\n</td>\n<td><a href=\"/wiki/Malm%C3%B6_IP\" title=\"Malmö IP\">Malmö IP</a>\n</td>\n<td>Konstgräs\n</td>\n<td align=\"center\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;07600.&amp;&amp;&amp;&amp;&amp;0</span>7&#160;600\n</td></tr>\n<tr>\n<td><a href=\"/wiki/KIF_%C3%96rebro_DFF\" title=\"KIF Örebro DFF\">KIF Örebro</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/%C3%96rebro_l%C3%A4n\" title=\"Örebro län\"><img alt=\"Örebro län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/3/31/%C3%96rebro_l%C3%A4n_vapen.svg/20px-%C3%96rebro_l%C3%A4n_vapen.svg.png\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/3/31/%C3%96rebro_l%C3%A4n_vapen.svg/40px-%C3%96rebro_l%C3%A4n_vapen.svg.png 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/%C3%96rebro_l%C3%A4n\" title=\"Örebro län\">Örebro</a>\n</td>\n<td><a href=\"/wiki/%C3%96rebro\" title=\"Örebro\">Örebro</a>\n</td>\n<td><a href=\"/wiki/Behrn_Arena_(fotbollsanl%C3%A4ggning)\" title=\"Behrn Arena (fotbollsanläggning)\">Behrn Arena</a>\n</td>\n<td>Konstgräs\n</td>\n<td align=\"center\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;012645.&amp;&amp;&amp;&amp;&amp;0</span>12&#160;645\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Kopparbergs/G%C3%B6teborg_FC\" class=\"mw-redirect\" titl