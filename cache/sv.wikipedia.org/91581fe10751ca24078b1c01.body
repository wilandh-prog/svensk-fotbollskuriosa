:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-0.5em; left:-2.5em; width:6em;text-align:center;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:3px;left:16px;\"><a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:69.1%; left:46.2%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Öster</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:3.3%; left:71.1%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/Gefle_IF_Fotboll\" title=\"Gefle IF Fotboll\">Gefle</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:72.5%; left:26.1%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;\"><a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstad</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:91.6%; left:27.4%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö</a></span></div>\n</div>\n</div>\n</div>\n<div style=\"font-size:90%\">Placering av deltagande lag, allsvenskan 2006.</div>\n</div>\n<p><b>Fotbollsallsvenskan 2006</b> vanns av <a href=\"/wiki/IF_Elfsborg\" title=\"IF Elfsborg\">IF Elfsborg</a> från <a href=\"/wiki/Bor%C3%A5s\" title=\"Borås\">Borås</a>. Vårsäsongen spelades 1 april–15 maj <a href=\"/wiki/Sport%C3%A5ret_2006#Fotboll\" title=\"Sportåret 2006\">2006</a> och höstsäsongen spelades 15 juli–5 november <a href=\"/wiki/Sport%C3%A5ret_2006#Fotboll\" title=\"Sportåret 2006\">2006</a>. Serien avgjordes i 26:e och sista omgången då <a href=\"/wiki/IF_Elfsborg\" title=\"IF Elfsborg\">IF Elfsborg</a> vann hemmamatchen mot <a href=\"/wiki/Djurg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgårdens IF</a> med 1–0, vilket var allt som krävdes för att vinna guld, då man sedan tidigare låg en poäng före <a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a> i tabellen.\n</p><p>Av de 14 lagen i Fotbollsallsvenskan 2006 kom fyra från <a href=\"/wiki/G%C3%B6teborg\" title=\"Göteborg\">Göteborg</a> och tre från <a href=\"/wiki/Stockholm\" title=\"Stockholm\">Stockholm</a> och bara ett lag kommer från ort norr om Stockholms län.\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Tabeller\">Tabeller</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2006&amp;veaction=edit&amp;section=1\" title=\"Redigera avsnitt: Tabeller\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2006&amp;action=edit&amp;section=1\" title=\"Redigera avsnitts källkod: Tabeller\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable infobox\" style=\"font-size:0.8em;\">\n\n<tbody><tr>\n<td rowspan=\"3\" style=\"background-color:#ffec8b;\">&#8195;\n</td>\n<td>Svenska mästare\n</td></tr>\n<tr>\n<td>Kvalificerad för kval till <a href=\"/wiki/Uefa_Champions_League_2007/2008\" title=\"Uefa Champions League 2007/2008\">Champions League 2007/2008</a>\n</td></tr>\n<tr>\n<td>Kvalificerad för <a href=\"/wiki/Royal_League_2006/2007\" title=\"Royal League 2006/2007\">Royal League 2006/2007</a>\n</td></tr>\n<tr>\n<td rowspan=\"2\" style=\"background-color:#d7e6f5;\">&#8195;\n</td>\n<td>Kvalificerad för kval till <a href=\"/wiki/Uefacupen_2007/2008\" title=\"Uefacupen 2007/2008\">Uefacupen 2007/2008</a>\n</td></tr>\n<tr>\n<td>Kvalificerad för <a href=\"/wiki/Royal_League_2006/2007\" title=\"Royal League 2006/2007\">Royal League 2006/2007</a>\n</td></tr>\n<tr>\n<td rowspan=\"2\" style=\"background-color:#e2ecea;\">&#8195;\n</td></tr>\n<tr>\n<td>Kvalificerad för <a href=\"/wiki/Intertotocupen_2007\" title=\"Intertotocupen 2007\">Intertotocupen 2007</a>\n</td></tr>\n<tr>\n<td style=\"background-color:#f4dcdc;\">&#8195;</td>\n<td><a href=\"/w/index.php?title=Kvalspelet_till_Fotbollsallsvenskan_2007&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Kvalspelet till Fotbollsallsvenskan 2007 [inte skriven än]\">Kvalspel</a> om <a href=\"/wiki/Fotbollsallsvenskan_2007\" title=\"Fotbollsallsvenskan 2007\">Allsvenskan 2007</a>\n</td></tr>\n<tr>\n<td style=\"background-color:#f0c4c4;\">&#8195;</td>\n<td>Nedflyttad till <a href=\"/wiki/Superettan_2007\" title=\"Superettan 2007\">Superettan 2007</a>\n</td></tr>\n</tbody></table>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Poängtabell\"><span id=\"Po.C3.A4ngtabell\"></span>Poängtabell</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2006&amp;veaction=edit&amp;section=2\" title=\"Redigera avsnitt: Poängtabell\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2006&amp;action=edit&amp;section=2\" title=\"Redigera avsnitts källkod: Poängtabell\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>Tabellen nedan är hämtad från Svenska Fotbollförbundets hemsida.<sup id=\"cite&#95;ref-4\" class=\"reference\"><a href=\"#cite_note-4\"><span class=\"cite-bracket\">&#91;</span>4<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>&#160;<span class=\"noprint plainlinks\" style=\"white-space:nowrap; font-weight:normal; font-size:80%; ;\">Denna tabell:&#160;<a href=\"/wiki/Mall:Po%C3%A4ngtabell_f%C3%B6r_Fotbollsallsvenskan_2006\" title=\"Mall:Poängtabell för Fotbollsallsvenskan 2006\"><span title=\"Visa denna mall\" style=\";\">visa</span></a>&#160;<span style=\"font-size:80%;\">•</span>&#160;<a class=\"external text\" data-mw-original-href=\"//sv.wikipedia.org/w/index.php?title=Mall:Po%C3%A4ngtabell_f%C3%B6r_Fotbollsallsvenskan_2006&amp;action=edit\" href=\"https://sv.wikipedia.org/w/index.php?title=Mall:Po%C3%A4ngtabell_f%C3%B6r_Fotbollsallsvenskan_2006&amp;action=edit\"><span style=\";\" title=\"Redigera den här mallen\">redigera</span></a></span>&#160;\n</p>\n<table class=\"wikitable sortable\" style=\"font-size:0.9375em;line-height:1.4em;text-align:center;background:white;margin-top:0.1em;\">\n<tbody><tr><th style=\"width:1.8em;\"> <span style=\"cursor:help;\" title=\"Placering\">Nr</span> </th>\n<th style=\"width: 13em;\"> Lag </th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Spelade matcher\">S</span></th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Vinster\">V</span>        </th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Oavgjorda\">O</span>      </th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Förluster\">F</span>      </th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Gjorda mål\">GM</span>    </th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Insläppta mål\">IM</span> </th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Målskillnad\">MS</span>   </th>\n<th style=\"width: 2em;\"> <span style=\"cursor:help; border-bottom:1px dotted;\" title=\"Poäng\">P</span>          </th>\n</tr>\n<tr style=\"background:#ffec8b; border-bottom:2px solid grey;\"> <td>1</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/IF_Elfsborg\" title=\"IF Elfsborg\">IF Elfsborg</a>                                </td>\n<td>26</td>\n<td>13</td>\n<td> 11</td>\n<td>  2</td>\n<td> 41</td>\n<td> 19</td>\n<td>+22</td>\n<td style=\"font-weight:bold;\">50</td>\n</tr>\n<tr style=\"background:#d7e6f5; border-bottom:2px solid grey;\"> <td>2</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a> <span style=\"cursor:help;color:dimgrey;font-size:0.8em;font-weight:bold;\" title=\"Uppflyttad från föregående säsong\">(U)</span>                    </td>\n<td>26</td>\n<td>13</td>\n<td> 10</td>\n<td>  3</td>\n<td> 46</td>\n<td> 23</td>\n<td>+23</td>\n<td style=\"font-weight:bold;\">49</td>\n</tr><tr style=\"background:#e2ecea; border-bottom:2px solid grey;\"> <td>3</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby IF</a><sup>1</sup></td>\n<td>26</td>\n<td>13</td>\n<td>  7</td>\n<td>  6</td>\n<td> 40</td>\n<td> 31</td>\n<td>+9</td>\n<td style=\"font-weight:bold;\">43</td>\n</tr><tr style=\"background:#d7e6f5; border-bottom:2px solid gray;\"> <td>4</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Helsingborgs_IF\" title=\"Helsingborgs IF\">Helsingborgs IF</a> <sup>SC</sup>              </td>\n<td>26</td>\n<td>11</td>\n<td>  9</td>\n<td>  6</td>\n<td> 44</td>\n<td> 34</td>\n<td>+10</td>\n<td style=\"font-weight:bold;\">42</td>\n</tr><tr style=\"background:white;\"> <td>5</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Kalmar_FF\" title=\"Kalmar FF\">Kalmar FF</a>                                  </td>\n<td>26</td>\n<td>12</td>\n<td>  5</td>\n<td>  9</td>\n<td> 39</td>\n<td> 30</td>\n<td>+9</td>\n<td style=\"font-weight:bold;\">41</td>\n</tr><tr style=\"background:white;\"> <td>6</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Djurg%C3%A5rdens_IF\" title=\"Djurgårdens IF\">Djurgårdens IF</a> <span style=\"cursor:help;color:dimgrey;font-size:0.8em;font-weight:bold;\" title=\"Regerande mästare\">(RM)</span>                   </td>\n<td>26</td>\n<td>11</td>\n<td>  7</td>\n<td>  8</td>\n<td> 31</td>\n<td> 25</td>\n<td>+6</td>\n<td style=\"font-weight:bold;\">40</td>\n</tr><tr style=\"background:white;\"> <td>7</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö FF</a>                                   </td>\n<td>26</td>\n<td>10</td>\n<td>  8</td>\n<td>  8</td>\n<td> 43</td>\n<td> 39</td>\n<td>+4</td>\n<td style=\"font-weight:bold;\">38</td>\n</tr><tr style=\"background:white;\"> <td>8</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/IFK_G%C3%B6teborg\" title=\"IFK Göteborg\">IFK Göteborg</a>                               </td>\n<td>26</td>\n<td> 9</td>\n<td>  9</td>\n<td>  8</td>\n<td> 39</td>\n<td> 36</td>\n<td>+3</td>\n<td style=\"font-weight:bold;\">36</td>\n</tr><tr style=\"background:white;\"> <td>9</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Gefle_IF_Fotboll\" title=\"Gefle IF Fotboll\">Gefle IF</a>                  </td>\n<td>26</td>\n<td> 8</td>\n<td>  7</td>\n<td> 11</td>\n<td> 28</td>\n<td> 39</td>\n<td>−11</td>\n<td style=\"font-weight:bold;\">31</td>\n</tr><tr style=\"background:white;\"> <td>10</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Gais\" title=\"Gais\">Gais</a> <span style=\"cursor:help;color:dimgrey;font-size:0.8em;font-weight:bold;\" title=\"Uppflyttad från föregående säsong\">(U)</span>                               </td>\n<td>26</td>\n<td> 5</td>\n<td> 12</td>\n<td>  9</td>\n<td> 25</td>\n<td> 33</td>\n<td>−8</td>\n<td style=\"font-weight:bold;\">27</td>\n</tr><tr style=\"background:white; border-bottom:2px solid red;\"> <td>11</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstads BK</a>                               </td>\n<td>26</td>\n<td> 5</td>\n<td> 12</td>\n<td>  9</td>\n<td> 22</td>\n<td> 30</td>\n<td>−8</td>\n<td style=\"font-weight:bold;\">27</td>\n</tr><tr style=\"background:#f4dcdc; border-bottom:2px solid red;\"> <td>12</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/BK_H%C3%A4cken\" title=\"BK Häcken\">BK Häcken</a> <span typeof=\"mw:File\"><span title=\"Nedflyttad efter kvalspel\"><img alt=\"Nedflyttad efter kvalspel\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/04/Red_Arrow_Down.svg/20px-Red_Arrow_Down.svg.png\" decoding=\"async\" width=\"10\" height=\"10\" class=\"mw-file-element\" data-file-width=\"700\" data-file-height=\"700\" /></span></span>                        </td>\n<td>26</td>\n<td> 4</td>\n<td> 10</td>\n<td> 12</td>\n<td> 29</td>\n<td> 41</td>\n<td>−12</td>\n<td style=\"font-weight:bold;\">22</td>\n</tr><tr style=\"background:#f0c4c4;\"> <td>13</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Östers IF</a> <span style=\"cursor:help;color:dimgrey;font-size:0.8em;font-weight:bold;\" title=\"Uppflyttad från föregående säsong\">(U)</span>                          </td>\n<td>26</td>\n<td> 4</td>\n<td>  7</td>\n<td> 15</td>\n<td> 19</td>\n<td> 46</td>\n<td>−27</td>\n<td style=\"font-weight:bold;\">19</td>\n</tr><tr style=\"background:#f0c4c4;\"> <td>14</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/%C3%96rgryte_IS\" title=\"Örgryte IS\">Örgryte IS</a>                                 </td>\n<td>26</td>\n<td> 3</td>\n<td>  8</td>\n<td> 15</td>\n<td> 24</td>\n<td> 44</td>\n<td>−20</td>\n<td style=\"font-weight:bold;\">17</td>\n</tr></tbody></table>\n<ul><li><sup>1</sup> Hammarby bestraffades med tre poängs avdrag efter en match mot Djurgården på <a href=\"/wiki/S%C3%B6derstadion\" title=\"Söderstadion\">Söderstadion</a>, se <a href=\"#Hammarby_IF_–_Djurgårdens_IF\">avsnittet nedan</a>.<sup id=\"cite&#95;ref-tu-beslut-2006-09-02&#95;5-0\" class=\"reference\"><a href=\"#cite_note-tu-beslut-2006-09-02-5\"><span class=\"cite-bracket\">&#91;</span>5<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><sup>SC</sup> Helsingborgs IF kvalificerade sig för <a href=\"/wiki/Uefacupen_2007/2008\" title=\"Uefacupen 2007/2008\">Uefacupen 2007/2008</a> genom seger av <a href=\"/wiki/Svenska_cupen_i_fotboll_2006\" title=\"Svenska cupen i fotboll 2006\">Svenska cupen 2006</a></li></ul>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Resultattabell\">Resultattabell</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2006&amp;veaction=edit&amp;section=3\" title=\"Redigera avsnitt: Resultattabell\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_2006&amp;action=edit&amp;section=3\" title=\"Redigera avsnitts källkod: Resultattabell\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>&#160;<span class=\"noprint plainlinks\" style=\"white-space:nowrap; font-weight:normal; font-size:80%; ;\">Denna tabell:&#160;<a href=\"/wiki/Mall:Resultattabell_f%C3%B6r_Fotbollsallsvenskan_2006\" title=\"Mall:Resultattabell för Fotbollsallsvenskan 2006\"><span title=\"Visa denna mall\" style=\";\">visa</span></a>&#160;<span style=\"font-size:80%;\">•</span>&#160;<a class=\"external text\" data-mw-original-href=\"//sv.wikipedia.org/w/index.php?title=Mall:Resultattabell_f%C3%B6r_Fotbollsallsvenskan_2006&amp;action=edit\" href=\"https://sv.wikipedia.org/w/index.php?title=Mall:Resultattabell_f%C3%B6r_Fotbollsallsvenskan_2006&amp;action=edit\"><span style=\";\" title=\"Redigera den här mallen\">redigera</span></a></span>&#160;\n</p>\n<table class=\