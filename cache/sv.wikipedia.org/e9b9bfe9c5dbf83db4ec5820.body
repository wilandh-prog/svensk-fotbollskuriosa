0.6em}.mw-parser-output .infobox.geography .maptable td,.mw-parser-output .infobox.geography .maptable th{border:0;padding:0}</style><table class=\"infobox\" style=\"border-spacing:3px; width:30em;\"><caption class=\"\" style=\"font-size: 125%; font-weight: bold;\"><a href=\"/wiki/Superettan\" title=\"Superettan\">Superettan</a></caption><tbody><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Datum</th><td class=\"\" style=\"\">29 mars–8 november 2025</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><span style=\"white-space:nowrap\">Nya lag för säsongen</span></th><td class=\"\" style=\"\"><div class=\"mw-collapsible mw-collapsed\" style=\"border:none;text-align:center;\"><div style=\"font-weight:bold;background-color:transparent;color:inherit;text-align:center;\">4 lag</div>\n<div class=\"mw-collapsible-content\" style=\"font-weight:normal;background-color:transparent;color:inherit;text-align:left;\"><a href=\"/wiki/Falkenbergs_FF\" title=\"Falkenbergs FF\">Falkenbergs FF</a><br /><a href=\"/wiki/Kalmar_FF\" title=\"Kalmar FF\">Kalmar FF</a><br /><a href=\"/wiki/Ume%C3%A5_FC\" title=\"Umeå FC\">Umeå FC</a><br /><a href=\"/wiki/V%C3%A4ster%C3%A5s_SK_FK\" title=\"Västerås SK FK\">Västerås SK</a></div></div></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Vinnare</th><td class=\"\" style=\"\"><a href=\"/wiki/V%C3%A4ster%C3%A5s_SK_FK\" title=\"Västerås SK FK\">Västerås SK</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Uppflyttade</th><td class=\"\" style=\"\"><a href=\"/wiki/V%C3%A4ster%C3%A5s_SK_FK\" title=\"Västerås SK FK\">Västerås SK</a><br /><a href=\"/wiki/Kalmar_FF\" title=\"Kalmar FF\">Kalmar FF</a><br /><a href=\"/wiki/%C3%96rgryte_IS\" title=\"Örgryte IS\">Örgryte IS</a> <span style=\"font-size:smaller; line-height:130%\">(efter <a href=\"#Allsvenskan_2026\">kval</a>)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Nedflyttade</th><td class=\"\" style=\"\"><a href=\"/wiki/Trelleborgs_FF\" title=\"Trelleborgs FF\">Trelleborgs FF</a><br /><a href=\"/wiki/Ume%C3%A5_FC\" title=\"Umeå FC\">Umeå FC</a><br /><a href=\"/wiki/Utsiktens_BK\" title=\"Utsiktens BK\">Utsiktens BK</a> <span style=\"font-size:smaller; line-height:130%\">(efter <a href=\"#Superettan_2026\">kval</a>)</span></td></tr><tr><th colspan=\"2\" style=\"text-align:center;background-color:#f0f1f2;\">Statistik</th></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Spelade&#160;matcher</th><td class=\"\" style=\"\">240</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Totalt&#160;antal&#160;mål</th><td class=\"\" style=\"\">686 (2,9 per match)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Bästa målgörare</th><td class=\"\" style=\"\"><a href=\"/wiki/Amar_Muhsin\" title=\"Amar Muhsin\">Amar Muhsin</a> (21 mål)<sup id=\"cite&#95;ref-statistik&#95;1-0\" class=\"reference\"><a href=\"#cite_note-statistik-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;hemmavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/%C3%96rgryte_IS\" title=\"Örgryte IS\">Örgryte</a> 6–0 <a href=\"/wiki/%C3%96stersunds_FK\" title=\"Östersunds FK\">Östersund</a><br /><span style=\"font-size:smaller; line-height:130%\">(27 juli 2025)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;bortavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/%C3%96stersunds_FK\" title=\"Östersunds FK\">Östersund</a> 1–6 <a href=\"/wiki/V%C3%A4ster%C3%A5s_SK_FK\" title=\"Västerås SK FK\">Västerås</a><br /><span style=\"font-size:smaller; line-height:130%\">(4 oktober 2025)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Målrikaste match</th><td class=\"\" style=\"\"><a href=\"/wiki/IK_Brage\" title=\"IK Brage\">Brage</a> 4–5 <a href=\"/wiki/%C3%96rebro_SK_Fotboll\" title=\"Örebro SK Fotboll\">Örebro</a><br /><span style=\"font-size:smaller; line-height:130%\">(20 september 2025)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Högsta&#160;åskådarantal</th><td class=\"\" style=\"\">11&#160;592. <a href=\"/wiki/Helsingborgs_IF\" title=\"Helsingborgs IF\">Helsingborg</a> 0–0 <a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona</a><br /><span style=\"font-size:smaller; line-height:130%\">(16 september 2025)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Lägsta&#160;åskådarantal</th><td class=\"\" style=\"\">111. <a href=\"/wiki/Utsiktens_BK\" title=\"Utsiktens BK\">Utsikten</a> 1–4 <a href=\"/wiki/Ume%C3%A5_FC\" title=\"Umeå FC\">Umeå</a><br /><span style=\"font-size:smaller; line-height:130%\">(8 november 2025)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Totalt åskådarantal</th><td class=\"\" style=\"\">656&#160;026<sup id=\"cite&#95;ref-publik&#95;2-0\" class=\"reference\"><a href=\"#cite_note-publik-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Åskådarantal i snitt</th><td class=\"\" style=\"\">2&#160;733<sup id=\"cite&#95;ref-publik&#95;2-1\" class=\"reference\"><a href=\"#cite_note-publik-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup></td></tr><tr><td colspan=\"2\" style=\"text-align:center;\" class=\"\"><div style=\"float: left;\">&#8592; <a href=\"/wiki/Superettan_2024\" title=\"Superettan 2024\">2024</a> </d