td>36</td>\n<td>−9</td>\n<td style=\"font-weight:bold;\">28</td>\n</tr><tr style=\"background:white; border-bottom:2px solid red;\"> <td>10</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/Trelleborgs_FF\" title=\"Trelleborgs FF\">Trelleborgs FF</a>                               </td>\n<td>26</td>\n<td>8</td>\n<td>4</td>\n<td>14</td>\n<td>32</td>\n<td>48</td>\n<td>−16</td>\n<td style=\"font-weight:bold;\">28</td>\n</tr><tr style=\"background:#f4dcdc;\"> <td>11</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Östers IF</a> <span typeof=\"mw:File\"><span title=\"Kvar i ligan efter kvalspel\"><img alt=\"Kvar i ligan efter kvalspel\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/fe/Dark_Green_Arrow_Down.svg/20px-Dark_Green_Arrow_Down.svg.png\" decoding=\"async\" width=\"10\" height=\"10\" class=\"mw-file-element\" data-file-width=\"700\" data-file-height=\"700\" /></span></span>                          </td>\n<td>26</td>\n<td>4</td>\n<td>11</td>\n<td>11</td>\n<td>28</td>\n<td>44</td>\n<td>−16</td>\n<td style=\"font-weight:bold;\">23</td>\n</tr><tr style=\"background:#f4dcdc; border-bottom:2px solid red;\"> <td>12</td>\n<td style=\"text-align:left;\"><a href=\"/wiki/V%C3%A4ster%C3%A5s_SK_FK\" title=\"Västerås SK FK\">Västerås SK</a> <span style=\"cursor:help;color:dimgrey;font-size:0.8em;font-weight:bold;\" title=\"Uppflyttad från föregående säsong\">(U)</span> <span typeof=\"mw:File\"><span title=\"Nedflyttad efter kvalspel\"><img alt=\"Nedflyttad efter kvalspel\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/04/Red_Arrow_Down.svg/20px-Red_Arrow_Down.svg.png\" decoding=\"async\" width=\"10\" height=\"10\" class=\"mw-file-element\" data-file-width=\"700\" data-file-height=\"700\" /></span></span> </td>\n<td>26</td>\n<td>6</td>\n<td>5</td>\n<td>15</td>\n<td>26</td>\n<td>49</td>\n<td>−23</td>\n<td style=\"font-weight:bold;\">23</td>\n</tr><tr style=\"background:#f0c4c4;\"> <td>13</td>\n<td style=\"text-align:l