0.6em}.mw-parser-output .infobox.geography .maptable td,.mw-parser-output .infobox.geography .maptable th{border:0;padding:0}</style><table class=\"infobox\" style=\"border-spacing:3px; width:30em;\"><caption class=\"\" style=\"font-size: 125%; font-weight: bold;\"><span class=\"flaggbild\" title=\"Sverige\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"Sverige\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/4/4c/Flag_of_Sweden.svg/40px-Flag_of_Sweden.svg.png\" decoding=\"async\" width=\"22\" height=\"14\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/4/4c/Flag_of_Sweden.svg/60px-Flag_of_Sweden.svg.png 2x\" data-file-width=\"1600\" data-file-height=\"1000\" /></span></span></span> <a href=\"/wiki/Superettan\" title=\"Superettan\">Superettan</a></caption><tbody><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><a href=\"/wiki/Fotbollss%C3%A4song\" title=\"Fotbollssäsong\">Säsong</a></th><td class=\"\" style=\"\"><a href=\"/wiki/Sport%C3%A5ret_2018\" title=\"Sportåret 2018\">2018</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><span style=\"white-space:nowrap\">Nya lag för säsongen</span></th><td class=\"\" style=\"\"><a href=\"/wiki/AFC_Eskilstuna\" title=\"AFC Eskilstuna\">AFC Eskilstuna</a><br /><a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstads BK</a><br /><a href=\"/wiki/IK_Brage\" title=\"IK Brage\">IK Brage</a><br /><a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköpings Södra</a><br /><a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona BoIS</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Uppflyttade</th><td class=\"\" style=\"\"><a href=\"/wiki/Helsingborgs_IF\" title=\"Helsingborgs IF\">Helsingborgs IF</a><br /><a href=\"/wiki/Falkenbergs_FF\" title=\"Falkenbergs FF\">Falkenbergs FF</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Nedflyttade</th><td class=\"\" style=\"\"><a href=\"/wiki/Gefle_IF\" title=\"Gefle IF\">Gefle IF</a><br /><a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona BoIS</a><br /><a href=\"/wiki/IFK_V%C3%A4rnamo\" title=\"IFK Värnamo\">IFK Värnamo</a> (via kval)</td></tr><tr><td colspan=\"2\" style=\"text-align:center;\" class=\"\"><div style=\"float: left;\">&#8592; <a href=\"/wiki/Superettan_2017\" title=\"Superettan 2017\">2017</a> </div><div style=\"float: right;\"><a href=\"/wiki/Superettan_2019\" title=\"Superettan 2019\">2019</a> &#8594;</div></td></tr>\n</tbody></table>\n<p><b>Superettan 2018</b> var den 19:e säsongen av <a href=\"/wiki/Superettan\" title=\"Superettan\">Superettan</a>, Sveriges näst högsta <a href=\"/wiki/Division_(sport)\" title=\"Division (sport)\">division</a> i <a href=\"/wiki/Fotboll\" title=\"Fotboll\">fotboll</a> för herrar, under <a href=\"/wiki/Allsvenskan_(fotboll)\" title=\"Allsvenskan (fotboll)\">Allsvenskan</a>.\n</p>\n<div style=\"float:right;clear:right;width:354px;padding:4px;border:1px solid silver;margin:4px;background-color:white\">\n<div style=\"position:relative;border:1px solid silver;padding:0px;width:350px\"><span typeof=\"mw:File\"><a href=\"/wiki/Fil:Sweden_location_map,_40south.svg\" class=\"mw-file-description\"><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/b/ba/Sweden_location_map%2C_40south.svg/500px-Sweden_location_map%2C_40south.svg.png\" decoding=\"async\" width=\"350\" height=\"404\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/b/ba/Sweden_location_map%2C_40south.svg/960px-Sweden_location_map%2C_40south.svg.png 2x\" data-file-width=\"636\" data-file-height=\"735\" /></a></span><br />\n<div style=\"position:absolute;z-index:200;top:25.9%; left:64.6%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-0.5em; left:-2.5em; width:6em;text-align:center;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;\"><a href=\"/wiki/AFC_Eskilstuna\" title=\"AFC Eskilstuna\">Eskilstuna</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:28.2%; left:42.6%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;\"><a href=\"/wiki/Degerfors_IF\" title=\"Degerfors IF\">Degerfors</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:68.8%; left:22.3%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right