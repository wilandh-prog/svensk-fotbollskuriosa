0.6em}.mw-parser-output .infobox.geography .maptable td,.mw-parser-output .infobox.geography .maptable th{border:0;padding:0}</style><table class=\"infobox\" style=\"border-spacing:3px; width:30em;\"><caption class=\"\" style=\"font-size: 125%; font-weight: bold;\"><a href=\"/wiki/Superettan\" title=\"Superettan\">Superettan</a></caption><tbody><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><a href=\"/wiki/Fotbollss%C3%A4song\" title=\"Fotbollssäsong\">Säsong</a></th><td class=\"\" style=\"\"><a href=\"/wiki/Sport%C3%A5ret_2020\" title=\"Sportåret 2020\">2020</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><span style=\"white-space:nowrap\">Nya lag för säsongen</span></th><td class=\"\" style=\"\"><a href=\"/wiki/Athletic_FC_Eskilstuna\" class=\"mw-redirect\" title=\"Athletic FC Eskilstuna\">AFC Eskilstuna</a><br /><a href=\"/wiki/Akropolis_IF\" title=\"Akropolis IF\">Akropolis IF</a><br /><a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">GIF Sundsvall</a><br /><a href=\"/wiki/Ljungskile_SK\" title=\"Ljungskile SK\">Ljungskile SK</a><br /><a href=\"/wiki/Ume%C3%A5_FC\" title=\"Umeå FC\">Umeå FC</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Vinnare</th><td class=\"\" style=\"\"><a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstads BK</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Uppflyttade</th><td class=\"\" style=\"\"><a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstads BK</a><br /><a href=\"/wiki/Degerfors_IF\" title=\"Degerfors IF\">Degerfors IF</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Nedflyttade</th><td class=\"\" style=\"\"><a href=\"/wiki/Dalkurd_FF\" title=\"Dalkurd FF\">Dalkurd FF</a><br /><a href=\"/wiki/Ljungskile_SK\" title=\"Ljungskile SK\">Ljungskile SK</a><br /><a href=\"/wiki/Ume%C3%A5_FC\" title=\"Umeå FC\">Umeå FC</a></td></tr><tr><th colspan=\"2\" style=\"text-align:center;background-color:#f0f1f2;\">Statistik</th></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Spelade&#160;matcher</th><td class=\"\" style=\"\">240</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Totalt&#160;antal&#160;mål</th><td class=\"\" style=\"\">647 (2,7 per match)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Bästa målgörare</th><td class=\"\" style=\"\"><a href=\"/wiki/Pontus_Engblom\" title=\"Pontus Engblom\">Pontus Engblom</a>, <a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">Sundsvall</a>, 20 mål</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;hemmavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/Norrby_IF\" title=\"Norrby IF\">Norrby</a> 6–0 <a href=\"/wiki/Ume%C3%A5_FC\" title=\"Umeå FC\">Umeå</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;bortavinst</th><td class=\"\" style=\"\"><div class=\"mw-collapsible mw-collapsed\" style=\"border:none;text-align:center;\"><div style=\"font-weight:bold;background-color:transparent;color:inherit;text-align:center;\">5 mål i 2 matcher</div>\n<div class=\"mw-collapsible-content\" style=\"font-weight:normal;background-color:transparent;color:inherit;text-align:left;\"><a href=\"/wiki/Ume%C3%A5_FC\" title=\"Umeå FC\">Umeå</a> 0–5 <a href=\"/wiki/Degerfors_IF\" title=\"Degerfors IF\">Degerfors</a><br /><a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">Sundsvall</a> 0–5 <a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstad</a></div></div></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Högsta&#160;åskådarantal</th><td class=\"\" style=\"\"><div class=\"mw-collapsible mw-collapsed\" style=\"border:none;text-align:center;\"><div style=\"font-weight:bold;background-color:transparent;color:inherit;text-align:center;\">300 i 2 matcher<sup id=\"cite&#95;ref-fogissp&#95;1-0\" class=\"reference\"><a href=\"#cite_note-fogissp-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup></div>\n<div class=\"mw-collapsible-content\" style=\"font-weight:normal;background-color:transparent;color:inherit;text-align:left;\"><a href=\"/wiki/V%C3%A4ster%C3%A5s_SK_FK\" title=\"Västerås SK FK\">Västerås</a> 3–1 <a href=\"/wiki/Trelleborgs_FF\" title=\"Trelleborgs FF\">Trelleborg</a><br /><a href=\"/wiki/Ume%C3%A5_FC\" title=\"Umeå FC\">Umeå</a> 1–0 <a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">Sundsvall</a></div></div></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Lägsta&#160;åskådarantal</th><td class=\"\" style=\"\">0 i 225 matcher<sup id=\"cite&#95;ref-fogissp&#95;1-1\" class=\"reference\"><a href=\"#cite_note-fogissp-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup> <small>(<a href=\"/wiki/Covid-19-pandemin_i_Sverige#Myndighetsåtgärder\" title=\"Covid-19-pandemin i Sverige\">Coronarestriktioner</a>)</small></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Totalt åskådarantal</th><td class=\"\" style=\"\">1430<sup id=\"cite&#95;ref-fogissp&#95;1-2\" class=\"reference\"><a href=\"#cite_note-fogissp-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup></td></tr><tr><td colspan=\"2\" style=\"text-align:center;\" class=\"\"><div style=\"float: left;\">&#8592; <a href=\"/wiki/Superettan_2019\" title=\"Superettan 2019\">2019</a> </div><div style=\"float: right;\"><a href=\"/wiki/Superettan_2021\" title=\"Superettan 2021\">2021</a> &#8594;</div>\n<div style=\"clear:both;\"></div><small>All statistik korrekt per den 9 december 2020.</small></td></tr>\n</tbody></table>\n<p><b>Superettan 2020</b> var den 21:e säsongen av <a href=\"/wiki/Superettan\" title=\"Superettan\">Superettan</a>, Sveriges näst högsta <a href=\"/wiki/Division_(sport)\" title=\"Division (sport)\">division</a> i <a href=\"/wiki/Fotboll\" title=\"Fotboll\">fotboll</a> för herrar, under <a href=\"/wiki/Fotbollsallsvenskan_2020\" title=\"Fotbollsallsvenskan 2020\">Allsvenskan</a>.\n</p><p>På grund av <a href=\"/wiki/Covid-19-pandemin_i_Sverige\" title=\"Covid-19-pandemin i Sverige\">coronapandemin</a> blev seriestarten uppskjuten, och inte förrän den 29 maj kom besked om att serien fick starta tidigast den 14 juni.<sup id=\"cite&#95;ref-sef200509&#95;2-0\" class=\"reference\"><a href=\"#cite_note-sef200509-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup> Första omgången spelades den 16–17 juni.<sup id=\"cite&#95;ref-3\" class=\"reference\"><a href=\"#cite_note-3\"><span class=\"cite-bracket\">&#91;</span>3<span class=\"cite-bracket\">&#93;</span></a></sup> Matcherna spelades utan publik.<sup id=\"cite&#95;ref-sef200509&#95;2-1\" class=\"reference\"><a href=\"#cite_note-sef200509-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Med två omgångar kvar blev det klart att nykomlingen <a href=\"/wiki/Ljungskile_SK\" title=\"Ljungskile SK\">Ljungskile SK</a> återigen blev nedflyttade till <a href=\"/wiki/Ettan_(fotboll,_Sverige)\" title=\"Ettan (fotboll, Sverige)\">Division 1</a>.<sup id=\"cite&#95;ref-4\" class=\"reference\"><a href=\"#cite_note-4\"><span class=\"cite-bracket\">&#91;</span>4<span class=\"cite-bracket\">&#93;</span></a></sup> I samma omgång blev <a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstads BK</a> klara för uppflyttning till <a href=\"/wiki/Allsvenskan_(fotboll)\" title=\"Allsvenskan (fotboll)\">Allsvenskan</a>.<sup id=\"cite&#95;ref-5\" class=\"reference\"><a href=\"#cite_note-5\"><span class=\"cite-bracket\">&#91;</span>5<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Den sista omgången spelades först den 5 december. Det blev då klart att <a href=\"/wiki/Degerfors_IF\" title=\"Degerfors IF\">Degerfors IF</a> blir direktuppflyttade till Allsvenskan, tillsammans med Halmstads BK, och att <a href=\"/wiki/J%C3%B6nk%C3%B6ping_S%C3%B6dra_IF\" class=\"mw-redirect\" title=\"Jönköping Södra IF\">Jönköping Södra IF</a> fick kvalspela om plats i <a href=\"/wiki/Fotbollsallsvenskan_2021\" title=\"Fotbollsallsvenskan 2021\">Allsvenskan 2021</a>.<sup id=\"cite&#95;ref-sef201205&#95;6-0\" class=\"reference\"><a href=\"#cite_note-sef201205-6\"><span class=\"cite-bracket\">&#91;</span>6<span class=\"cite-bracket\">&#93;</span></a></sup> Det blev också klart att <a href=\"/wiki/Ume%C3%A5_FC\" title=\"Umeå FC\">Umeå FC</a> blev nedflyttade till <a href=\"/wiki/Ettan_i_fotboll_f%C3%B6r_herrar_2021\" title=\"Ettan i fotboll för herrar 2021\">Division 1</a>, och att <a href=\"/wiki/Trelleborgs_FF\" title=\"Trelleborgs FF\">Trelleborgs FF</a> ställdes mot <a href=\"/wiki/IF_Brommapojkarna\" title=\"IF Brommapojkarna\">IF Brommapojkarna</a> i kval om spel i <a href=\"/wiki/Superettan_2021\" title=\"Superettan 2021\">Superettan 2021</a>, medan att <a href=\"/wiki/Dalkurd_FF\" title=\"Dalkurd FF\">Dalkurd FF</a> ställdes mot <a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona BoIS</a>.<sup id=\"cite&#95;ref-sef201205&#95;6-1\" class=\"reference\"><a href=\"#cite_note-sef201205-6\"><span class=\"cite-bracket\">&#91;</span>6<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"float:right;clear:right;width:354px;padding:4px;border:1px solid silver;margin:4px;background-color:white\">\n<div style=\"position:relative;border:1px solid silver;padding:0px;width:350px\"><span typeof=\"mw:File\"><a href=\"/wiki/Fil:Map_of_Sweden_(polar_stereographic).svg\" class=\"mw-file-description\"><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/56/Map_of_Sweden_%28polar_stereographic%29.svg/500px-Map_of_Sweden_%28polar_stereographic%29.svg.png\" decoding=\"async\" width=\"350\" height=\"846\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/56/Map_of_Sweden_%28polar_stereographic%29.svg/960px-Map_of_Sweden_%28polar_stereographic%29.svg.png 2x\" data-file-width=\"365\" data-file-height=\"882\" /></a></span><br />\n<div style=\"position:absolute;z-index:200;top:66.599286684424%; left:49.886333148956%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-0.5em; left:-2.5em; width:6em;text-align:center;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;\"><a href=\"/wiki/Athletic_FC_Eskilstuna\" class=\"mw-redirect\" title=\"Athletic FC Eskilstuna\">Eskilstuna</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:66.605774363408%; left:62.901354432438%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:-2px;\"><a href=\"/wiki/Akropolis_IF\" title=\"Akropolis IF\">Akropolis</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:63.184981680132%; left:58.884230582908%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:-2px;\"><a href=\"/wiki/Dalkurd_FF\" title=\"Dalkurd FF\">Dalkurd</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:67.635225287179%; left:32.616848982963%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;\"><a href=\"/wiki/Degerfors_IF\" title=\"Degerfors IF\">Degerfors</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:77.817958391557%; left:11.01603563534%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-0.5em; left:-2.5em; width:6em;text-align:center;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:-12px;\"><a href=\"/wiki/Gais\" title=\"Gais\">Gais</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:46.095369001377%; left:53.971425784768%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:-2px;\"><a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">Sundsvall</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:84.815521278187%; left:18.415114984999%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:2px;\"><a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstad</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:77.457527889156%; left:30.03810566656%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköping</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:74.365842496159%; left:10.781114512958%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\";position:relative;top:2px;left:2px;\"><a href=\"/wiki/Ljungskile_SK\" title=\"Ljungskile SK\">Ljungskile</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:77.733252235977%; left:19.420008912623%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px