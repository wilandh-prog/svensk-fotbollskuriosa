;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/Kalmar_FF\" title=\"Kalmar FF\">Kalmar</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:78.6%; left:27.1%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:2px;\"><a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstad</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:89.3%; left:26.8%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;\"><a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:43.3%; left:84.4%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:10px;left:-2px;\"><a href=\"/wiki/Hammarby_IF_Fotboll\" title=\"Hammarby IF Fotboll\">Hammarby</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:1.4%; left:75.8%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=sv.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:7em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:6px;left:-2px;\"><a href=\"/wiki/IFK_Sundsvall\" title=\"IFK Sundsvall\">IFK Sundsvall</a></span></div>\n</div>\n</div>\n</div>\n<div style=\"font-size:90%\">Placering av deltagande lag, allsvenskan 1976.</div>\n</div>\n<p><b>Fotbollsallsvenskan 1976</b> spelades 11 april–24 oktober 1976, och vanns av <a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstads BK</a>. Vårsäsongen spelades 11 april–30 juni, och höstsäsongen spelades 4 augusti–24 oktober.\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Förlopp\"><span id=\"F.C3.B6rlopp\"></span>Förlopp</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_1976&amp;veaction=edit&amp;section=1\" title=\"Redigera avsnitt: Förlopp\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_1976&amp;action=edit&amp;section=1\" title=\"Redigera avsnitts källkod: Förlopp\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>Halmstads BK var starkt nederlagstippade inför säsongspremiären, efter att <a href=\"/wiki/Fotbollsallsvenskan_1975\" title=\"Fotbollsallsvenskan 1975\">föregående säsong</a> ha undvikit nedflyttning enbart på målskillnad. Med unge engelske tränaren <a href=\"/wiki/Roy_Hodgson\" title=\"Roy Hodgson\">Roy Hodgson</a> och ett nytt spelsystem blev man i stället svenska mästare 1976.\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Tabell\">Tabell</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_1976&amp;veaction=edit&amp;section=2\" title=\"Redigera avsnitt: Tabell\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_1976&amp;action=edit&amp;section=2\" title=\"Redigera avsnitts källkod: Tabell\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable infobox\" style=\"font-size:0.8em;\">\n\n<tbody><tr>\n<td rowspan=\"2\" style=\"background-color:#ffec8b;\">&#8195;\n</td>\n<td>Svenska mästare\n</td></tr>\n<tr>\n<td>Kvalificerad för <a href=\"/wiki/Europacupen_i_fotboll_1977/1978\" title=\"Europacupen i fotboll 1977/1978\">Europacupen 1977/1978</a>\n</td></tr>\n<tr>\n<td style=\"background-color:#c3d7e6\">&#8195;</td>\n<td>Kvalificerad för <a href=\"/wiki/Uefacupen_1977/1978\" title=\"Uefacupen 1977/1978\">Uefacupen 1977/1978</a>\n</td></tr>\n<tr>\n<td style=\"background-color:#ecf5f3\">&#8195;</td>\n<td>Kvalificerad för <a href=\"/wiki/Europeiska_cupvinnarcupen_i_fotboll_1977/1978\" title=\"Europeiska cupvinnarcupen i fotboll 1977/1978\">Cupvinnarcupen 1977/1978</a>\n</td></tr>\n<tr>\n<td style=\"background-color:#f0c4c4\">&#8195;</td>\n<td>Nedflyttad till <a href=\"/wiki/Division_II_i_fotboll_1977\" title=\"Division II i fotboll 1977\">Division II 1977</a>\n</td></tr>\n</tbody></table>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Poängtabell\"><span id=\"Po.C3.A4ngtabell\"></span>Poängtabell</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_1976&amp;veaction=edit&amp;section=3\" title=\"Redigera avsnitt: Poängtabell\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_1976&amp;action=edit&amp;section=3\" title=\"Redigera avsnitts källkod: Poängtabell\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>&#160;<span class=\"noprint plainlinks\" style=\"white-space:nowrap; font-weight:normal; font-size:80%; ;\">Denna tabell:&#160;<a href=\"/wiki/Mall:Po%C3%A4ngtabell_f%C3%B6r_Fotbollsallsvenskan_1976\" title=\"Mall:Poängtabell för Fotbollsallsvenskan 1976\"><span title=\"Visa denna mall\" style=\";\">visa</span></a>&#160;<span style=\"font-size:80%;\">•</span>&#160;<a class=\"external text\" data-mw-original-href=\"//sv.wikipedia.org/w/index.php?title=Mall:Po%C3%A4ngtabell_f%C3%B6r_Fotbollsallsvenskan_1976&amp;action=edit\" href=\"https://sv.wikipedia.org/w/index.php?title=Mall:Po%C3%A4ngtabell_f%C3%B6r_Fotbollsallsvenska