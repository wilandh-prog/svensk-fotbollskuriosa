0.6em}.mw-parser-output .infobox.geography .maptable td,.mw-parser-output .infobox.geography .maptable th{border:0;padding:0}</style><table class=\"infobox\" style=\"border-spacing:3px; width:30em;\"><caption class=\"\" style=\"font-size: 125%; font-weight: bold;\"><a href=\"/wiki/Superettan\" title=\"Superettan\">Superettan</a></caption><tbody><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Datum</th><td class=\"\" style=\"\"><a href=\"/wiki/10_april\" title=\"10 april\">10 april</a>–<a href=\"/wiki/27_november\" title=\"27 november\">27 november</a> <a href=\"/wiki/Sport%C3%A5ret_2021\" title=\"Sportåret 2021\">2021</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><span style=\"white-space:nowrap\">Nya lag för säsongen</span></th><td class=\"\" style=\"\"><div class=\"mw-collapsible mw-collapsed\" style=\"border:none;text-align:center;\"><div style=\"font-weight:bold;background-color:transparent;color:inherit;text-align:center;\">5 lag</div>\n<div class=\"mw-collapsible-content\" style=\"font-weight:normal;background-color:transparent;color:inherit;text-align:left;\"><a href=\"/wiki/Falkenbergs_FF\" title=\"Falkenbergs FF\">Falkenbergs FF</a><br /><a href=\"/wiki/Helsingborgs_IF\" title=\"Helsingborgs IF\">Helsingborgs IF</a><br /><a href=\"/wiki/IFK_V%C3%A4rnamo\" title=\"IFK Värnamo\">IFK Värnamo</a><br /><a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona BoIS</a><br /><a href=\"/wiki/Vasalunds_IF\" title=\"Vasalunds IF\">Vasalunds IF</a></div></div></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Uppflyttade</th><td class=\"\" style=\"\"><a href=\"/wiki/IFK_V%C3%A4rnamo\" title=\"IFK Värnamo\">IFK Värnamo</a><br /><a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">GIF Sundsvall</a><br /><a href=\"/wiki/Helsingborgs_IF\" title=\"Helsingborgs IF\">Helsingborgs IF</a> <span style=\"font-size:smaller; line-height:130%\">(via kvalspel)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Nedflyttade</th><td class=\"\" style=\"\"><a href=\"/wiki/Vasalunds_IF\" title=\"Vasalunds IF\">Vasalunds IF</a><br /><a href=\"/wiki/Falkenbergs_FF\" title=\"Falkenbergs FF\">Falkenbergs FF</a><br /><a href=\"/wiki/Gais\" title=\"Gais\">Gais</a> <span style=\"font-size:smaller; line-height:130%\">(via kvalspel)</span><br /><a href=\"/wiki/Akropolis\" class=\"mw-redirect\" title=\"Akropolis\">Akropolis</a> <span style=\"font-size:smaller; line-height:130%\">(via kvalspel)</span></td></tr><tr><th colspan=\"2\" style=\"text-align:center;background-color:#f0f1f2;\">Statistik</th></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Spelade&#160;matcher</th><td class=\"\" style=\"\">240</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Totalt&#160;antal&#160;mål</th><td class=\"\" style=\"\">612 (2,6 per match)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;hemmavinst</th><td class=\"\" style=\"\"><div class=\"mw-collapsible mw-collapsed\" style=\"border:none;text-align:center;\"><div style=\"font-weight:bold;background-color:transparent;color:inherit;text-align:center;\">3 matcher</div>\n<div class=\"mw-collapsible-content\" style=\"font-weight:normal;background-color:transparent;color:inherit;text-align:left;\"><a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköping</a> 5–1 <a href=\"/wiki/Vasalunds_IF\" title=\"Vasalunds IF\">Vasalund</a><br /><span style=\"font-size:smaller; line-height:130%\">(11 april 2021)</span><br /><a href=\"/wiki/AFC_Eskilstuna\" title=\"AFC Eskilstuna\">Eskilstuna</a> 4–0 <a href=\"/wiki/%C3%96rgryte_IS\" title=\"Örgryte IS\">Örgryte</a><br /><span style=\"font-size:smaller; line-height:130%\">(25 juli 2021)</span><br /><a href=\"/wiki/Helsingborgs_IF\" title=\"Helsingborgs IF\">Helsingborg</a> 4–0 <a href=\"/wiki/Falkenbergs_FF\" title=\"Falkenbergs FF\">Falkenberg</a><br /><span style=\"font-size:smaller; line-height:130%\">(27 juli 2021)</span></div></div></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;bortavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/V%C3%A4ster%C3%A5s_SK_FK\" title=\"Västerås SK FK\">Västerås</a> 0–4 <a href=\"/wiki/Helsingborgs_IF\" title=\"Helsingborgs IF\">Helsingborg</a><br /><span style=\"font-size:smaller; line-height:130%\">(18 juli 2021)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Målrikaste match</th><td class=\"\" style=\"\"><a href=\"/wiki/Vasalunds_IF\" title=\"Vasalunds IF\">Vasalund</a> 3–4 <a href=\"/wiki/Gais\" title=\"Gais\">Gais</a><br /><span style=\"font-size:smaller; line-height:130%\">(29 augusti 2021)</span></td></tr><tr><td colspan=\"2\" style=\"text-align:center;\" class=\"\"><div style=\"float: left;\">&#8592; <a href=\"/wiki/Superettan_2020\" title=\"Superettan 2020\">2020</a> </div><div style=\"float: right;\"><a href=\"/wiki/Superettan_2022\" title=\"Superettan 2022\">2022</a> &#8594;</div></td></tr>\n</tbody></table>\n<div style=\"float:right;clear:right;width:354px;padding:4px;border:1px solid silver;margin:4px;background-color:white\">\n<div style=\"position:relative;border:1px solid silver;padding:0px;width:350px\"><span typeof=\"mw:File\"><a href=\"/wiki/Fil:Map_of_Sweden_(polar_stereographic).svg\" class=\"mw-file-description\"><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/56/Map_of_Sweden_%28polar_stereographic%29.svg/500px-Map_of_Sweden_%28polar_stereographic%29.svg.png\" decoding=\"async\" width=\"350\" height=\"846\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/56/Map_of_Sweden_%28polar_stereographic%29.svg/960px-Map_of_Sweden_%28polar_stereographic%29.svg.png 2x\" data-file-width=\"365\" 