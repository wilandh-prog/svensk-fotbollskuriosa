ile-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:80%;position:relative;top: 3px;left:-2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/Vasalunds_IF\" title=\"Vasalunds IF\">Vasalund</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:64.863676708984%; left:49.878121555113%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:80%;position:relative;top: 3px;left: 2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/V%C3%A4ster%C3%A5s_SK_FK\" title=\"Västerås SK FK\">Västerås</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:77.817420168536%; left:11.01065045734%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:80%;position:relative;top: 8px;left: 2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/%C3%96rgryte_IS\" title=\"Örgryte IS\">Örgryte</a>&#160;</span></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:83.547655712635%; left:35.736730124095%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"font-size:80%;position:relative;top: 3px;left:-2px;\"><span style=\"background-color:#FFFFFF; color:#0000FF; border:1px solid #aaa; text-align:center;\">&#160;<a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Öster</a>&#160;</span></span></div>\n</div>\n</div>\n</div>\n<div style=\"font-size:90%\">Geografisk placering av de deltagande lagen i Superettan 2021.</div>\n</div>\n<p><b>Superettan 2021</b> var den tjugoandra säsongen av <a href=\"/wiki/Superettan\" title=\"Superettan\">Superettan</a>, Sveriges näst högsta <a href=\"/wiki/Division_(sport)\" title=\"Division (sport)\">division</a> i <a href=\"/wiki/Fotboll\" title=\"Fotboll\">fotboll</a> för herrar, nivån under <a href=\"/wiki/Allsvenskan_(fotboll)\" title=\"Allsvenskan (fotboll)\">Allsvenskan</a>.\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Förlopp\"><span id=\"F.C3.B6rlopp\"></span>Förlopp</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Superettan_2021&amp;veaction=edit&amp;section=1\" title=\"Redigera avsnitt: Förlopp\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Superettan_2021&amp;action=edit&amp;section=1\" title=\"Redigera avsnitts källkod: Förlopp\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>Den 22 december 2020 meddelade <a href=\"/wiki/Svenska_Fotbollf%C3%B6rbundet\" title=\"Svenska Fotbollförbundet\">Svenska Fotbollförbundet</a> att de första matcherna spelas helgen den 10–11 april 2021 och serien avslutas lördagen den 27 november samma år.<sup id=\"cite&#95;ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Lag_och_arenor\">Lag och arenor</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Superettan_2021&amp;veaction=edit&amp;section=2\" title=\"Redigera avsnitt: Lag och arenor\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Superettan_2021&amp;action=edit&amp;section=2\" title=\"Redigera avsnitts källkod: Lag och arenor\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>16 lag kvalificerade sig för spel i superettan 2021 efter resultat från <a href=\"/wiki/Fotbollsallsvenskan_2020\" title=\"Fotbollsallsvenskan 2020\">Allsvenskan 2020</a>, <a href=\"/wiki/Superettan_2020\" title=\"Superettan 2020\">Superettan 2020</a> och <a href=\"/wiki/Division_1_i_fotboll_f%C3%B6r_herrar_2020\" class=\"mw-redirect\" title=\"Division 1 i fotboll för herrar 2020\">Division 1 2020</a>.\n</p>\n<table class=\"wikitable sortable\">\n<tbody><tr>\n<th>Lag\n</th>\n<th>Län\n</th>\n<th>Ort\n</th>\n<th>Arena\n</th>\n<th>Underlag\n</th>\n<th colspan=\"2\">Kapacitet\n</th>\n<th>Placering<br />2020\n</th></tr>\n<tr>\n<td><a href=\"/wiki/AFC_Eskilstuna\" title=\"AFC Eskilstuna\">AFC Eskilstuna</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/S%C3%B6dermanlands_l%C3%A4n\" title=\"Södermanlands län\"><img alt=\"Södermanlands län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/55/S%C3%B6dermanlands_vapen.svg/20px-S%C3%B6dermanlands_vapen.svg.png\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/55/S%C3%B6dermanlands_vapen.svg/40px-S%C3%B6dermanlands_vapen.svg.png 2x\" data-file-width=\"248\" data-file-height=\"300\" /></a></span>&#160;</span><a href=\"/wiki/S%C3%B6dermanlands_l%C3%A4n\" title=\"Södermanlands län\">Södermanland</a>\n</td>\n<td><a href=\"/wiki/Eskilstuna\" title=\"Eskilstuna\">Eskilstuna</a>\n</td>\n<td><a href=\"/wiki/Tunavallen\" title=\"Tunavallen\">Tunavallen</a>\n</td>\n<td>Konstgräs\n</td>\n<td>7 200\n</td>\n<td><sup id=\"cite&#95;ref-2\" class=\"reference\"><a href=\"#cite_note-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td align=\"center\"><span style=\"display:none\" class=\"sortkey\">I &#xfeff;</span><span class=\"sorttext\">9</span>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Akropolis_IF\" title=\"Akropolis IF\">Akropolis IF</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\"><img alt=\"Stockholms län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/20px-Stockholm_l%C3%A4n_vapen.svg.png\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/f/f4/Stockholm_l%C3%A4n_vapen.svg/40px-Stockholm_l%C3%A4n_vapen.svg.png 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/Stockholms_l%C3%A4n\" title=\"Stockholms län\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Stockholm\" title=\"Stockholm\">Stockholm</a>\n</td>\n<td><a href=\"/wiki/Grimsta_IP\" title=\"Grimsta IP\">Grimsta IP</a>\n</td>\n<td>Konstgräs\n</td>\n<td>6 400\n</td>\n<td><sup id=\"cite&#95;ref-3\" class=\"reference\"><a href=\"#cite_note-3\"><span class=\"cite-bracket\">&#91;</span>3<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td align=\"center\"><span style=\"display:none\" class=\"sortkey\">E &#xfeff;</span><span class=\"sorttext\">5</span>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/Falkenbergs_FF\" title=\"Falkenbergs FF\">Falkenbergs FF</a>\n</td>\n<td><span class=\"flagicon\" style=\"white-space:nowrap;\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/Hallands_l%C3%A4n\" title=\"Hallands län\"><img alt=\"Hallands län\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0f/Halland_vapen.svg/20px-Halland_vapen.svg.png\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0f/Halland_vapen.svg/40px-Halland_vapen.svg.png 2x\" data-file-width=\"251\" data-file-height=\"304\" /></a></span>&#160;</span><a href=\"/wiki/Hallands_l%C3%A4n\" title=\"Hallands län\">Halland</a>\n</td>\n<td><a href=\"/wiki/Falkenberg\" title=\"Falkenberg\">Falkenberg</a>\n</td>\n<td><a href=\"/wiki/Falcon_Alkoholfri_Arena\" title=\"Falcon Alkoholfri Arena\">Falcon Alkoholfri Arena</a>\n</td>\n<td>Gräs\n</td>\n<td>5 500\n</td>\n<td><sup id=\"cite&#95;ref-4\" class=\"reference\"><a href=\"#cite_note-4\"><span class=\"cite-bracket\">&#91;</span>4<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td alig