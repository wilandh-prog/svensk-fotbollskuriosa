ze:0.875em;\"></td>\n<td style=\"vertical-align:top; text-align:center; font-size:0.9375em;\"></td>\n<td style=\"vertical-align:top; text-align:left; font-size:0.875em;\"></td>\n</tr></tbody></table>\n<hr />\n<table cellspacing=\"0px\" border=\"0\" class=\"mw-collapsible mw-collapsed\" style=\"margin-bottom:4px; width:100%; border-style:none; background-color:transparent;\">\n<tbody><tr>\n<td style=\"width:3%; font-weight:bold; font-size:0.875em;\" id=\"2\">2</td>\n<td style=\"width:12%; text-align:right; font-weight:normal; font-size:0.9375em;\">10 november 2019</td>\n<td style=\"width:24%; text-align:right; font-weight:bold; font-size:1em;;\"><a href=\"/wiki/Kalmar_FF\" title=\"Kalmar FF\">Kalmar FF</a></td>\n<td style=\"width:12%; text-align:center; font-weight:bold; font-size:1em;\">\n<a href=\"/w/index.php?title=Kvalspelet_till_Fotbollsallsvenskan_2020&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"Kvalspelet till Fotbollsallsvenskan 2020 [inte skriven än]\">2 – 2</a></td>\n\n<td style=\"width:24%; text-align:left; font-weight:bold; font-size:1em;;\"><a href=\"/wiki/IK_Brage\" title=\"IK Brage\">IK Brage</a></td>\n<td style=\"width:21%; text-align:left; font-size:0.875em;\"><a href=\"/wiki/Guldf%C3%A5geln_Arena\" title=\"Guldfågeln Arena\">Guldfågeln Arena</a></td>\n<th style=\"width:4%; font-size:0.9375em;\"></th>\n</tr>\n<tr>\n<td style=\"vertical-align:top; text-align:right; font-size:0.9375em;\" colspan=\"2\" rowspan=\"3\">14:45&#160;<a href=\"/wiki/Koordinerad_universell_tid\" title=\"Koordinerad universell tid\">UTC+1</a><br /></td>\n<td style=\"vertical-align:top; text-align:right; font-size:0.875em;\"><a href=\"/wiki/Fidan_Aliti\" title=\"Fidan Aliti\">Fidan Aliti</a> <span typeof=\"mw:File\"><a href=\"/wiki/M%C3%A5l_(sport)\" title=\"Mål\"><img alt=\"Mål\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/51/Soccerball_shade.svg/20px-Soccerball_shade.svg.png\" decoding=\"async\" width=\"13\" height=\"13\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/51/Soccerball_shade.svg/40px-Soccerball_shade.svg.png 2x\" data-file-width=\"333\" data-file-height=\"333\" /></a></span>&#160;<span style=\"font-size:10px;vertical-align:middle;\">60&#8242;</span><br /><a href=\"/wiki/Herman_Hallberg\" title=\"Herman Hallberg\">Herman Hallberg</a> <span typeof=\"mw:File\"><a href=\"/wiki/M%C3%A5l_(sport)\" title=\"Mål\"><img alt=\"Mål\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/51/Soccerball_shade.svg/20px-Soccerball_shade.svg.png\" decoding=\"async\" width=\"13\" height=\"13\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/51/Soccerball_shade.svg/40px-Soccerball_shade.svg.png 2x\" data-file-width=\"333\" data-file-height=\"333\" /></a></span>&#160;<span style=\"font-size:10px;vertical-align:middle;\">86&#8242;</span><br /></td>\n<td style=\"vertical-align:top; text-align:center; font-size:0.875em;\">(0 – 0)<br /><a rel=\"nofollow\" class=\"external text\" href=\"https://www.svenskfotboll.se/matchfakta/kalmar-ff-ik-brage-kval/4402497/\">Rapport</a></td>\n<td style=\"vertical-align:top; text-align:left; font-size:0.875em;\"><span typeof=\"mw:File\"><a href=\"/wiki/M%C3%A5l_(sport)\" title=\"Mål\"><img alt=\"Mål\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/51/Soccerball_shade.svg/20px-Soccerball_shade.svg.png\" decoding=\"async\" width=\"13\" height=\"13\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/51/Soccerball_shade.svg/40px-Soccerball_shade.svg.png 2x\" data-file-width=\"333\" data-file-height=\"333\" /></a></span>&#160;<span style=\"font-size:10px;vertical-align:middle;\">88&#8242;</span> <a href=\"/wiki/Jonathan_Morsay\" title=\"Jonathan Morsay\">Jonathan Morsay</a><br /><span typeof=\"mw:File\"><a href=\"/wiki/M%C3%A5l_(sport)\" title=\"Mål\"><img alt=\"Mål\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/51/Soccerball_shade.svg/20px-Soccerball_shade.svg.png\" decoding=\"async\" width=\"13\" height=\"13\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/thumb/5/51/Soccerball_shade.svg/40px-Soccerball_shade.svg.png 2x\" data-file-width=\"333\" data-file-height=\"333\" /></a></span>&#160;<span style=\"font-size:10px;vertical-align:middle;\">90+2&#8242;</span> <a href=\"/wiki/Christian_Kouakou\" title=\"Christian Kouakou\">Christian Kouakou</a><br /></td>\n<td style=\"vertical-align:top; text-align:left; font-size:0.875em;\" rowspan=\"3\" colspan=\"2\"><a href=\"/wiki/Kalmar\" title=\"Kalmar\">Kalmar</a><br />Publik: 6&#160;218<br />Domare: <a href=\"/wiki/Mohammed_Al-Hakim\" title=\"Mohammed Al-Hakim\">Mohammed Al-Hakim</a><br /></td>\n</tr>\n<tr>\n<td style=\"vertical-align:top; text-align:center; font-size:0.90em;\" colspan=\"3\"></td>\n</tr>\n<tr>\n<td style=\"vertical-align:top; text-align:right; font-size:0.875em;\"></td>\n<td style=\"vertical-align:top; text-align:center; font-size:0.9375em;\"></td>\n<td style=\"vertical-align:top; text-align:left; font-size:0.875em;\"></td>\n</tr></tbody></table>\n<p><i>Kalmar FF kvalificerade sig för <a href=\"/wiki/Fotbollsallsvenskan_2020\" title=\"Fotbollsallsvenskan 2020\">Fotbollsallsvenskan 2020</a> med ackumulerade slutresultatet 4–2.</i>\n</p><p><br />\n</p>\n<div class=\"mw-heading mw-heading4\"><h4 id=\"Nedflyttningskval\">Nedflyttningskval</h4><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Superettan_2019&amp;veaction=edit&amp;section=5\" title=\"Redigera avsnitt: Nedflyttningskval\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Superettan_2019&amp;action=edit&amp;section=5\" title=\"Redigera avsnitts källkod: Nedflyttningskval\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>Laget som slutade på fjortondeplats i superettan, <a href=\"/wiki/IK_Frej\" title=\"IK Frej\">IK Frej</a>, spelade ett kvalspel mot det lag som slutade på andraplats i <a href=\"/wiki/Division_1_i_fotboll_f%C3%B6r_herrar_2019\" title=\"Division 1 i fotboll för herrar 2019\">division 1 norra</a>, <a href=\"/wiki/Ume%C3%A5_FC\" title=\"Umeå FC\">Umeå FC</a>. Laget som slutade på trettondeplats i superettan, <a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Östers IF</a>, spelade ett kvalspel mot det lag som slutade på andraplats i <a href=\"/wiki/Division_1_i_fotboll_f%C3%B6r_herrar_2019\" title=\"Division 1 i fotboll för herrar 2019\">division 1 södra</a>, <a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona BoIS</a>.<sup id=\"cite&#95;ref-32\" class=\"reference\"><a href=\"#cite_note-32\"><span class=\"cite-bracket\">&#91;</span>32<span class=\"cite-bracket\">&#93;</span></a></sup> Kvalspelet slutade med att Öster behöll sin plats medan Frej flyttades ned till förmån för Umeå.\n</p>\n<table cellspacing=\"0px\" border=\"0\" class=\"mw-collapsible mw-collapsed\" style=\"margin-bottom:4px; width:100%; border-style:none; background-color:transparent;\">\n<tbody><tr>\n<td style=\"width:3%; font-weight:bold; font-size:0.875em;\" id=\"1\">1</td>\n<td style=\"width:12%; text-align:right; font-weight:normal; font-size:0.9375em;\">7 november 2019</td>\n<td style=\"width:24%; text-align:right; font-weight:bold; font-size:1em;;\"><a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona BoIS</a></td>\n<td style=\"width:12%; text-align:center; font-weight:bold; font-size:1em;\">\n1 – 1</td>\n\n<td style=\"width:24%; text-align:left; font-weight:bold; font-size:1em;;\"><a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Östers IF</a></td>\n<td style=\"width:21%; text-align:left; font-size:0.875em;\"><a href=\"/wiki/Landskrona_IP\" title=\"Landskrona IP\">Landskrona IP</a></td>\n<th style=\"width:4%; font-size:0.9375em;\"></th>\n</tr>\n<tr>\n<td style=\"vertical-align:top; text-align:right; font-size:0.9375em;\" colspan=\