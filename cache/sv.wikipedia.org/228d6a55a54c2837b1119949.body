%B6_FF\" title=\"Malmö FF\">Malmö FF</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><a href=\"/wiki/Uefacupen_2005/2006\" title=\"Uefacupen 2005/2006\">Uefacupen</a></th><td class=\"\" style=\"\"><a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstads BK</a><br /><a href=\"/wiki/Djurg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgårdens IF</a> (<span style=\"cursor: help; border-bottom: 1px dotted;\" title=\"Kvalificerade sig för uefacupen genom att vinna svenska cupen 2004\">Cupen</span>)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><a href=\"/wiki/Intertotocupen_2005\" title=\"Intertotocupen 2005\">Intertotocupen </a></th><td class=\"\" style=\"\"><a href=\"/wiki/IFK_G%C3%B6teborg\" title=\"IFK Göteborg\">IFK Göteborg</a></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\"><a href=\"/wiki/Royal_League_2004/2005\" title=\"Royal League 2004/2005\">Royal League</a></th><td class=\"\" style=\"\"><a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö FF</a><br /><a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstads BK</a><br /><a href=\"/wiki/IFK_G%C3%B6teborg\" title=\"IFK Göteborg\">IFK Göteborg</a><br /><a href=\"/wiki/Djurg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgårdens IF</a></td></tr><tr><th colspan=\"2\" style=\"text-align:center;background-color:#f0f1f2;\">Statistik</th></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Spelade&#160;matcher</th><td class=\"\" style=\"\">182</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Bästa målgörare</th><td class=\"\" style=\"\"><a href=\"/wiki/Markus_Rosenberg\" title=\"Markus Rosenberg\">Markus Rosenberg</a>, <a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstads BK</a> (14)</td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;hemmavinst</th><td class=\"\" style=\"\"><div class=\"mw-collapsible mw-collapsed\" style=\"border:none;text-align:center;\"><div style=\"font-weight:bold;background-color:transparent;color:inherit;text-align:center;\">2 matcher</div>\n<div class=\"mw-collapsible-content\" style=\"font-weight:normal;background-color:transparent;color:inherit;text-align:left;\"><a href=\"/wiki/Djurg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgården</a> 5–0 <a href=\"/wiki/Trelleborgs_FF\" title=\"Trelleborgs FF\">Trelleborg</a><br /><span style=\"font-size:smaller; line-height:130%\">(26 september 2004)</span><br /><a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstad</a> 5–0 <a href=\"/wiki/%C3%96rebro_SK_Fotboll\" title=\"Örebro SK Fotboll\">Örebro</a><br /><span style=\"font-size:smaller; line-height:130%\">(26 september 2004)</span></div></div></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Största&#160;bortavinst</th><td class=\"\" style=\"\"><a href=\"/wiki/Trelleborgs_FF\" title=\"Trelleborgs FF\">Trelleborg</a> 1–6 <a href=\"/wiki/Helsingborgs_IF\" title=\"Helsingborgs IF\">Helsingborg</a><br /><span style=\"font-size:smaller; line-height:130%\">(19 juli 2004)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Flest mål i en match</th><td class=\"\" style=\"\"><a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstad</a> 5–3 <a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona</a><br /><span style=\"font-size:smaller; line-height:130%\">(9 maj 2004)</span></td></tr><tr><th style=\"text-align:left; width:35%; text-align:left; vertical-align:top;\">Högsta&#160;åskådarantal</th><td class=\"\" style=\"\"><span style=\"display:none\">&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;040186.&amp;&amp;&amp;&amp;&amp;0</span>40&#160;186. <a href=\"/wiki/%C3%96rgryte_IS\" title=\"Örgryte IS\">Örgryte</a> 1–2 