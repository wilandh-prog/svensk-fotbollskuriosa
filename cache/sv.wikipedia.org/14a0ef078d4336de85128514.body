padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;left:2px;\"><a href=\"/wiki/IFK_G%C3%B6teborg\" title=\"IFK Göteborg\">Göteborg</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:54.8%; left:16.7%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-3.0em; left:-2.5em; width:6em;text-align:center;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:13px;left:-11px;\"><a href=\"/wiki/Gais\" title=\"Gais\">Gais</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:54.6%; left:26.8%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/IF_Elfsborg\" title=\"IF Elfsborg\">Elfsborg</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:86.3%; left:25.8%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;\"><a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:83.5%; left:24.4%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:4px;\"><a href=\"/wiki/Helsingborgs_IF\" title=\"Helsingborgs IF\">Hälsingborg</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:39.5%; left:61%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em;left:0.5em;text-align:left;width:6em;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/IFK_Norrk%C3%B6ping\" title=\"IFK Norrköping\">Norrköping</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:39.5%; left:61%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:2px;\"><a href=\"/wiki/IF_Sleipner\" title=\"IF Sleipner\">Sleipner</a></span></div>\n</div>\n</div>\n<div style=\"position:absolute;z-index:200;top:43.6%; left:16.2%;height:0;width:0;margin:0;padding:0;\">\n<div style=\"position:relative;top:-4px;left:-4px;width:8px;text-align:center;line-height:0;z-index:201\"><span typeof=\"mw:File\"><span><img src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div>\n<div style=\"font-size:90%;line-height:110%;position:relative;top:-1.5em; left:-6.5em;width:6em;text-align:right;z-index:202;\"><div style=\"padding:1px;background:none\"><span style=\"position:relative;top:5px;left:2px;\"><a href=\"/wiki/IFK_Uddevalla\" title=\"IFK Uddevalla\">Uddevalla</a></span></div>\n</div>\n</div>\n</div>\n<div style=\"font-size:90%\">Placering av deltagande lag, allsvenskan 1926/1927.</div>\n</div>\n<p><b>Fotbollsallsvenskan 1926/1927</b> bestod av 12 lag och var den tredje säsongen av Fotbollsallsvenskan. Höstsäsongen spelades <a href=\"/wiki/1_augusti\" title=\"1 augusti\">1 augusti</a>-<a href=\"/wiki/21_november\" title=\"21 november\">21 november</a> <a href=\"/wiki/Sport%C3%A5ret_1926\" title=\"Sportåret 1926\">1926</a> och vårsäsongen spelades <a href=\"/wiki/10_april\" title=\"10 april\">10 april</a>-<a href=\"/wiki/6_juni\" title=\"6 juni\">6 juni</a> <a href=\"/wiki/Sport%C3%A5ret_1927\" title=\"Sportåret 1927\">1927</a>. En seger gav 2 poäng, oavgjort 1 poäng och en förlust 0 poäng. Segrarna <a href=\"/wiki/Gais\" title=\"Gais\">Gais</a> blev dock inte <a href=\"/wiki/Svenska_m%C3%A4stare_i_fotboll\" title=\"Svenska mästare i fotboll\">svenska mästare</a> då Allsvenskan inte fick svensk mästerskapsstatus förrän säsongen <a href=\"/wiki/Fotbollsallsvenskan_1930/1931\" title=\"Fotbollsallsvenskan 1930/1931\">1930/31</a>.\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Tabeller\">Tabeller</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_1926/1927&amp;veaction=edit&amp;section=1\" title=\"Redigera avsnitt: Tabeller\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_1926/1927&amp;action=edit&amp;section=1\" title=\"Redigera avsnitts källkod: Tabeller\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<table class=\"wikitable infobox\" style=\"font-size:0.8em;\">\n\n<tbody><tr>\n<td style=\"background-color:#bbffbb;\">&#8195;\n</td>\n<td>Allsvenska mästare\n</td></tr>\n<tr>\n<td style=\"background-color:#f0c4c4\">&#8195;</td>\n<td>Nedflyttad till <a href=\"/wiki/Division_II_i_fotboll_1927/1928\" title=\"Division II i fotboll 1927/1928\">Division II 1927/28</a>\n</td></tr>\n</tbody></table>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Poängtabell\"><span id=\"Po.C3.A4ngtabell\"></span>Poängtabell</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Fotbollsallsvenskan_1926/1927&amp;veaction=edit&amp;section=2\" title=\"Redigera avsnitt: Poängtabell\" class=\"mw-editsection-visualeditor\"><span>redigera</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Fotbollsallsvenskan_1926/1927&amp;action=edit&amp;section=2\" title=\"Redigera avsnitts källkod: Poängtabell\"><span>redigera wikitext</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>&#160;<span class=\"noprint plainlinks\" style=\"white-space:nowrap; font-weight:normal; font-size:80%; ;\">Denna tabell:&#160;<a href=\"/wiki/Mall:Po%C3%A4ngtabell_f%C3%B6r_Fotbollsallsvenskan_1926/1927\" title=\"Mall:Poängtabell för Fotbollsallsvenskan 1926/1927\"><span title=\"Visa denna mall\" style=\";\">visa</span></a>&#160;<span style=\"font-size:80%;\">•</span>&#160;<a class=\"external text\" data-mw-original-href=\"//sv.wikipedia.org/w/index.php?title=Mall:Po%C3%A4ngtabell_f%C3%B6r_Fotbollsallsvenskan_1926/1927&amp;action=edit\" href=\"https://sv.wikipedia.org/w/index.php?title=Mall:Po%C3%A4ngtabell_f%C3%B6r_Fotbollsallsvenskan_1926/1927&amp;action=edit\"><span style=\";\" title=\"Redigera den här mallen\">redigera</span></a></span>&#160;\n</p>\n<table class=\"wikitable sortable\" style=\"font-size:0.9375em;line-height:1.4em;text-align:center;background:white;margin-