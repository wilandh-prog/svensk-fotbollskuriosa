notheme\" style=\"top:26.003%;left:78.712%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Brommapojkarna\"><img alt=\"Brommapojkarna\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pv\" style=\"width:6em;top:5px;left:-3em\"><div><a href=\"/wiki/IF_Brommapojkarna\" title=\"IF Brommapojkarna\">Brommapojkarna</a></div></div></div><div class=\"od notheme\" style=\"top:25.994%;left:80.24%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"AIK\"><img alt=\"AIK\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><div style=\"position:relative;top:-8px;right:15px;\"><a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a></div></div></div></div><div class=\"od notheme\" style=\"top:26.296%;left:81.114%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Djurgården\"><img alt=\"Djurgården\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pl\" style=\"width:6em;right:5px\"><div>