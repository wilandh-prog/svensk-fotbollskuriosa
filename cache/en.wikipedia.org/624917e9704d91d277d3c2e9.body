:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Gothenburg\"><img alt=\"Gothenburg\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/4/46/Black_pog.svg/20px-Black_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pv\" style=\"width:6em;top:5px;left:-3em\"><div><b>Gothenburg</b></div></div></div><div class=\"od notheme\" style=\"top:39.328%;left:61.093%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"IFK Norrköping\"><img alt=\"IFK Norrköping\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><span class=\"nowrap\"><a href=\"/wiki/IFK_Norrk%C3%B6ping\" title=\"IFK Norrköping\">IFK Norrköping</a></span></div></div></div><div class=\"od notheme\" style=\"top:63.758%;left:38.451%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"IFK Värnamo\"><img alt=\"IFK Värnamo\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><a href=\"/wiki/IFK_V%C3%A4rnamo\" title=\"IFK Värnamo\">IFK Värnamo</a></div></div></div><div class=\"od notheme\" style=\"top:21.518%;left:64.869%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Västerås SK\"><img alt=\"Västerås SK\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pl\" style=\"width:6em;right:5px\"><div><a href=\"/wiki/V%C3%A4ster%C3%A5s_SK_Fotboll\" title=\"Västerås SK Fotboll\">Västerås SK</a></div></div></div><div class=\"od notheme\" style=\"top:17.535%;left:76.476%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"IK Sirius\"><img alt=\"IK Sirius\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pv\" style=\"width:6em;bottom:5px;left:-3em\"><div><span class=\"nowrap\"><a href=\"/wiki/IK_Sirius_Fotboll\" title=\"IK Sirius Fotboll\">IK Sirius</a></span></div></div></div><div class=\"od notheme\" style=\"top:72.767%;left:62.427%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Kalmar FF\"><img alt=\"Kalmar FF\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><span class=\"nowrap\"><a href=\"/wiki/Kalmar_FF\" title=\"Kalmar FF\">Kalmar FF</a></span></div></div></div><div class=\"od notheme\" style=\"top:91.609%;left:27.288%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Malmö FF\"><img alt=\"Malmö FF\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><div style=\"position:relative;top:-8px;right:2px;\"><span class=\"nowrap\"><a href=\"/wiki/Malm%C3%B6_FF\" title=\"Malmö FF\">Malmö FF</a></span></div></div></div></div><div class=\"od notheme\" style=\"top:84.168%;left:45.594%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Mjällby AIF\"><img alt=\"Mjällby AIF\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><span class=\"nowrap\"><a href=\"/wiki/Mj%C3%A4llby_AIF\" title=\"Mjällby AIF\">Mjällby AIF</a></span></div></div></div><div class=\"od notheme\" style=\"top:26.296%;left:81.114%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Stockholm\"><img alt=\"Stockholm\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/4/46/Black_pog.svg/20px-Black_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pl\" style=\"width:6em;right:5px\"><div><div style=\"position:relative;top:0px;bottom:-15px;\"><b>Stockholm</b></div></div></div></div><div class=\"od notheme\" style=\"top:2.778%;left:1.056%;font-size:91%\"><div class=\"id\" style=\"left:-1px;top:-1px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Stockholm teams AIK Djurgårdens IF Hammarby IF IF Brommapojkarna\"><img alt=\"Stockholm teams AIK Djurgårdens IF Hammarby IF IF Brommapojkarna\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/3/3a/TransparentPlaceholder.png/20px-TransparentPlaceholder.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"1\" height=\"1\" class=\"mw-file-element\" data-file-width=\"500\" data-file-height=\"375\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:2px\"><div><span class=\"nowrap\"><b>Stockholm teams</b></span><span class=\"nowrap\"><br /><a href=\"/wiki/AIK_Fotboll\" title=\"AIK Fotboll\">AIK</a><br /><a href=\"/wiki/Djurg%C3%A5rdens_IF_Fotboll\" title=\"Djurgårdens IF Fotboll\">Djurgårdens IF</a><br /><a href=\"/wiki/Hammarby_Fotboll\" title=\"Hammarby Fotboll\">Hammarby IF</a><br /><a href=\"/wiki/IF_Brommapojkarna\" title=\"IF Brommapojkarna\">IF Brommapojkarna</a></span></div></div></div><div class=\"od notheme\" style=\"top:84.375%;left:67.603%;font-size:91%\"><div class=\"id\" style=\"left:-1px;top:-1px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Gothenburg teams BK Häcken GAIS IFK Göteborg\"><img alt=\"Gothenburg teams BK Häcken GAIS IFK Göteborg\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/3/3a/TransparentPlaceholder.png/20px-TransparentPlaceholder.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"1\" height=\"1\" class=\"mw-file-element\" data-file-width=\"500\" d