lass=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Gefle IF\"><img alt=\"Gefle IF\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pv\" style=\"width:6em;bottom:5px;left:-3em\"><div><a href=\"/wiki/Gefle_IF\" title=\"Gefle IF\">Gefle IF</a></div></div></div><div class=\"od notheme\" style=\"top:49.369%;left:48.64%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"GIF Sundsvall\"><img alt=\"GIF Sundsvall\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pv\" style=\"width:6em;bottom:5px;left:-3em\"><div><a href=\"/wiki/GIF_Sundsvall\" title=\"GIF Sundsvall\">GIF Sundsvall</a></div></div></div><div class=\"od notheme\" style=\"top:93.425%;left:16.163%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Helsingborg\"><img alt=\"Helsingborg\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pv\" style=\"width:6em;bottom:5px;left:-3em\"><div><a href=\"/wiki/Helsingborg\" title=\"Helsingborg\">Helsingborg</a></div></div></div><div class=\"od notheme\" style=\"top:81.875%;left:10.915%;fon