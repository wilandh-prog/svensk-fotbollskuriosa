c=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pv\" style=\"width:6em;top:5px;left:-3em\"><div><a href=\"/wiki/Norrby_IF\" title=\"Norrby IF\">Norrby IF</a></div></div></div><div class=\"od notheme\" style=\"top:42.63%;left:84.385%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Stockholm\"><img alt=\"Stockholm\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/4/46/Black_pog.svg/20px-Black_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pl\" style=\"width:6em;right:5px\"><div><div style=\"position:relative;top:0px;right:-15px;\"><b>Stockholm</b></div></div></div></div><div class=\"od notheme\" style=\"top:96.147%;left:30.34%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Trelleborgs FF\"><img alt=\"Trelleborgs FF\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><span class=\"nowrap\"><a href=\"/wiki/Trelleborgs_FF\" title=\"Trelleborgs FF\">Trelleborgs FF</a></span></div></div></div><div class=\"od notheme\" style=\"top:71.79%;left:40.002%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"IFK Värnamo\"><img alt=\"IFK Värnamo\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><a href=\"/wiki/IFK_V%C3%A4rnamo\" title=\"IFK Värnamo\">IFK Värnamo</a></div></div></div><div class=\"od notheme\" style=\"top:38.911%;left:67.485%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Västerås SK\"><img alt=\"Västerås SK\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pl\" style=\"width:6em;right:5px\"><div><a href=\"/wiki/V%C3%A4ster%C3%A5s_SK_Fotboll\" title=\"Västerås SK Fotboll\">Västerås SK</a></div></div></div><div class=\"od notheme\" style=\"top:75.947%;left:48.094%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Östers IF\"><img alt=\"Östers IF\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pv\" style=\"width:6em;top:5px;left:-3em\"><div><a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Östers IF</a></div></div></div><div class=\"od notheme\" style=\"top:10.581%;left:18.607%;font-size: