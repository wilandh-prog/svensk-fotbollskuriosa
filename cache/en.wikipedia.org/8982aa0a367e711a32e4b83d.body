ikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pl\" style=\"width:6em;right:5px\"><div><a href=\"/wiki/Vittsj%C3%B6_GIK\" title=\"Vittsjö GIK\">Vittsjö</a></div></div></div><div class=\"od notheme\" style=\"top:75.803%;left:40.644%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Norrköping\"><img alt=\"Norrköping\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><a href=\"/wiki/IFK_Norrk%C3%B6ping_(women)\" title=\"IFK Norrköping (women)\">Norrköping</a></div></div></div><div class=\"od notheme\" style=\"top:71.062%;left:33.98%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Örebro\"><img alt=\"Örebro\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pl\" style=\"width:6em;right:5px\"><div><a href=\"/wiki/KIF_%C3%96rebro_DFF\" title=\"KIF Örebro DFF\">Örebro</a></div></div></div><div class=\"od notheme\" style=\"top:81.934%;left:11.199%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Häcken\"><img alt=\"Häcken\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pv\" style=\"width:6em;bottom:5px;left:-3em\"><div><a href=\"/wiki/BK_H%C3%A4cken_FF\" title=\"BK Häcken FF\">Häcken</a></div></div></div><div class=\"od notheme\" style=\"top:76.962%;left:36.973%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Linköping\"><img alt=\"Linköping\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pv\" style=\"width:6em;top:5px;left:-3em\"><div><a href=\"/wiki/Link%C3%B6ping_FC\" title=\"Linköping FC\">Linköping</a></div></div></div><div class=\"od notheme\" style=\"top:29.004%;left:78.011%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Piteå\"><img alt=\"Piteå\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pl\" style=\"width:6em;right:5px\"><div><a href=\"/wiki/Pite%C3%A5_IF\" title=\"Piteå IF\">Piteå</a></div></div></div><div class=\"od notheme\" style=\"top:98.019%;left:19.443%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Trelleborg\"><img alt=\"Trelleborg\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><a href=\"/wiki/Trelleborgs_FF_(women)\" class=\"mw-redirect\" title=\"Trelleborgs FF (women)\">Trelleborg</a></div></div></div><div class=\"od notheme\" style=\"top:70.518%;left:54.078%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Stockholm\"><img alt=\"Stockholm\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/4/46/Black_pog.svg/20px-Black_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><div style=\"position:relative;top:0px;right:-15px;\"><b>Stockholm</b></div></div></div></div><div class=\"od notheme\" style=\"top:57.163%;left:17.512%;font-size:91%\"><div class=\"id\" style=\"left:-1px;top:-1px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Stockholm teams Brommapojkarna Djurgården AIK Hammarby\"><img alt=\"Stockholm teams Brommapojkarna Djurgården AIK Hammarby\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/3/3a/TransparentPlaceholder.png/20px-TransparentPlaceholder.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"1\" height=\"1\" class=\"mw-file-element\" data-file-width=\"500\" data-file-height=\"375\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:2px\"><div><span class=\"nowrap\"><b>Stockholm team