-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><a href=\"/wiki/%C3%96sters_IF\" title=\"Östers IF\">Öster</a></div></div></div><div class=\"od notheme\" style=\"top:84.168%;left:45.594%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Mjällby\"><img alt=\"Mjällby\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><a href=\"/wiki/Mj%C3%A4llby_AIF\" title=\"Mjällby AIF\">Mjällby</a></div></div></div><div class=\"od notheme\" style=\"top:54.265%;left:26.774%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Norrby\"><img alt=\"Norrby\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pv\" style=\"width:6em;top:5px;left:-3em\"><div><a href=\"/wiki/Norrby_IF\" title=\"Norrby IF\">Norrby</a></div></div></div><div class=\"od notheme\" style=\"top:65.306%;left:19.705%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Varberg\"><img alt=\"Varberg\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pl\" style=\"width:6em;right:5px\"><div><a href=\"/wiki/Varbergs_BoIS\" title=\"Varbergs BoIS\">Varberg</a></div></div></div><div class=\"od notheme\" style=\"top:21.518%;left:64.869%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Västerås\"><img alt=\"Västerås\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pl\" style=\"width:6em;right:5px\"><div><a href=\"/wiki/V%C3%A4ster%C3%A5s_SK_Fotboll\" title=\"Västerås SK Fotboll\">Västerås</a></div></div></div><div class=\"od notheme\" style=\"top:54.752%;left:16.691%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Örgryte\"><img alt=\"Örgryte\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pl\" style=\"width:6em;right:5px\"><div><a href=\"/wiki/%C3%96rgryte_IS\" title=\"Örgryte IS\">Örgryte</a></div></div></div><div class=\"od notheme\" style=\"top:29.109%;left:76.405%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Syrianska\"><img alt=\"Syrianska\" src=\"//upload.wikimedi