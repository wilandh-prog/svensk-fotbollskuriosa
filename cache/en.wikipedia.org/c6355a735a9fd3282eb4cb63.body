tr>\n<tr>\n<td style=\"text-align: center;font-weight: normal;background-color:transparent; color: inherit;\">3\n</td>\n<th scope=\"row\" style=\"text-align: left; white-space:nowrap;font-weight: normal;background-color:transparent; color: inherit;\"><a href=\"/wiki/Kopparbergs/G%C3%B6teborg_FC\" class=\"mw-redirect\" title=\"Kopparbergs/Göteborg FC\">Kopparbergs/Landvetter IF</a>\n</th>\n<td style=\"font-weight: normal;background-color:transparent; color: inherit;\">22\n</td>\n<td style=\"font-weight: normal;background-color:transparent; color: inherit;\">10\n</td>\n<td style=\"font-weight: normal;background-color:transparent; color: inherit;\">7\n</td>\n<td style=\"font-weight: normal;background-color:transparent; color: inherit;\">5\n</td>\n<td style=\"font-weight: normal;background-color:transparent; color: inherit;\">28\n</td>\n<td style=\"font-weight: normal;background-color:transparent; color: inherit;\">24\n</td>\n<td style=\"font-weight: normal;background-color:transparent; color: inherit;\">+4\n</td>\n<td style=\"font-weight: bold;background-color:transparent; color: inherit;\">37\n</td></tr>\n<tr>\n<td style=\"text-align: center;font-weight: normal;background-color:transparent; color: inherit;\">4\n</td>\n<th scope=\"row\" style=\"text-align: left; white-space:nowrap;font-weight: normal;background-color:transparent; color: inherit;\"><a href=\"/wiki/Djurg%C3%A5rden/%C3%84lvsj%C3%B6\" class=\"mw-redirect\" title=\"Djurgården/Älvsjö\">Älvsjö AIK</a>\n</th>\n<td style=\"font-weight: normal;background-color:transparent; color: inherit;\">22\n</td>\n<td style=\"font-weight: normal;background-color:transparent; color: inherit;\">10\n</td>\n<td style=\"font-weight: normal;background-color:transparent; color: inherit;\">6\n</td>\n<td style=\"font-weight: normal;background-color:transparent; color: inherit;\">6\n</td>\n<td style=\"font-weight: normal;background-color:transparent; color: inherit;\">60\n</td>\n<td style=\"font-weight: normal;background-color:transpa