ypeof=\"mw:File\"><span title=\"Halmstads BK\"><img alt=\"Halmstads BK\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pl\" style=\"width:6em;right:5px\"><div><a href=\"/wiki/Halmstads_BK\" title=\"Halmstads BK\">Halmstads BK</a></div></div></div><div class=\"od notheme\" style=\"top:81.365%;left:26.353%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Jönköpings Södra IF\"><img alt=\"Jönköpings Södra IF\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><a href=\"/wiki/J%C3%B6nk%C3%B6pings_S%C3%B6dra_IF\" title=\"Jönköpings Södra IF\">Jönköpings Södra IF</a></div></div></div><div class=\"od notheme\" style=\"top:78.356%;left:10.872%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Ljungskile SK\"><img alt=\"Ljungskile SK\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pv\" style=\"width:6em;bottom:5px;left:-3em\"><div><a href=\"/wiki/Ljungskile_SK\" title=\"Ljungskile SK\">Ljungskile SK</a></div></div></div><div class=\"od notheme\" style=\"top:81.706%;left:17.85%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Norrby IF\"><img alt=\"Norrby IF\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pv\" style=\"width:6em;top:5px;left:-3em\"><div><a href=\"/wiki/Norrby_IF\" title=\"Norrby IF\">Norrby IF</a></div></div></div><div class=\"od notheme\" style=\"top:98.02%;left:19.444%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Trelleborgs FF\"><img alt=\"Trelleborgs FF\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><span class=\"nowrap\"><a href=\"/wiki/Trelleborgs_FF\" title=\"Trelleborgs FF\">Trelleborgs FF</a></span></div></div></div><div class=\"od notheme\" style=\"top:39.375%;left:69.619%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Umeå FC\"><img alt=\"Umeå FC\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><a href=\"/wiki/Ume%C3%A5_FC\" title=\"Umeå FC\">Umeå F