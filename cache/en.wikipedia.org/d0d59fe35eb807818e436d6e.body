le=\"width:6em;right:5px\"><div><a href=\"/wiki/Pite%C3%A5_IF\" title=\"Piteå IF\">Piteå IF</a></div></div></div><div class=\"od notheme\" style=\"top:91.375%;left:22.987%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Vittsjö\"><img alt=\"Vittsjö\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pl\" style=\"width:6em;right:5px\"><div><a href=\"/wiki/Vittsj%C3%B6_GIK\" title=\"Vittsjö GIK\">Vittsjö</a></div></div></div><div class=\"od notheme\" style=\"top:70.719%;left:53.877%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Hammarby\"><img alt=\"Hammarby\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pv\" style=\"width:6em;bottom:5px;left:-3em\"><div><a href=\"/wiki/Hammarby_Fotboll_(women)\" title=\"Hammarby Fotboll (women)\">Hammarby</a></div></div></div><div class=\"od notheme\" style=\"top:87.638%;left:30.823%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Växjö\"><img alt=\"Växjö\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\