dth=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pv\" style=\"width:6em;bottom:5px;left:-3em\"><div><div style=\"position:relative;left:-11px;\"><a href=\"/wiki/%C3%96rgryte_IS\" title=\"Örgryte IS\">Örgryte</a></div></div></div></div><div class=\"od notheme\" style=\"top:54.572%;left:26.76%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Elfsborg\"><img alt=\"Elfsborg\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pr\" style=\"width:6em;left:5px\"><div><div style=\"position:relative;top:5px;left:-2px;\"><a href=\"/wiki/IF_Elfsborg\" title=\"IF Elfsborg\">Elfsborg</a></div></div></div></div><div class=\"od notheme\" style=\"top:86.285%;left:25.75%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Landskrona\"><img alt=\"Landskrona\" src=\"//upload.wikimedia.org/wikipedia/commons/thumb/0/0c/Red_pog.svg/20px-Red_pog.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" width=\"8\" height=\"8\" class=\"mw-file-element\" data-file-width=\"64\" data-file-height=\"64\" /></span></span></div><div class=\"pl\" style=\"width:6em;right:5px\"><div><div style=\"position:relative;top:4px;\"><a href=\"/wiki/Landskrona_BoIS\" title=\"Landskrona BoIS\">Landskrona</a></div></div></div></div><div class=\"od notheme\" style=\"top:83.517%;left:24.368%;font-size:91%\"><div class=\"id\" style=\"left:-4px;top:-4px\"><span class=\"notpageimage noviewer\" typeof=\"mw:File\"><span title=\"Hälsingborg\"><img alt=\"Hälsin